{% extends 'ui/delete.html.twig' %}
{% set domain = 'edu_non_working_day' %}
{% trans_default_domain 'edu_non_working_day' %}

{% block delete_header %}
    <th>{{ 'header.date'|trans }}</th>
    <th>{{ 'header.description'|trans }}</th>
{% endblock %}

{% block delete_rows %}
    {% for item in items %}
        <tr>
            <td>{{ item.date|date('format.date'|trans({}, 'general')) }}</td>
            <td>{{ item.description }}</td>
        </tr>
    {% endfor %}
{% endblock %}
