{% trans_default_domain 'edu_group' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}
{% import 'ui/form_layout.html.twig' as fl %}
{% form_theme form 'ui/form_theme.html.twig' %}

{% block content %}
    {{ form_start(form) }}
    {{ fl.grid(form, [
        ['grade', 'name'],
        ['tutors'],
        ['internalCode'],
    ], {}, 'card.title'|trans) }}
    {{ m.start_button() }}
        {{ m.submit_button('submit', 'check', 'btn-success', 'form.save'|trans) }}
        {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
    {{ m.end_button() }}
    {{ form_end(form) }}

    {% if group.id %}
        <div class="mt-8 grid max-w-5xl gap-6 lg:grid-cols-2">
            <section class="overflow-hidden rounded-xl bg-white shadow-xs ring-1 ring-gray-200">
                <h2 class="border-b border-gray-100 px-5 py-4 text-sm font-semibold text-gray-900">{{ 'title.students'|trans }}</h2>
                <table class="w-full text-left text-sm">
                    <thead class="bg-gray-50 text-xs font-semibold uppercase tracking-wide text-gray-500 [&_th]:px-4 [&_th]:py-2"><tr><th>{{ 'header.student'|trans }}</th></tr></thead>
                    <tbody class="divide-y divide-gray-100 [&_td]:px-4 [&_td]:py-2">
                        {% for student in group.students %}
                            <tr><td>{{ student.lastName }}, {{ student.firstName }}</td></tr>
                        {% else %}
                            <tr><td class="text-gray-500">{{ 'table.no_students'|trans }}</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </section>
            <section class="overflow-hidden rounded-xl bg-white shadow-xs ring-1 ring-gray-200">
                <h2 class="border-b border-gray-100 px-5 py-4 text-sm font-semibold text-gray-900">{{ 'title.teachers'|trans }}</h2>
                <table class="w-full text-left text-sm">
                    <thead class="bg-gray-50 text-xs font-semibold uppercase tracking-wide text-gray-500 [&_th]:px-4 [&_th]:py-2"><tr><th>{{ 'header.subject'|trans }}</th><th>{{ 'header.teachers'|trans }}</th></tr></thead>
                    <tbody class="divide-y divide-gray-100 [&_td]:px-4 [&_td]:py-2">
                        {% for teaching in group.teachings %}
                            <tr>
                                <td>{{ teaching.subject.name }}{% if teaching.subject.code %} - {{ teaching.subject.code }}{% endif %}</td>
                                <td>{{ teaching.teacher.person }}</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="2" class="text-gray-500">{{ 'table.no_teachings'|trans }}</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </section>
        </div>

        {{ fl.danger_zone('danger.title'|trans, 'danger.text'|trans, path('organization_group_delete', {'academicYear': group.grade.training.academicYear.id}), group.id) }}
    {% endif %}
{% endblock %}
