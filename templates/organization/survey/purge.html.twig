{% extends 'ui/delete.html.twig' %}
{% set domain = 'edu_survey' %}
{% set prompt_key = 'prompt.purge_confirm' %}
{% set confirm_key = 'form.prune_confirm' %}
{% trans_default_domain 'edu_survey' %}

{#- Eliminar solo las respuestas: reutiliza la confirmación de borrado, con el campo «purge» y otro texto -#}
{% block delete_header %}
    <th>{{ 'header.title'|trans }}</th>
    <th>{{ 'header.answer_count'|trans }}</th>
{% endblock %}

{% block delete_hidden %}<input type="hidden" name="purge" value="ok">{% endblock %}

{% block delete_rows %}
    {% for item in items %}
        <tr>
            <td>{{ item.title }}</td>
            <td>{{ item.answers|length }}</td>
        </tr>
    {% endfor %}
{% endblock %}
