{% extends 'ui/delete.html.twig' %}
{% set domain = 'edu_survey_question' %}
{% trans_default_domain 'edu_survey_question' %}

{% block delete_header %}
    <th>{{ 'header.description'|trans }}</th>
    <th>{{ 'header.type'|trans }}</th>
    <th>{{ 'header.mandatory'|trans }}</th>
{% endblock %}

{% block delete_rows %}
    {% for item in items %}
        <tr>
            <td>{{ item.description|striptags }}</td>
            <td>{{ ('type.' ~ item.type)|trans }}</td>
            <td>{{ (item.mandatory ? 'table.mandatory.yes' : 'table.mandatory.no')|trans }}</td>
        </tr>
    {% endfor %}
{% endblock %}
