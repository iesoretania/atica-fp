{% extends 'ui/delete.html.twig' %}
{% set domain = 'edu_survey' %}
{% trans_default_domain 'edu_survey' %}

{% block delete_header %}
    <th>{{ 'header.title'|trans }}</th>
    <th>{{ 'header.answer_count'|trans }}</th>
{% endblock %}

{% block delete_rows %}
    {% for item in items %}
        <tr>
            <td>{{ item.title }}</td>
            <td>{{ item.answers|length }}</td>
        </tr>
    {% endfor %}
{% endblock %}
