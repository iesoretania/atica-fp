{% trans_default_domain 'edu_teaching' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}
{% import 'ui/form_layout.html.twig' as fl %}
{% form_theme form 'ui/form_theme.html.twig' %}

{% block content %}
    {{ form_start(form) }}
    {{ fl.grid(form, [
        ['subject', 'group'],
        ['teacher'],
    ], {}, 'card.title'|trans) }}
    {{ m.start_button() }}
        {{ m.submit_button('submit', 'check', 'btn-success', 'form.save'|trans) }}
        {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
    {{ m.end_button() }}
    {{ form_end(form) }}

    {% if teaching.id %}
        {{ fl.danger_zone('danger.title'|trans, 'danger.text'|trans, path('organization_teaching_delete', {'id': teaching.id}), teaching.id) }}
    {% endif %}
{% endblock %}
