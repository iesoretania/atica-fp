{% extends 'ui/delete.html.twig' %}
{% set domain = 'edu_teaching' %}
{% trans_default_domain 'edu_teaching' %}

{% block delete_header %}
    <th>{{ 'header.teacher'|trans }}</th>
    <th>{{ 'header.subject'|trans }}</th>
    <th>{{ 'header.group'|trans }}</th>
{% endblock %}

{% block delete_rows %}
    <tr>
        <td>{{ teaching.teacher }}</td>
        <td>{{ teaching.subject }}</td>
        <td>{{ teaching.group }}</td>
    </tr>
{% endblock %}
