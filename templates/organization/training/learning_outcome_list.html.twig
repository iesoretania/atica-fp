{% trans_default_domain 'edu_learning_outcome' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}

{#- Listado dinámico (Live Component Organization:LearningOutcomeList) -#}
{% block content %}
    {% include 'ui/_live_list.html.twig' with {component: 'Organization:LearningOutcomeList', props: {subject: subject}} %}

    <section class="mt-8 max-w-5xl overflow-hidden rounded-xl bg-white shadow-xs ring-1 ring-gray-200">
        <h2 class="border-b border-gray-100 px-5 py-4 text-sm font-semibold text-gray-900 sm:px-6">{{ 'title.import'|trans }}</h2>
        <form action="{{ path('organization_training_learning_outcome_import', {'id': subject.id}) }}" method="post" class="space-y-4 p-5 sm:p-6">
            <textarea name="data" rows="8" aria-label="{{ 'title.import'|trans }}" placeholder="{{ 'form.import.placeholder'|trans }}"
                      class="block w-full rounded-lg border-0 bg-white px-3 py-2 text-sm shadow-xs ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-brand-500"></textarea>
            <div class="flex flex-wrap gap-2">
                {{ m.submit_button('import', 'folder-open', 'btn-warning', 'form.import'|trans) }}
                {{ m.link_button(path('organization_training_learning_outcome_export', {'id': subject.id}), 'download', 'btn-info', 'form.export'|trans) }}
            </div>
        </form>
    </section>
{% endblock %}
