{% extends 'ui/delete.html.twig' %}
{% set domain = 'edu_performance_scale_value' %}
{% trans_default_domain 'edu_performance_scale_value' %}

{% block delete_header %}
    <th>{{ 'header.description'|trans }}</th>
    <th>{{ 'header.numeric_grade'|trans }}</th>
    <th>{{ 'header.notes'|trans }}</th>
{% endblock %}

{% block delete_rows %}
    {% for item in items %}
        <tr>
            <td>{{ item.description }}</td>
            <td>{{ item.numericGrade }}</td>
            <td>{{ item.notes|nl2br }}</td>
        </tr>
    {% endfor %}
{% endblock %}
