{% trans_default_domain 'edu_report_template' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}
{% import 'ui/form_layout.html.twig' as fl %}
{% form_theme form 'ui/form_theme.html.twig' %}

{% block content %}
    {{ form_start(form) }}
    {{ fl.grid(form, [
        ['description'],
        ['newData'],
    ], {}, 'card.title'|trans) }}
    {{ m.start_button() }}
        {{ m.submit_button('submit', 'check', 'btn-success', 'form.save'|trans) }}
        {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
    {{ m.end_button() }}
    {{ form_end(form) }}

    {% set entity = form.vars.data %}
    {% if entity.id %}
        {{ fl.danger_zone('danger.title'|trans, 'danger.text'|trans, path('organization_report_template_delete'), entity.id) }}
    {% endif %}
{% endblock %}
