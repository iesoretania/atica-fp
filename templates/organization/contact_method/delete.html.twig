{% extends 'ui/delete.html.twig' %}
{% set domain = 'edu_contact_method' %}
{% trans_default_domain 'edu_contact_method' %}

{% block delete_header %}
    <th>{{ 'header.description'|trans }}</th>
    <th>{{ 'header.enabled'|trans }}</th>
{% endblock %}

{% block delete_rows %}
    {% for item in items %}
        <tr>
            <td>{{ item.description }}</td>
            <td>{{ (item.enabled ? 'form.yes' : 'form.no')|trans }}</td>
        </tr>
    {% endfor %}
{% endblock %}
