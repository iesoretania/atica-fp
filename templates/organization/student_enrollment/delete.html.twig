{% extends 'ui/delete.html.twig' %}
{% set domain = 'edu_student_enrollment' %}
{% trans_default_domain 'edu_student_enrollment' %}

{% block delete_header %}
    <th>{{ 'header.name'|trans }}</th>
    <th>{{ 'header.user'|trans }}</th>
    <th>{{ 'header.group'|trans }}</th>
{% endblock %}

{% block delete_rows %}
    {% for item in items %}
        <tr>
            <td>{{ item.person.lastName }}, {{ item.person.firstName }}</td>
            <td>{{ item.person.userNameAndEmailAddress|default('') }}</td>
            <td>{{ item.group }}</td>
        </tr>
    {% endfor %}
{% endblock %}
