{% trans_default_domain 'edu_academic_year' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}
{% import 'ui/form_layout.html.twig' as fl %}
{% form_theme form 'ui/form_theme.html.twig' %}

{% block content %}
    <twig:Ui:Alert type="info" :message="'prompt.copy_information'|trans" />
    {{ form_start(form) }}
    {{ fl.grid(form, [], {}, 'form.copy_to'|trans({'academic_year': academic_year})) }}
    {{ m.start_button() }}
        {{ m.submit_button('submit', 'copy', 'btn-success', 'form.copy_from'|trans) }}
        {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
    {{ m.end_button() }}
    {{ form_end(form) }}
{% endblock %}
