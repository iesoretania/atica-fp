{% extends 'ui/delete.html.twig' %}
{% set domain = 'edu_teacher' %}
{% trans_default_domain 'edu_teacher' %}

{% block delete_header %}
    <th>{{ 'header.name'|trans }}</th>
    <th>{{ 'header.username'|trans }}</th>
{% endblock %}

{% block delete_rows %}
    {% for item in items %}
        <tr>
            <td>{{ item.person.firstName }} {{ item.person.lastName }}</td>
            <td>{{ item.person.userNameAndEmailAddress }}</td>
        </tr>
    {% endfor %}
{% endblock %}
