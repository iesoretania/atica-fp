{% extends 'ui/delete.html.twig' %}
{% set domain = 'edu_department' %}
{% trans_default_domain 'edu_department' %}

{% block delete_header %}
    <th>{{ 'header.name'|trans }}</th>
    <th>{{ 'header.head'|trans }}</th>
{% endblock %}

{% block delete_rows %}
    {% for item in items %}
        <tr>
            <td>{{ item.name }}</td>
            <td>{{ item.head|default('') }}</td>
        </tr>
    {% endfor %}
{% endblock %}
