{% trans_default_domain 'organization' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}
{% import 'ui/form_layout.html.twig' as fl %}
{% form_theme form 'ui/form_theme.html.twig' %}

{% block content %}
    {{ form_start(form) }}
    {{ fl.grid(form, [
        ['name:3', 'code:1'],
        ['emailAddress', 'webSite'],
        ['phoneNumber', 'faxNumber'],
        ['address'],
        ['city', 'zipCode'],
        ['description'],
    ], {description: {attr: {rows: 4}}}, 'card.title'|trans) }}
    {{ m.start_button() }}
        {{ m.submit_button('submit', 'check', 'btn-success', 'form.save'|trans) }}
        {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
    {{ m.end_button() }}
    {{ form_end(form) }}

    {% set entity = form.vars.data %}
    {% if entity.id and entity.id != user_extension.currentOrganization.id %}
        {{ fl.danger_zone('danger.title'|trans, 'danger.text'|trans, path('admin_organization_operation'), entity.id, 'organizations') }}
    {% endif %}
{% endblock %}
