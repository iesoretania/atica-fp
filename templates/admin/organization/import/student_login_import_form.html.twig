{% trans_default_domain 'import' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}
{% import 'ui/form_layout.html.twig' as fl %}
{% import 'admin/organization/import/import_macros.html.twig' as im %}
{% form_theme form 'ui/form_theme.html.twig' %}
{% block content %}
    {% if not stats %}
        {{ im.show_import_instructions(columns, 'student_login') }}
        {{ form_start(form) }}
        {{ fl.grid(form, [], {}, 'title.student_login.import'|trans) }}
        {{ m.start_button() }}
            {{ m.submit_button('submit', 'check', 'btn-success', 'form.student_login.do_import'|trans) }}
            {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
        {{ m.end_button() }}
        {{ form_end(form) }}
    {% elseif stats.error is defined %}
        {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
    {% else %}
        {{ im.result_start() }}
        <h4>{{ 'report.stats'|trans }}</h4>
        {% if stats.conflicts %}
            <twig:Ui:Alert type="danger" :message="'warning.student_login.conflicts'|trans" />
        {% endif %}
        <ul>
            <li>{{ 'report.student_login.list'|trans }}: {{ stats.total_items }}</li>
            <li>{{ 'report.student_login.updated'|trans }}: {{ stats.updated_items }}</li>
        </ul>
        {% if stats.collection %}
            <h4>{{ 'report.student_login.updated'|trans }}</h4>
            <ul>
                {% for item in stats.collection %}
                    <li><b>{{ item.username }}</b>: {{ item.student_enrollment }}</li>
                {% endfor %}
            </ul>
        {% endif %}
        {% if stats.conflicts %}
            <h4>{{ 'report.student_login.conflicts'|trans }}</h4>
            <ul>
                {% for item in stats.conflicts %}
                    <li><b>{{ item.username }}</b> - {{ item.name }}
                        {% if item.student_enrollments %}
                            - <i>{{ 'report.student_login.conflicts.same_name'|trans }}</i>
                            <ul>
                                {% for student_enrollment in item.student_enrollments %}
                                    <li><a href="{{ path('admin_user_form_edit', {'id': student_enrollment.person.id}) }}" target="_blank" class="text-brand-700 hover:underline">{{ student_enrollment }}</a></li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            - <i>{{ 'report.student_login.conflicts.same_username'|trans }}</i>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        {% if stats.existing %}
            <h4>{{ 'report.student_login.existing'|trans }}</h4>
            <ul>
                {% for person in stats.existing %}
                    <li><a href="{{ path('admin_user_form_edit', {'id': person.id}) }}" target="_blank" class="text-brand-700 hover:underline">{{ person }}</a> - {{ person.loginUsername }}
                        - <i>{{ 'report.student_login.existing.info'|trans }}</i>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        {{ im.result_end() }}
        {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
    {% endif %}
{% endblock %}
