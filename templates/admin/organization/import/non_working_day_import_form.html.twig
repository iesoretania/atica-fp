{% trans_default_domain 'import' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}
{% import 'ui/form_layout.html.twig' as fl %}
{% import 'admin/organization/import/import_macros.html.twig' as im %}
{% form_theme form 'ui/form_theme.html.twig' %}
{% block content %}
    {% if not stats %}
        {% set link = 'link.non_working_day.import'|trans %}
        <twig:Ui:Alert type="info">{{ 'instructions.non_working_day.import'|trans({'link': '<a href="' ~ link ~ '" class="font-medium underline">' ~ link ~ '</a>'})|raw }}</twig:Ui:Alert>
        {{ form_start(form) }}
        {{ fl.grid(form, [], {}, 'title.non_working_day.import'|trans) }}
        {{ m.start_button() }}
            {{ m.submit_button('submit', 'check', 'btn-success', 'form.non_working_day.do_import'|trans) }}
            {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
        {{ m.end_button() }}
        {{ form_end(form) }}
    {% elseif stats.error is defined %}
        {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
    {% else %}
        {{ im.result_start() }}
        <h4>{{ 'report.stats'|trans }}</h4>
        <ul>
            <li>{{ 'report.non_working_day.new'|trans }}: {{ stats.new_items }}</li>
            <li>{{ 'report.non_working_day.old'|trans }}: {{ stats.old_items }}</li>
        </ul>
        {{ im.result_end() }}
        {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
    {% endif %}
{% endblock %}
