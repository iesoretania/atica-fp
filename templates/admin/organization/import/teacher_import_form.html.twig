{% trans_default_domain 'import' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}
{% import 'ui/form_layout.html.twig' as fl %}
{% import 'admin/organization/import/import_macros.html.twig' as im %}
{% form_theme form 'ui/form_theme.html.twig' %}
{% block content %}
    {% if not stats %}
        {{ im.show_import_instructions(columns, 'teacher') }}
        {{ form_start(form) }}
        {{ fl.grid(form, [], {}, 'title.teacher.import'|trans) }}
        {{ m.start_button() }}
            {{ m.submit_button('submit', 'check', 'btn-success', 'form.teacher.do_import'|trans) }}
            {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
        {{ m.end_button() }}
        {{ form_end(form) }}
    {% elseif stats.error is defined %}
        {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
    {% else %}
        {{ im.result_start() }}
        <h4>{{ 'report.stats'|trans }}</h4>
        <ul>
            <li>{{ 'report.teacher.existing_teachers'|trans }}: {{ stats.existing_user_count }}</li>
            <li>{{ 'report.teacher.new_teachers'|trans }}: {{ stats.new_user_count }}</li>
        </ul>
        {% if stats.user_collection %}
            <h4>{{ 'report.teacher.list'|trans }}</h4>
            <ul>
                {% for teacher in stats.user_collection %}
                    <li>{{ teacher }}</li>
                {% endfor %}
            </ul>
            {% if generate_password %}
                <twig:Ui:Alert type="warning" :message="'message.teacher.password_info'|trans" />
            {% endif %}
        {% endif %}
        {{ im.result_end() }}
        {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
    {% endif %}
{% endblock %}
