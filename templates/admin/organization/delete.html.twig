{% extends 'ui/delete.html.twig' %}
{% set domain = 'organization' %}
{% set items_name = 'organizations' %}
{% trans_default_domain 'organization' %}

{% block delete_header %}
    <th>{{ 'header.name'|trans }}</th>
    <th>{{ 'header.code'|trans }}</th>
    <th>{{ 'header.city'|trans }}</th>
{% endblock %}

{% block delete_rows %}
    {% for item in items %}
        <tr>
            <td>{{ item.name }}</td>
            <td>{{ item.code }}</td>
            <td>{{ item.city }}</td>
        </tr>
    {% endfor %}
{% endblock %}
