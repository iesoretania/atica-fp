{% extends 'ui/delete.html.twig' %}
{% set domain = 'user' %}
{% set items_name = 'users' %}
{% trans_default_domain 'user' %}

{% block delete_header %}
    <th>{{ 'header.name'|trans }}</th>
    <th>{{ 'header.username'|trans }}</th>
    <th>{{ 'header.profiles'|trans }}</th>
{% endblock %}

{% block delete_rows %}
    {% for item in items %}
        <tr>
            <td>{{ item.firstName }} {{ item.lastName }}</td>
            <td>{{ item.userNameAndEmailAddress }}</td>
            <td>{{ item.globalAdministrator ? 'role.global_administrator'|trans }}</td>
        </tr>
    {% endfor %}
{% endblock %}
