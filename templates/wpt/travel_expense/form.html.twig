{% trans_default_domain 'wpt_travel_expense' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}
{% import 'ui/form_layout.html.twig' as fl %}
{% form_theme form 'ui/form_theme.html.twig' %}

{% block content %}
    {{ form_start(form) }}
    {{ fl.grid(form, [
        ['fromDateTime', 'toDateTime'],
        ['travelRoute'],
        ['agreements'],
        ['otherExpenses', 'otherExpensesDescription'],
        ['description'],
    ], {otherExpensesDescription: {attr: {rows: 3}}, description: {attr: {rows: 4}}}) }}
    {{ m.start_button() }}
        {% if not read_only %}{{ m.submit_button('submit', 'check', 'btn-success', 'form.save'|trans) }}{% endif %}
        {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
    {{ m.end_button() }}
    {{ form_end(form) }}

    {% include 'ui/new_travel_route_modal.html.twig' %}
{% endblock %}
