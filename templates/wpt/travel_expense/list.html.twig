{% trans_default_domain 'wpt_travel_expense' %}
{% extends 'ui/list.html.twig' %}
{% import 'ui/macros.html.twig' as m %}

{% block path_new %}{{ path('workplace_training_travel_expense_new', {'id': teacher.id}) }}{% endblock %}

{% block new_action %}{% if allow_new %}{{ parent() }}{% endif %}{% endblock %}

{% block table_header %}
    <th><label class="flex items-center gap-2"><input type="checkbox" data-list-target="selectAll" class="size-4 rounded border-gray-300 text-brand-600"> {{ 'header.travel_route'|trans }}</label></th>
    <th>{{ 'header.agreements'|trans }}</th>
    <th>{{ 'header.distance'|trans }}</th>
    <th>{{ 'header.other_expenses'|trans }}</th>
    <th>{{ 'header.verified'|trans }}</th>
{% endblock %}

{% block table_body %}
    {% for data in pager %}
        {% set item = data[0] %}
        {% set url = path('workplace_training_travel_expense_edit', {'id': item.id}) %}
        {% set row_read_only = not is_granted('WPT_TRAVEL_EXPENSE_MANAGE', item) %}
        <tr class="clickable-row" data-href="{{ url }}">
            <td>
                <label class="flex items-center gap-2">
                    <input type="checkbox" name="items[]" value="{{ item.id }}" class="size-4 rounded border-gray-300 text-brand-600{% if not row_read_only %} selectable{% endif %}"{% if row_read_only %} disabled{% endif %}>
                    <a href="{{ url }}" class="font-medium text-gray-900 hover:text-brand-700">{{ item.travelRoute }}</a>
                </label>
            </td>
            <td>{{ data[1] }}</td>
            <td class="whitespace-nowrap">{{ item.travelRoute.distance ? item.travelRoute.distance|number_format ~ ' ' ~ 'suffix.distance'|trans({}, 'general') : '---' }}</td>
            <td class="whitespace-nowrap">{{ (item.otherExpenses/100)|number_format(2, 'format.decimal_separator'|trans({}, 'general'), 'format.thousand_separator'|trans({}, 'general')) }} {{ 'format.currency'|trans({}, 'general') }}</td>
            <td>{{ (item.travelRoute.verified ? 'table.verified_yes' : 'table.verified_no')|trans }}</td>
        </tr>
    {% else %}
        <tr><td colspan="5" class="py-8 text-center text-gray-500">{{ 'table.no_items'|trans }}</td></tr>
    {% endfor %}
{% endblock %}

{% block form_action %}{{ path('workplace_training_travel_expense_operation', {'id': teacher.id}) }}{% endblock %}

{% block pagerfanta %}
    {{ pagerfanta(pager, 'tailwind', {'prev_message': 'paginator.prev'|trans([], 'general'), 'next_message': 'paginator.next'|trans([], 'general'), 'routeParams': {'id': teacher.id}}) }}
{% endblock %}

{% block after_table %}
    {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
    {{ m.submit_button('delete', 'trash', 'btn-danger enable-on-items', 'form.delete'|trans, true) }}
{% endblock %}
