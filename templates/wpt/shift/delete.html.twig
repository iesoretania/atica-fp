{% extends 'ui/delete.html.twig' %}
{% set domain = 'wpt_shift' %}
{% trans_default_domain 'wpt_shift' %}

{% block delete_header %}
    <th>{{ 'header.name'|trans }}</th>
    <th>{{ 'header.groups'|trans }}</th>
{% endblock %}

{% block delete_rows %}
    {% for item in items %}
        <tr>
            <td>{{ item.name }}</td>
            <td>{{ item.grade.groups|join(', ') }}</td>
        </tr>
    {% endfor %}
{% endblock %}
