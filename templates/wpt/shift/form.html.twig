{% trans_default_domain 'wpt_shift' %}
{% extends 'ui/layout.html.twig' %}
{% form_theme form 'ui/form_theme.html.twig' %}

{% import 'ui/form_layout.html.twig' as fl %}

{% block content %}
    {{ form_start(form) }}
    {{ fl.grid(form, [
        ['name'],
        ['subject'],
        ['type', 'hours', 'quarter', 'locked'],
        ['attendanceReportTemplate', 'weeklyActivityReportTemplate'],
        ['activitySummaryReportTemplate', 'finalReportTemplate'],
        ['studentSurvey', 'companySurvey', 'educationalTutorSurvey'],
    ]) }}
    <div class="mt-6 flex flex-wrap gap-2">
        {% if not read_only %}
            <twig:Ui:Button type="submit" name="submit" icon="check" label="{{ 'form.save'|trans }}" />
        {% endif %}
        <twig:Ui:Button href="{{ last_url }}" variant="secondary" icon="arrow-left" label="{{ 'form.back'|trans }}" />
    </div>
    {{ form_end(form) }}
{% endblock %}
