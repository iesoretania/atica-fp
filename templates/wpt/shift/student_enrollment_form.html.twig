{% trans_default_domain 'wlt_project' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}
{% form_theme form 'ui/form_theme.html.twig' _self %}

{% block content %}
    {{ form_start(form) }}
    {{ form_widget(form) }}
    {{ m.start_button() }}
        {{ m.submit_button('submit', 'check', 'btn-success', 'form.save'|trans) }}
        {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
    {{ m.end_button() }}
    {{ form_end(form) }}
{% endblock %}

{% block _project_student_enrollment_studentEnrollments_widget %}
    <div {{ block('widget_container_attributes') }} class="mt-2 space-y-4 rounded-lg bg-white p-4 ring-1 ring-gray-200">
        {% for name, choices in form.vars.choices %}
            <fieldset>
                <legend class="mb-2 text-sm font-semibold text-gray-900">{{ name }}</legend>
                <div class="space-y-2">
                    {% for key, choice in choices %}
                        <div class="flex items-center gap-2">
                            {{ form_widget(form[key], {translation_domain: false}) }}
                            <label for="{{ form[key].vars.id }}" class="text-sm text-gray-700">{{ form[key].vars.label }}</label>
                        </div>
                    {% endfor %}
                </div>
            </fieldset>
        {% else %}
            <p class="text-sm text-gray-500">{{ 'form.no_student_enrollments'|trans }}</p>
        {% endfor %}
    </div>
{% endblock %}
