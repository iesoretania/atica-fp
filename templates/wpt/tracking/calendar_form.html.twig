{% trans_default_domain 'calendar' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}
{% form_theme form 'ui/form_theme.html.twig' _self %}

{% block content %}
    {% if read_only %}
        <twig:Ui:Alert type="warning" :message="'prompt.read_only_warning'|trans|nl2br" />
    {% elseif tracked_work_day.locked %}
        <twig:Ui:Alert type="warning" :message="'prompt.locked_warning'|trans|nl2br" />
    {% endif %}
    {{ form_start(form) }}
    {{ form_widget(form.trackedActivities) }}
    {{ form_widget(form) }}
    {{ m.start_button() }}
        {% if not read_only %}{{ m.submit_button('submit', 'check', 'btn-success', 'form.save'|trans) }}{% endif %}
        {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
        {% if previous_work_day %}
            {{ m.link_button(path('workplace_training_tracking_calendar_form', {'workDay': previous_work_day.id, 'agreementEnrollment': tracked_work_day.agreementEnrollment.id}), 'angle-left', 'btn-info', 'form.previous_work_day'|trans) }}
        {% endif %}
        {% if next_work_day %}
            {{ m.link_button(path('workplace_training_tracking_calendar_form', {'workDay': next_work_day.id, 'agreementEnrollment': tracked_work_day.agreementEnrollment.id}), 'angle-right', 'btn-info', 'form.next_work_day'|trans) }}
        {% endif %}
    {{ m.end_button() }}
    {{ form_end(form) }}
{% endblock %}

{# Flechas para pasar al día anterior o siguiente junto al título #}
{% block content_title %}
    <span class="inline-flex items-center gap-3">
        {% if previous_work_day %}
            <a href="{{ path('workplace_training_tracking_calendar_form', {'workDay': previous_work_day.id, 'agreementEnrollment': tracked_work_day.agreementEnrollment.id}) }}" title="{{ 'form.previous_work_day'|trans }}"
               class="rounded-lg p-2 text-gray-500 ring-1 ring-inset ring-gray-300 hover:bg-gray-50"><twig:Ui:Icon name="angle-left" /></a>
        {% endif %}
        {{ parent() }}
        {% if next_work_day %}
            <a href="{{ path('workplace_training_tracking_calendar_form', {'workDay': next_work_day.id, 'agreementEnrollment': tracked_work_day.agreementEnrollment.id}) }}" title="{{ 'form.next_work_day'|trans }}"
               class="rounded-lg p-2 text-gray-500 ring-1 ring-inset ring-gray-300 hover:bg-gray-50"><twig:Ui:Icon name="angle-right" /></a>
        {% endif %}
    </span>
{% endblock %}

{% block _program_grades_programGrades_widget %}
    <div class="mb-5 max-w-3xl rounded-xl bg-white p-4 ring-1 ring-gray-200">
        <div {{ block('widget_container_attributes') }}>
            {% for element in form.children %}
                {{ form_widget(element, {translation_domain: false}) }}
            {% endfor %}
        </div>
    </div>
{% endblock %}

{% block _program_grades_widget %}
    <div class="mb-5 max-w-3xl rounded-xl bg-white p-4 ring-1 ring-gray-200">
        <div {{ block('widget_container_attributes') }}>
            {% for element in form.children %}
                {{ form_widget(element, {translation_domain: false}) }}
            {% endfor %}
        </div>
    </div>
{% endblock %}
