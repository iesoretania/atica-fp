{% trans_default_domain 'wpt_tracking' %}
{#- Barras de progreso de horas y de actividades; al pulsar cada una se despliega el detalle -#}
{% macro bar_segment(percentage, color, title, text) %}
    <div role="progressbar" aria-valuenow="{{ percentage }}" aria-valuemin="0" aria-valuemax="100" style="width: {{ percentage }}%" title="{{ title }}"
         class="flex items-center justify-center overflow-hidden whitespace-nowrap px-2 text-xs font-medium text-white {{ color }}">{{ text }}</div>
{% endmacro %}

{% if work_day_stats and work_day_stats[1] %}
    {% set work_day_real_locked_stats = work_day_stats[3] + work_day_stats[4] + work_day_real_stats %}
    {% set percentage_locked = 100 * work_day_stats[2] / work_day_stats[1] %}
    {% set percentage_absence = 100 * work_day_stats[3] / work_day_stats[1] %}
    {% set percentage_justified_absence = 100 * work_day_stats[4] / work_day_stats[1] %}
    <details class="group mb-4 rounded-xl bg-white shadow-xs ring-1 ring-gray-200">
        <summary class="cursor-pointer list-none p-3">
            <div class="flex h-6 overflow-hidden rounded-full bg-gray-100">
                {{ _self.bar_segment(percentage_locked, 'bg-emerald-600', 'form.stats.hours_locked_hint'|trans({'count': work_day_real_stats / 100}), 'form.stats.hours_bar'|trans({'count': work_day_real_stats / 100, 'total': work_day_stats[1] / 100})) }}
                {% if work_day_stats[4] %}
                    {{ _self.bar_segment(percentage_justified_absence, 'bg-amber-500', 'form.stats.hours_justified_absence_hint'|trans({'count': work_day_stats[4] / 100}), 'form.stats.hours_bar'|trans({'count': work_day_stats[4] / 100, 'total': work_day_stats[1] / 100})) }}
                {% endif %}
                {% if work_day_stats[3] %}
                    {{ _self.bar_segment(percentage_absence, 'bg-red-600', 'form.stats.hours_absence_hint'|trans({'count': work_day_stats[3] / 100}), 'form.stats.hours_bar'|trans({'count': work_day_stats[3] / 100, 'total': work_day_stats[1] / 100})) }}
                {% endif %}
            </div>
        </summary>
        <div class="border-t border-gray-100 p-4">
            <h2 class="mb-2 text-sm font-semibold text-gray-900">{{ 'form.stats.hours'|trans }}</h2>
            <table class="w-full text-left text-sm [&_td]:px-3 [&_td]:py-2 [&_th]:px-3 [&_th]:py-2 [&_tr]:border-b [&_tr]:border-gray-100">
                <tbody>
                    <tr class="font-semibold">
                        <th>{{ 'form.stats.hours.total.caption'|trans }}</th>
                        <th>{{ 'form.stats.hours.total.days'|trans({'count': work_day_stats[6]}) }}</th>
                        <th>{{ 'form.stats.hours.total.hours'|trans({'count': work_day_stats[1] / 100}) }}</th>
                    </tr>
                    <tr>
                        <td>{{ 'form.stats.hours.locked.caption'|trans }}</td>
                        <td>{{ 'form.stats.hours.locked.days'|trans({'count': work_day_stats[10] ?: 0, 'total': work_day_stats[6]}) }}{% if work_day_stats[6] %} ({{ (100*work_day_stats[10]/work_day_stats[6])|number_format }} %){% endif %}</td>
                        <td>{{ 'form.stats.hours.locked.hours'|trans({'count': work_day_real_locked_stats / 100, 'total': work_day_stats[1] / 100}) }}{% if work_day_stats[1] %} ({{ (100*work_day_real_locked_stats/work_day_stats[1])|number_format }} %){% endif %}</td>
                    </tr>
                    <tr>
                        <td>{{ 'form.stats.hours.worked.caption'|trans }}</td>
                        <td>{{ 'form.stats.hours.locked.days'|trans({'count': work_day_stats[7], 'total': work_day_stats[6]}) }}{% if work_day_stats[6] %} ({{ (100*work_day_stats[7]/work_day_stats[6])|number_format }} %){% endif %}</td>
                        <td>{{ 'form.stats.hours.locked.hours'|trans({'count': work_day_real_stats / 100, 'total': work_day_stats[1] / 100}) }}{% if work_day_stats[1] %} ({{ (100*work_day_real_stats/work_day_stats[1])|number_format }} %){% endif %}</td>
                    </tr>
                    <tr>
                        <td>{{ 'form.stats.hours.absence.caption'|trans }}</td>
                        <td>{{ 'form.stats.hours.locked.days'|trans({'count': work_day_stats[8], 'total': work_day_stats[6]}) }}{% if work_day_stats[6] %} ({{ (100*work_day_stats[8]/work_day_stats[6])|number_format }} %){% endif %}</td>
                        <td>{{ 'form.stats.hours.locked.hours'|trans({'count': work_day_stats[3] / 100, 'total': work_day_stats[1] / 100}) }}{% if work_day_stats[1] %} ({{ (100*work_day_stats[3]/work_day_stats[1])|number_format }} %){% endif %}</td>
                    </tr>
                    <tr>
                        <td>{{ 'form.stats.hours.justified_absence.caption'|trans }}</td>
                        <td>{{ 'form.stats.hours.locked.days'|trans({'count': work_day_stats[9], 'total': work_day_stats[6]}) }}{% if work_day_stats[6] %} ({{ (100*work_day_stats[9]/work_day_stats[6])|number_format }} %){% endif %}</td>
                        <td>{{ 'form.stats.hours.locked.hours'|trans({'count': work_day_stats[4] / 100, 'total': work_day_stats[1] / 100}) }}{% if work_day_stats[1] %} ({{ (100*work_day_stats[4]/work_day_stats[1])|number_format }} %){% endif %}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </details>
{% endif %}
{% if activity_total_count %}
    {% set percentage = 100 * activity_tracked_count / activity_total_count %}
    <details class="group mb-4 rounded-xl bg-white shadow-xs ring-1 ring-gray-200">
        <summary class="cursor-pointer list-none p-3">
            <div class="flex h-6 overflow-hidden rounded-full bg-gray-100">
                {{ _self.bar_segment(percentage, 'bg-emerald-600', 'form.stats.activities_hint'|trans({'count': activity_tracked_count, 'total': activity_total_count}), 'form.stats.activities_bar'|trans({'count': activity_tracked_count, 'total': activity_total_count})) }}
                {% if percentage < 100 %}
                    {{ _self.bar_segment(100 - percentage, 'bg-red-600', 'form.stats.activities_not_done_hint'|trans({'count': activity_total_count - activity_tracked_count, 'total': activity_total_count}), 'form.stats.activities_not_done_bar'|trans({'count': activity_total_count - activity_tracked_count})) }}
                {% endif %}
            </div>
        </summary>
        <div class="border-t border-gray-100 p-4">
            <h2 class="mb-2 text-sm font-semibold text-gray-900">{{ 'form.stats.activities'|trans }}: {{ 'form.stats.activities_hint'|trans({'count': activity_tracked_count, 'total': activity_total_count}) }}</h2>
            <table class="w-full text-left text-sm [&_td]:px-3 [&_td]:py-2 [&_tr]:border-b [&_tr]:border-gray-100">
                <tbody>
                    {% for item in activity_stats %}
                        <tr>
                            <td class="whitespace-nowrap">
                                {% if item[2] %}<twig:Ui:Icon name="check" class="mr-1 inline size-3.5 text-emerald-600" />{% else %}<twig:Ui:Icon name="times" class="mr-1 inline size-3.5 text-red-600" />{% endif %}
                                {{ item[0].code }}
                            </td>
                            <td>{{ item[0].description }}</td>
                            <td>
                                {% if activity_total_hours %}
                                    {{ 'form.stats.activities.info'|trans({'total': activity_total_hours/100, 'hours': item[2]/100, 'count': item[1]}) }} ({{ (100*item[2]/activity_total_hours)|number_format }} %)
                                {% else %}
                                    {{ 'form.stats.activities.info'|trans({'total': 0, 'hours': item[2]/100, 'count': item[1]}) }} ({{ (0)|number_format }} %)
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </details>
{% endif %}
