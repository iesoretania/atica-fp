{% trans_default_domain 'calendar' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}
{% form_theme form 'ui/form_theme.html.twig' %}

{% block content %}
    {{ form_start(form) }}
    {{ form_widget(form) }}
    {{ m.start_button() }}
        {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
        {{ m.submit_button('calc', 'calculator', 'btn-primary', 'form.calculate'|trans) }}
        {{ m.submit_button('submit', 'check', 'btn-success', 'form.add'|trans) }}
    {{ m.end_button() }}
    {{ form_end(form) }}

    {% if calendar %}
        <h2 class="mb-3 mt-8 text-lg font-semibold text-gray-900">{{ 'title.preview'|trans }}</h2>
        {% include 'ui/calendar.html.twig' %}
    {% endif %}
{% endblock %}
