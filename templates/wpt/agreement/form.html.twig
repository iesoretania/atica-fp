{% trans_default_domain 'wpt_agreement' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}
{% import 'ui/form_layout.html.twig' as fl %}
{% import 'ui/form_checklist.html.twig' as cl %}
{% form_theme form 'ui/form_theme.html.twig' _self %}

{% block content %}
    {% set ajax_url = path('workplace_training_agreement_new', {'shift': agreement.shift.id}) %}
    {# Al cambiar la empresa se recalculan sus centros de trabajo (selecciona el primero) #}
    {{ form_start(form, {'attr': {
        'data-ajax': ajax_url,
        'data-controller': 'dependent-fields',
        'data-dependent-fields-url-value': ajax_url,
        'data-dependent-fields-rules-value': ([{
            on: ['#agreement_company'],
            send: ['#agreement_company', '#agreement_workcenter'],
            replace: ['#agreement_workcenter'],
            selectFirst: '#agreement_workcenter',
        }])|json_encode,
    }}) }}
    {{ fl.grid(form, [
        ['company', 'workcenter'],
        ['signDate', 'startDate', 'endDate'],
        ['educationalTutor', 'workTutor'],
        ['defaultStartTime1', 'defaultEndTime1', 'defaultStartTime2', 'defaultEndTime2'],
        ['studentEnrollments'],
        ['activities'],
    ], {}, 'card.title'|trans) }}
    {{ m.start_button() }}
        {% if not read_only %}{{ m.submit_button('submit', 'check', 'btn-success', 'form.save'|trans) }}{% endif %}
        {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
    {{ m.end_button() }}
    {{ form_end(form) }}
    {% if agreement.id and is_granted('WPT_AGREEMENT_MANAGE', agreement) %}
        {{ fl.danger_zone('danger.title'|trans, 'danger.text'|trans, path('workplace_training_agreement_operation', {'shift': agreement.shift.id}), agreement.id) }}
    {% endif %}

    {% include 'ui/new_person_modal.html.twig' %}
{% endblock %}

{% block _agreement_activities_widget %}
    {{ cl.checklist(form, choices, 'form.select_all'|trans, 'form.select_none'|trans, 'form.no_activities'|trans) }}
{% endblock %}
