{% trans_default_domain 'wpt_agreement' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}
{% import 'ui/form_layout.html.twig' as fl %}
{% import 'ui/form_checklist.html.twig' as cl %}
{% form_theme form 'ui/form_theme.html.twig' _self %}

{% block content %}
    {{ form_start(form) }}
    {{ fl.grid(form, [
        ['studentEnrollment'],
        ['educationalTutor', 'additionalEducationalTutor'],
        ['workTutor', 'additionalWorkTutor'],
        ['activities'],
    ], {}, 'card.title.enrollment'|trans) }}
    {{ m.start_button() }}
        {% if not read_only %}{{ m.submit_button('submit', 'check', 'btn-success', 'form.save'|trans) }}{% endif %}
        {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
    {{ m.end_button() }}
    {{ form_end(form) }}

    {% include 'ui/new_person_modal.html.twig' %}
{% endblock %}

{% block _agreement_enrollment_activities_widget %}
    {{ cl.checklist(form, choices, 'form.select_all'|trans, 'form.select_none'|trans, 'form.no_activities'|trans) }}
{% endblock %}
