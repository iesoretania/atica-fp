{% extends 'ui/delete.html.twig' %}
{% set domain = 'calendar' %}
{% trans_default_domain 'calendar' %}

{% block delete_header %}
    <th>{{ 'header.date'|trans }}</th>
    <th>{{ 'header.hours'|trans }}</th>
{% endblock %}

{% block delete_rows %}
    {% for item in items %}
        <tr>
            <td>{{ item.date|date('format.date'|trans({}, 'general')) }}</td>
            <td>{{ 'caption.hours'|trans({'count': item.hours / 100}) }}</td>
        </tr>
    {% endfor %}
{% endblock %}
