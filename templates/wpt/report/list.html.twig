{% trans_default_domain 'wpt_shift' %}
{% extends 'ui/list.html.twig' %}
{% import 'ui/macros.html.twig' as m %}

{% block new_action %}{% endblock %}

{% block table_header %}
    <th>{{ 'header.name'|trans }}</th>
    <th>{{ 'header.grade'|trans }}</th>
    <th>{{ 'header.agreements'|trans }}</th>
{% endblock %}

{% block table_body %}
    {% for item in pager %}
        {% set url = path(route_name, {'shift': item.id}) %}
        <tr class="clickable-row" data-href="{{ url }}" data-target="_blank">
            <td><a href="{{ url }}" {% if new_window|default(true) %}target="_blank"{% endif %} class="font-medium text-gray-900 hover:text-brand-700">{{ item.name }}</a></td>
            <td>{{ item.subject.grade }}</td>
            <td>{{ item.agreements|length }}</td>
        </tr>
    {% else %}
        <tr><td colspan="3" class="py-8 text-center text-gray-500">{{ 'table.no_items'|trans }}</td></tr>
    {% endfor %}
{% endblock %}

{% block before_filter %}
    {% include 'ui/partial_academic_year.html.twig' with {academic_year_route: app.current_route} %}
{% endblock %}

{% block pagerfanta %}
    {{ pagerfanta(pager, 'tailwind', {'prev_message': 'paginator.prev'|trans([], 'general'), 'next_message': 'paginator.next'|trans([], 'general'), 'routeParams': {'academicYear': academic_year.id}}) }}
{% endblock %}

{% block after_table %}
    {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
{% endblock %}
