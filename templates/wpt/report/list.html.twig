{% trans_default_domain 'wpt_shift' %}
{% extends 'ui/layout.html.twig' %}

{#- Listado dinámico (Live Component Wpt:ReportList); el selector de curso académico navega a otra página -#}
{% block content %}
    <div data-controller="list">
        {% include 'ui/partial_academic_year.html.twig' with {academic_year_route: app.current_route} %}
    </div>
    {% set base_url = path(app.current_route, app.request.attributes.get('_route_params')|filter((v, k) => k != 'page')) %}
    <twig:Wpt:ReportList :academicYear="academic_year" :routeName="route_name" :q="q|default('')" :page="page|default(1)" :baseUrl="base_url" :backUrl="last_url" />
{% endblock %}
