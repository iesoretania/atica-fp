{% trans_default_domain 'wpt_final_report' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}
{% import 'ui/form_layout.html.twig' as fl %}
{% form_theme form 'ui/form_theme.html.twig' %}

{% block content %}
    {{ form_start(form) }}
    {{ fl.grid(form, [
        ['workActivities'],
        ['professionalCompetence', 'organizationalCompetence'],
        ['relationalCompetence', 'contingencyResponse'],
        ['proposedChanges'],
        ['signDate', null, null],
    ], {workActivities: {attr: {rows: 5}}, proposedChanges: {attr: {rows: 4}}}) }}
    {{ m.start_button() }}
        {% if not read_only %}{{ m.submit_button('submit', 'check', 'btn-success', 'form.save'|trans) }}{% endif %}
        {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
    {{ m.end_button() }}
    {{ form_end(form) }}
{% endblock %}
