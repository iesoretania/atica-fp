{% trans_default_domain 'wpt_activity' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}
{% form_theme form 'ui/form_theme.html.twig' %}

{% block content %}
    <h2 class="mb-3 text-lg font-semibold text-gray-900">{{ 'form.copy_to'|trans({'shift': shift}) }}</h2>
    <twig:Ui:Alert type="info" :message="'prompt.copy_wlt_information'|trans" />
    {{ form_start(form) }}
    {{ form_widget(form) }}
    {{ m.start_button() }}
        {{ m.submit_button('submit', 'copy', 'btn-success', 'form.copy_wlt_from'|trans) }}
        {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
    {{ m.end_button() }}
    {{ form_end(form) }}
{% endblock %}
