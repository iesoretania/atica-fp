{#- Tarjeta contenedora. Opcional: title. -#}
{%- props title = null -%}
<div {{ attributes.without('class') }} class="rounded-xl bg-white shadow-xs ring-1 ring-gray-200 {{ attributes.render('class') }}">
    {% if title %}<h2 class="border-b border-gray-200 px-5 py-3 text-sm font-semibold text-gray-900">{{ title }}</h2>{% endif %}
    <div class="p-5">{% block content %}{% endblock %}</div>
</div>
