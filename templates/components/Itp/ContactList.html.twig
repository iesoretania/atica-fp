{% trans_default_domain 'itp_contact' %}
<div {{ attributes.defaults({
    'data-controller': 'live-history list',
    'data-live-history-base-url-value': this.baseUrl,
}) }}>
    {% embed 'ui/live_list.html.twig' with {pager: this.pager, domain: 'itp_contact', base_url: this.baseUrl, back_url: this.backUrl, academic_year: this.academicYear, allow_new: this.allowNew} %}
        {% import 'ui/macros.html.twig' as m %}
        {% block path_new %}{{ path('in_company_training_phase_contact_new') }}{% endblock %}
        {% block new_action %}{% if allow_new %}{{ parent() }}{% endif %}{% endblock %}

        {% block table_header %}
            {% import 'ui/live_macros.html.twig' as lm %}
            <th aria-sort="{{ this.sort == 'datetime' ? (this.dir == 'desc' ? 'descending' : 'ascending') : 'none' }}">
                <div class="flex items-center gap-2">
                    <input type="checkbox" data-list-target="selectAll" class="size-4 rounded border-gray-300 text-brand-600" aria-label="{{ 'selection.clear'|trans({}, 'general') }}">
                    {{ lm.sort_button('header.datetime'|trans({}, domain), 'datetime', this.sort, this.dir) }}
                </div>
            </th>
            <th aria-sort="{{ this.sort == 'teacher' ? (this.dir == 'desc' ? 'descending' : 'ascending') : 'none' }}">{{ lm.sort_button('header.teacher'|trans({}, domain), 'teacher', this.sort, this.dir) }}</th>
            <th aria-sort="{{ this.sort == 'method' ? (this.dir == 'desc' ? 'descending' : 'ascending') : 'none' }}">{{ lm.sort_button('header.method'|trans({}, domain), 'method', this.sort, this.dir) }}</th>
            <th>{{ 'header.workcenter'|trans({}, domain) }}</th>
            <th>{{ 'header.training_programs'|trans({}, domain) }}</th>
            <th>{{ 'header.student_enrollments'|trans({}, domain) }}</th>
        {% endblock %}

        {% block table_body %}
            {% for item in pager %}
                {% set url = path('in_company_training_phase_contact_edit', {'id': item.id}) %}
                {% set row_read_only = not is_granted('ITP_CONTACT_MANAGE', item) %}
                <tr>
                    <td class="align-top">
                        <label class="flex items-center gap-2">
                            <input type="checkbox" name="items[]" value="{{ item.id }}" class="size-4 rounded border-gray-300 text-brand-600{% if not row_read_only %} selectable{% endif %}"{% if row_read_only %} disabled{% endif %}>
                            <a href="{{ url }}" class="font-medium text-gray-900 hover:text-brand-700">{{ item.datetime|date('format.datetime'|trans({}, 'general')) }}</a>
                        </label>
                    </td>
                    <td class="align-top">{{ item.teacher }}</td>
                    <td class="align-top">{{ item.method|default('form.on-site'|trans({}, domain)) }}</td>
                    <td class="align-top">{{ item.workcenter }}</td>
                    <td class="align-top">{{ item.trainingPrograms|join(', ') }}</td>
                    <td class="align-top">{{ item.studentEnrollments|join(', ') }}</td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="py-8 text-center text-gray-500">{{ 'table.no_items'|trans({}, domain) }}</td></tr>
            {% endfor %}
        {% endblock %}

        {% block form_action %}{{ path('in_company_training_phase_contact_operation', {'academicYear': academic_year.id}) }}{% endblock %}

        {% block after_table %}
            {{ m.link_button(back_url, 'arrow-left', 'btn-info', 'form.back'|trans({}, domain)) }}
        {% endblock %}
        {% block selection_actions %}
            {{ m.submit_button('delete', 'trash', 'btn-danger enable-on-items', 'form.delete'|trans({}, domain), true) }}
        {% endblock %}
    {% endembed %}
</div>
