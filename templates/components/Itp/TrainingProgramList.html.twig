{% trans_default_domain 'itp_training_program' %}
<div {{ attributes.defaults({
    'data-controller': 'live-history list',
    'data-live-history-base-url-value': this.baseUrl,
}) }}>
    {% embed 'ui/live_list.html.twig' with {pager: this.pager, domain: 'itp_training_program', base_url: this.baseUrl, back_url: this.backUrl, academic_year: this.academicYear} %}
        {% import 'ui/macros.html.twig' as m %}
        {% block path_new %}{{ path('in_company_training_phase_training_program_new', {'academicYear': academic_year.id}) }}{% endblock %}

        {% block table_header %}
            {% import 'ui/live_macros.html.twig' as lm %}
            <th aria-sort="{{ this.sort == 'name' ? (this.dir == 'desc' ? 'descending' : 'ascending') : 'none' }}">
                <div class="flex items-center gap-2">
                    <input type="checkbox" data-list-target="selectAll" class="size-4 rounded border-gray-300 text-brand-600" aria-label="{{ 'selection.clear'|trans({}, 'general') }}">
                    {{ lm.sort_button('header.name'|trans({}, domain), 'name', this.sort, this.dir) }}
                </div>
            </th>
            <th aria-sort="{{ this.sort == 'modality' ? (this.dir == 'desc' ? 'descending' : 'ascending') : 'none' }}">{{ lm.sort_button('header.modality'|trans({}, domain), 'modality', this.sort, this.dir) }}</th>
            <th>{{ 'header.groups'|trans({}, domain) }}</th>
            <th aria-sort="{{ this.sort == 'hours' ? (this.dir == 'desc' ? 'descending' : 'ascending') : 'none' }}">{{ lm.sort_button('header.target_hours'|trans({}, domain), 'hours', this.sort, this.dir) }}</th>
            <th></th>
        {% endblock %}

        {% block table_body %}
            {% for item in pager %}
                {% set url = path('in_company_training_phase_grade_list', {'trainingProgram': item.id}) %}
                <tr>
                    <td class="align-top">
                        <label class="flex items-center gap-2">
                            <input type="checkbox" name="items[]" value="{{ item.id }}" class="selectable size-4 rounded border-gray-300 text-brand-600">
                            <a href="{{ url }}" class="font-medium text-gray-900 hover:text-brand-700">{{ item.name }}</a>
                            {% if item.locked %}<twig:Ui:Icon name="lock" class="size-3.5 text-gray-400" />{% endif %}
                        </label>
                    </td>
                    <td class="align-top">{{ ('table.modality.' ~ item.modality)|trans({}, domain) }}</td>
                    <td class="align-top">{% for program_grade in item.trainingProgramGrades %}{% for group in program_grade.grade.groups %}{{ group.name }} ({{ group.grade.training.academicYear }}){% if not loop.last %}, {% endif %}{% endfor %}{% if not loop.last %}, {% endif %}{% endfor %}</td>
                    <td class="align-top">
                        {{ (item.targetHours / 100)|number_format(2, 'format.decimal_separator'|trans({}, 'general'), 'format.thousand_separator'|trans({}, 'general')) -}}
                        {%- if item.totalHours %}/{{ (item.totalHours / 100)|number_format(2, 'format.decimal_separator'|trans({}, 'general'), 'format.thousand_separator'|trans({}, 'general')) }} ({{ (item.targetHours * 100 / item.totalHours)|number_format(2, 'format.decimal_separator'|trans({}, 'general'), 'format.thousand_separator'|trans({}, 'general')) }} %){% endif %}
                    </td>
                    <td class="text-right">{{ m.link_button(path('in_company_training_phase_training_program_edit', {'trainingProgram': item.id}), 'pencil', 'btn-info btn-sm', 'table.basic_data'|trans({}, domain)) }}</td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="py-8 text-center text-gray-500">{{ 'table.no_items'|trans({}, domain) }}</td></tr>
            {% endfor %}
        {% endblock %}

        {% block form_action %}{{ path('in_company_training_phase_training_program_operation', {'academicYear': academic_year.id}) }}{% endblock %}

        {% block after_table %}
            {{ m.link_button(back_url, 'arrow-left', 'btn-info', 'form.back'|trans({}, domain)) }}
        {% endblock %}
        {% block selection_actions %}
            {% if not is_read_only() %}{{ m.submit_button('delete', 'trash', 'btn-danger enable-on-items', 'form.delete'|trans({}, domain), true) }}{% endif %}
        {% endblock %}
    {% endembed %}
</div>
