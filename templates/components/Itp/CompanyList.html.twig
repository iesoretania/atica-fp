{% trans_default_domain 'itp_company' %}
<div {{ attributes.defaults({
    'data-controller': 'live-history list',
    'data-live-history-base-url-value': this.baseUrl,
}) }}>
    {% embed 'ui/live_list.html.twig' with {pager: this.pager, domain: 'itp_company', base_url: this.baseUrl, back_url: this.backUrl, program_grade: this.programGrade, stats: this.stats} %}
        {% import 'ui/macros.html.twig' as m %}
        {% block path_new %}{{ path('in_company_training_phase_company_new', {'programGrade': program_grade.id}) }}{% endblock %}

        {% block table_header %}
            {% import 'ui/live_macros.html.twig' as lm %}
            <th aria-sort="{{ this.sort == 'code' ? (this.dir == 'desc' ? 'descending' : 'ascending') : 'none' }}">
                <div class="flex items-center gap-2">
                    <input type="checkbox" data-list-target="selectAll" class="size-4 rounded border-gray-300 text-brand-600" aria-label="{{ 'selection.clear'|trans({}, 'general') }}">
                    {{ lm.sort_button('header.code'|trans({}, domain), 'code', this.sort, this.dir) }}
                </div>
            </th>
            <th aria-sort="{{ this.sort == 'name' ? (this.dir == 'desc' ? 'descending' : 'ascending') : 'none' }}">{{ lm.sort_button('header.name'|trans({}, domain), 'name', this.sort, this.dir) }}</th>
            <th aria-sort="{{ this.sort == 'agreement' ? (this.dir == 'desc' ? 'descending' : 'ascending') : 'none' }}">{{ lm.sort_button('header.agreement_number'|trans({}, domain), 'agreement', this.sort, this.dir) }}</th>
            <th>{{ 'header.activities'|trans({}, domain) }}</th>
            <th>{{ 'header.learning_outcomes'|trans({}, domain) }}</th>
            <th>{{ 'header.criteria'|trans({}, domain) }}</th>
        {% endblock %}

        {% block table_body %}
            {% for item in pager %}
                {% set url = path('in_company_training_phase_company_edit', {'id': item.id}) %}
                <tr>
                    <td>
                        <label class="flex items-center gap-2">
                            <input type="checkbox" name="items[]" value="{{ item.id }}" class="selectable size-4 rounded border-gray-300 text-brand-600">
                            <a href="{{ url }}" class="font-medium text-gray-900 hover:text-brand-700">{{ item.company.code }}</a>
                        </label>
                    </td>
                    <td>{{ item.company.name }}</td>
                    <td>{{ item.agreementNumber }}</td>
                    <td>{{ stats[item.id].activity_count }}</td>
                    <td>{{ stats[item.id].learning_outcome_count }}</td>
                    <td>{{ stats[item.id].criteria_count }}</td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="py-8 text-center text-gray-500">{{ 'table.no_items'|trans({}, domain) }}</td></tr>
            {% endfor %}
        {% endblock %}

        {% block form_action %}{{ path('in_company_training_phase_company_operation', {'programGrade': program_grade.id}) }}{% endblock %}

        {% block after_table %}
            {{ m.link_button(back_url, 'arrow-left', 'btn-info', 'form.back'|trans({}, domain)) }}
        {% endblock %}
        {% block selection_actions %}
            {% if not is_read_only() %}{{ m.submit_button('delete', 'trash', 'btn-danger enable-on-items', 'form.delete'|trans({}, domain), true) }}{% endif %}
        {% endblock %}
    {% endembed %}
</div>
