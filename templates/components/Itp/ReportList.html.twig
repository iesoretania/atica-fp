{% trans_default_domain 'itp_training_program' %}
<div {{ attributes.defaults({
    'data-controller': 'live-history list',
    'data-live-history-base-url-value': this.baseUrl,
}) }}>
    {% embed 'ui/live_list.html.twig' with {pager: this.pager, domain: 'itp_training_program', base_url: this.baseUrl, back_url: this.backUrl, route_name: this.routeName, academic_year: this.academicYear} %}
        {% import 'ui/macros.html.twig' as m %}
        {% block new_action %}{% endblock %}

        {% block table_header %}
            {% import 'ui/live_macros.html.twig' as lm %}
            <th aria-sort="{{ this.sort == 'name' ? (this.dir == 'desc' ? 'descending' : 'ascending') : 'none' }}">{{ lm.sort_button('header.name'|trans({}, domain), 'name', this.sort, this.dir) }}</th>
            <th aria-sort="{{ this.sort == 'modality' ? (this.dir == 'desc' ? 'descending' : 'ascending') : 'none' }}">{{ lm.sort_button('header.modality'|trans({}, domain), 'modality', this.sort, this.dir) }}</th>
            <th>{{ 'header.groups'|trans({}, domain) }}</th>
            <th>{{ 'header.target_hours'|trans({}, domain) }}</th>
            <th></th>
        {% endblock %}

        {% block table_body %}
            {% for item in pager %}
                {% set url = path(route_name, {'trainingProgram': item.id, 'academicYear': academic_year.id}) %}
                <tr>
                    <td>
                        {{ item.name }}
                        {% if item.locked %}<twig:Ui:Icon name="lock" class="ml-1 inline size-3.5 text-gray-400" />{% endif %}
                    </td>
                    <td>{{ ('table.modality.' ~ item.modality)|trans({}, domain) }}</td>
                    <td>{% for program_grade in item.trainingProgramGrades %}{% for group in program_grade.grade.groups %}{{ group.name }} ({{ group.grade.training.academicYear }}){% if not loop.last %}, {% endif %}{% endfor %}{% if not loop.last %}, {% endif %}{% endfor %}</td>
                    <td>
                        {{ (item.targetHours / 100)|number_format(2, 'format.decimal_separator'|trans({}, 'general'), 'format.thousand_separator'|trans({}, 'general')) -}}
                        {%- if item.totalHours %}/{{ (item.totalHours / 100)|number_format(2, 'format.decimal_separator'|trans({}, 'general'), 'format.thousand_separator'|trans({}, 'general')) }} ({{ (item.targetHours * 100 / item.totalHours)|number_format(2, 'format.decimal_separator'|trans({}, 'general'), 'format.thousand_separator'|trans({}, 'general')) }} %){% endif %}
                    </td>
                    <td class="text-right">{{ m.link_button_new(url, 'file-alt', 'btn-info btn-sm', 'form.report'|trans({}, domain)) }}</td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="py-8 text-center text-gray-500">{{ 'table.no_items'|trans({}, domain) }}</td></tr>
            {% endfor %}
        {% endblock %}

        {% block after_table %}
            {{ m.link_button(back_url, 'arrow-left', 'btn-info', 'form.back'|trans({}, domain)) }}
        {% endblock %}
    {% endembed %}
</div>
