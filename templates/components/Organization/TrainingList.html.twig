{% trans_default_domain 'edu_training' %}
<div {{ attributes.defaults({
    'data-controller': 'live-history list',
    'data-live-history-base-url-value': this.baseUrl,
}) }}>
    {% embed 'ui/live_list.html.twig' with {pager: this.pager, domain: 'edu_training', base_url: this.baseUrl, back_url: this.backUrl, academic_year: this.academicYear} %}
        {% import 'ui/macros.html.twig' as m %}
        {% import 'ui/live_macros.html.twig' as lm %}
        {% block path_new %}{{ path('organization_training_new') }}{% endblock %}

        {% block table_header %}
            {{ lm.select_th('header.name'|trans({}, domain), 'name', this.sort, this.dir) }}
            <th>{{ 'header.department'|trans({}, domain) }}</th>
            <th>{{ 'header.grades'|trans({}, domain) }}</th>
            <th class="w-40"></th>
        {% endblock %}

        {% block table_body %}
            {% for training in pager %}
                <tr>
                    {{ lm.select_cell(training.id, path('organization_training_edit', {'id': training.id}), training.name) }}
                    <td class="align-top">{{ training.department|default('') }}</td>
                    <td class="align-top">{{ training.grades|join(', ') }}</td>
                    <td class="align-top">{{ m.link_button(path('organization_training_competency_list', {'id': training.id}), 'graduation-cap', 'btn-info btn-sm', 'table.competences'|trans({}, domain)) }}</td>
                </tr>
            {% else %}
                <tr><td colspan="4" class="py-8 text-center text-gray-500">{{ 'table.no_items'|trans({}, domain) }}</td></tr>
            {% endfor %}
        {% endblock %}

        {% block form_action %}{{ path('organization_training_delete', {'academicYear': academic_year.id}) }}{% endblock %}
        {% block after_table %}{{ m.link_button(back_url, 'arrow-left', 'btn-info', 'form.back'|trans({}, domain)) }}{% endblock %}
        {% block selection_actions %}{{ m.submit_button('delete', 'trash', 'btn-danger enable-on-items', 'form.delete'|trans({}, domain), true) }}{% endblock %}
    {% endembed %}
</div>
