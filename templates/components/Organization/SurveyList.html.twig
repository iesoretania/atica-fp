{% trans_default_domain 'edu_survey' %}
<div {{ attributes.defaults({
    'data-controller': 'live-history list',
    'data-live-history-base-url-value': this.baseUrl,
}) }}>
    {% embed 'ui/live_list.html.twig' with {pager: this.pager, domain: 'edu_survey', base_url: this.baseUrl, back_url: this.backUrl} %}
        {% import 'ui/macros.html.twig' as m %}
        {% import 'ui/live_macros.html.twig' as lm %}
        {% block path_new %}{{ path('organization_survey_new') }}{% endblock %}

        {% block table_header %}
            {{ lm.select_th('header.title'|trans({}, domain), 'title', this.sort, this.dir) }}
            {{ lm.sort_th('header.start_timestamp'|trans({}, domain), 'start', this.sort, this.dir) }}
            {{ lm.sort_th('header.end_timestamp'|trans({}, domain), 'end', this.sort, this.dir) }}
            <th>{{ 'header.answer_count'|trans({}, domain) }}</th>
            <th class="w-40"></th>
        {% endblock %}

        {% block table_body %}
            {% for survey in pager %}
                <tr>
                    {{ lm.select_cell(survey.id, path('organization_survey_edit', {'id': survey.id}), survey.title) }}
                    <td class="align-top">{{ survey.startTimestamp ? survey.startTimestamp|date('format.datetime'|trans({}, 'general')) }}</td>
                    <td class="align-top">{{ survey.endTimestamp ? survey.endTimestamp|date('format.datetime'|trans({}, 'general')) }}</td>
                    <td class="align-top">{{ survey.answers|length }}</td>
                    <td class="align-top">{{ m.link_button(path('organization_survey_question_list', {'id': survey.id}), 'clipboard-list', 'btn-info btn-sm', 'table.questions'|trans({}, domain)) }}</td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="py-8 text-center text-gray-500">{{ 'table.no_items'|trans({}, domain) }}</td></tr>
            {% endfor %}
        {% endblock %}

        {% block form_action %}{{ path('organization_survey_operation') }}{% endblock %}
        {% block after_table %}{{ m.link_button(back_url, 'arrow-left', 'btn-info', 'form.back'|trans({}, domain)) }}{% endblock %}
        {% block selection_actions %}{{ m.submit_button('delete', 'trash', 'btn-danger enable-on-items', 'form.delete'|trans({}, domain), true) }}{% endblock %}
    {% endembed %}
</div>
