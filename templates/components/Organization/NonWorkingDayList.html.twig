{% trans_default_domain 'edu_non_working_day' %}
<div {{ attributes.defaults({
    'data-controller': 'live-history list',
    'data-live-history-base-url-value': this.baseUrl,
}) }}>
    {% embed 'ui/live_list.html.twig' with {pager: this.pager, domain: 'edu_non_working_day', base_url: this.baseUrl, back_url: this.backUrl, academic_year: this.academicYear} %}
        {% import 'ui/macros.html.twig' as m %}
        {% import 'ui/live_macros.html.twig' as lm %}
        {% block path_new %}{{ path('organization_non_working_day_new', {'academicYear': academic_year.id}) }}{% endblock %}

        {% block table_header %}
            {{ lm.select_th('header.date'|trans({}, domain), 'date', this.sort, this.dir) }}
            {{ lm.sort_th('header.description'|trans({}, domain), 'description', this.sort, this.dir) }}
        {% endblock %}

        {% block table_body %}
            {% for item in pager %}
                <tr>
                    {{ lm.select_cell(item.id, path('organization_non_working_day_edit', {'id': item.id}), item.date|date('format.date'|trans({}, 'general'))) }}
                    <td class="align-top">{{ item.description }}</td>
                </tr>
            {% else %}
                <tr><td colspan="2" class="py-8 text-center text-gray-500">{{ 'table.no_items'|trans({}, domain) }}</td></tr>
            {% endfor %}
        {% endblock %}

        {% block form_action %}{{ path('organization_non_working_day_delete', {'academicYear': academic_year.id}) }}{% endblock %}
        {% block after_table %}{{ m.link_button(back_url, 'arrow-left', 'btn-info', 'form.back'|trans({}, domain)) }}{% endblock %}
        {% block selection_actions %}{{ m.submit_button('delete', 'trash', 'btn-danger enable-on-items', 'form.delete'|trans({}, domain), true) }}{% endblock %}
    {% endembed %}
</div>
