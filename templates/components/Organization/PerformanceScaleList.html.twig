{% trans_default_domain 'edu_performance_scale' %}
<div {{ attributes.defaults({
    'data-controller': 'live-history list',
    'data-live-history-base-url-value': this.baseUrl,
}) }}>
    {% embed 'ui/live_list.html.twig' with {pager: this.pager, domain: 'edu_performance_scale', base_url: this.baseUrl, back_url: this.backUrl} %}
        {% import 'ui/macros.html.twig' as m %}
        {% import 'ui/live_macros.html.twig' as lm %}
        {% block path_new %}{{ path('organization_performance_scale_new') }}{% endblock %}

        {% block table_header %}
            {{ lm.select_th('header.description'|trans({}, domain), 'description', this.sort, this.dir) }}
            <th class="w-40"></th>
        {% endblock %}

        {% block table_body %}
            {% for performance_scale in pager %}
                <tr>
                    <td class="align-top">
                        <label class="flex items-center gap-2">
                            <input type="checkbox" name="items[]" value="{{ performance_scale.id }}" class="selectable size-4 rounded border-gray-300 text-brand-600">
                            <a href="{{ path('organization_performance_scale_edit', {'id': performance_scale.id}) }}" class="font-medium text-gray-900 hover:text-brand-700">{{ performance_scale.description }}</a>
                            {% if not performance_scale.enabled %}<span class="rounded-full bg-red-50 px-2 py-0.5 text-xs font-medium text-red-700 ring-1 ring-red-200">{{ 'table.disabled'|trans({}, domain) }}</span>{% endif %}
                        </label>
                    </td>
                    <td class="align-top">{{ m.link_button(path('organization_performance_scale_value_list', {'id': performance_scale.id}), 'award', 'btn-info btn-sm', 'table.values'|trans({}, domain)) }}</td>
                </tr>
            {% else %}
                <tr><td colspan="2" class="py-8 text-center text-gray-500">{{ 'table.no_items'|trans({}, domain) }}</td></tr>
            {% endfor %}
        {% endblock %}

        {% block form_action %}{{ path('organization_performance_scale_operation') }}{% endblock %}
        {% block after_table %}{{ m.link_button(back_url, 'arrow-left', 'btn-info', 'form.back'|trans({}, domain)) }}{% endblock %}
        {% block selection_actions %}{{ m.submit_button('delete', 'trash', 'btn-danger enable-on-items', 'form.delete'|trans({}, domain), true) }}{% endblock %}
    {% endembed %}
</div>
