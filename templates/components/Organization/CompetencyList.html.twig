{% trans_default_domain 'edu_competency' %}
<div {{ attributes.defaults({
    'data-controller': 'live-history list',
    'data-live-history-base-url-value': this.baseUrl,
}) }}>
    {% embed 'ui/live_list.html.twig' with {pager: this.pager, domain: 'edu_competency', base_url: this.baseUrl, back_url: this.backUrl, training: this.training} %}
        {% import 'ui/macros.html.twig' as m %}
        {% import 'ui/live_macros.html.twig' as lm %}
        {% block path_new %}{{ path('organization_training_competency_new', {'id': training.id}) }}{% endblock %}

        {% block table_header %}
            {{ lm.select_th('header.code'|trans({}, domain), 'code', this.sort, this.dir) }}
            <th>{{ 'header.description'|trans({}, domain) }}</th>
        {% endblock %}

        {% block table_body %}
            {% for competency in pager %}
                <tr>
                    {{ lm.select_cell(competency.id, path('organization_training_competency_edit', {'id': competency.id}), competency.code) }}
                    <td class="align-top">{{ competency.description|nl2br }}</td>
                </tr>
            {% else %}
                <tr><td colspan="2" class="py-8 text-center text-gray-500">{{ 'table.no_items'|trans({}, domain) }}</td></tr>
            {% endfor %}
        {% endblock %}

        {% block form_action %}{{ path('organization_training_competency_delete', {'id': training.id}) }}{% endblock %}
        {% block after_table %}{{ m.link_button(back_url, 'arrow-left', 'btn-info', 'form.back'|trans({}, domain)) }}{% endblock %}
        {% block selection_actions %}{{ m.submit_button('delete', 'trash', 'btn-danger enable-on-items', 'form.delete'|trans({}, domain), true) }}{% endblock %}
    {% endembed %}
</div>
