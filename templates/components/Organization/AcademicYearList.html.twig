{% trans_default_domain 'edu_academic_year' %}
<div {{ attributes.defaults({
    'data-controller': 'live-history list',
    'data-live-history-base-url-value': this.baseUrl,
}) }}>
    {% embed 'ui/live_list.html.twig' with {pager: this.pager, domain: 'edu_academic_year', base_url: this.baseUrl, back_url: this.backUrl, current: this.current} %}
        {% import 'ui/macros.html.twig' as m %}
        {% import 'ui/live_macros.html.twig' as lm %}
        {% block path_new %}{{ path('organization_academic_year_new') }}{% endblock %}

        {% block table_header %}
            {{ lm.select_th('header.description'|trans({}, domain), 'description', this.sort, this.dir) }}
            <th>{{ 'header.principal'|trans({}, domain) }}</th>
            <th>{{ 'header.financial_manager'|trans({}, domain) }}</th>
            <th>{{ 'header.modules'|trans({}, domain) }}</th>
            <th></th>
            <th>{{ 'header.active'|trans({}, domain) }}</th>
        {% endblock %}

        {% block table_body %}
            {% for academic_year in pager %}
                <tr>
                    <td class="align-top">
                        <label class="flex items-center gap-2">
                            <input type="checkbox" name="items[]" value="{{ academic_year.id }}" class="selectable size-4 rounded border-gray-300 text-brand-600"{% if academic_year == current %} disabled{% endif %}>
                            <a href="{{ path('organization_academic_year_edit', {'id': academic_year.id}) }}" class="font-medium text-gray-900 hover:text-brand-700">{{ academic_year.description }}</a>
                        </label>
                    </td>
                    <td class="align-top">{{ academic_year.principal|default('') }}</td>
                    <td class="align-top">{{ academic_year.financialManager|default('') }}</td>
                    <td class="align-top">
                        <div class="flex flex-wrap gap-1">
                            {% for module in module_extension.modules %}
                                {% if academic_year.hasModule(module) %}<span class="rounded-full bg-brand-50 px-2 py-0.5 text-xs font-medium text-brand-800 ring-1 ring-brand-200" title="{{ 'module.description'|trans([], 'module_' ~ module) }}">{{ 'module.initials'|trans([], 'module_' ~ module) }}</span>{% endif %}
                            {% endfor %}
                        </div>
                    </td>
                    <td class="align-top">{{ m.link_button(path('organization_academic_year_copy', {'id': academic_year.id}), 'copy', 'btn-secondary btn-sm', 'form.copy'|trans({}, domain)) }}</td>
                    <td class="align-top">
                        {% if academic_year != current %}
                            {{ m.submit_button('switch', 'power-off', 'btn-primary btn-sm', 'form.switch'|trans({}, domain), false, academic_year.id) }}
                        {% else %}
                            <span class="inline-flex items-center gap-1.5 text-emerald-700"><twig:Ui:Icon name="check" /> {{ 'table.active'|trans({}, domain) }}</span>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="py-8 text-center text-gray-500">{{ 'table.no_items'|trans({}, domain) }}</td></tr>
            {% endfor %}
        {% endblock %}

        {% block form_action %}{{ path('organization_academic_year_operation') }}{% endblock %}
        {% block after_table %}{{ m.link_button(back_url, 'arrow-left', 'btn-info', 'form.back'|trans({}, domain)) }}{% endblock %}
        {% block selection_actions %}{{ m.submit_button('delete', 'trash', 'btn-danger enable-on-items', 'form.delete'|trans({}, domain), true) }}{% endblock %}
    {% endembed %}
</div>
