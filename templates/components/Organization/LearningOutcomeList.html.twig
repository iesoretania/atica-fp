{% trans_default_domain 'edu_learning_outcome' %}
<div {{ attributes.defaults({
    'data-controller': 'live-history list',
    'data-live-history-base-url-value': this.baseUrl,
}) }}>
    {% embed 'ui/live_list.html.twig' with {pager: this.pager, domain: 'edu_learning_outcome', base_url: this.baseUrl, back_url: this.backUrl, subject: this.subject} %}
        {% import 'ui/macros.html.twig' as m %}
        {% import 'ui/live_macros.html.twig' as lm %}
        {% block path_new %}{{ path('organization_training_learning_outcome_new', {'id': subject.id}) }}{% endblock %}

        {% block table_header %}
            {{ lm.select_th('header.code'|trans({}, domain), 'code', this.sort, this.dir) }}
            <th>{{ 'header.description'|trans({}, domain) }}</th>
            <th class="w-40"></th>
        {% endblock %}

        {% block table_body %}
            {% for learning_outcome in pager %}
                <tr>
                    {{ lm.select_cell(learning_outcome.id, path('organization_training_learning_outcome_edit', {'id': learning_outcome.id}), learning_outcome.code) }}
                    <td class="align-top">{{ learning_outcome.description|nl2br }}</td>
                    <td class="align-top">{{ m.link_button(path('organization_training_criterion_list', {'id': learning_outcome.id}), 'list-check', 'btn-info btn-sm', 'table.criteria'|trans({}, domain)) }}</td>
                </tr>
            {% else %}
                <tr><td colspan="3" class="py-8 text-center text-gray-500">{{ 'table.no_items'|trans({}, domain) }}</td></tr>
            {% endfor %}
        {% endblock %}

        {% block form_action %}{{ path('organization_training_learning_outcome_delete', {'id': subject.id}) }}{% endblock %}
        {% block after_table %}{{ m.link_button(back_url, 'arrow-left', 'btn-info', 'form.back'|trans({}, domain)) }}{% endblock %}
        {% block selection_actions %}{{ m.submit_button('delete', 'trash', 'btn-danger enable-on-items', 'form.delete'|trans({}, domain), true) }}{% endblock %}
    {% endembed %}
</div>
