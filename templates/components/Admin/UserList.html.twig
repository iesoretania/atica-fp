{% trans_default_domain 'user' %}
<div {{ attributes.defaults({
    'data-controller': 'live-history list',
    'data-live-history-base-url-value': this.baseUrl,
}) }}>
    {% embed 'ui/live_list.html.twig' with {pager: this.pager, domain: 'user', base_url: this.baseUrl, back_url: this.backUrl, current_id: this.currentUserId} %}
        {% import 'ui/macros.html.twig' as m %}
        {% import 'ui/live_macros.html.twig' as lm %}
        {% block path_new %}{{ path('admin_user_form_new') }}{% endblock %}

        {% block table_header %}
            {{ lm.select_th('header.name'|trans({}, domain), 'name', this.sort, this.dir) }}
            {{ lm.sort_th('header.username'|trans({}, domain), 'username', this.sort, this.dir) }}
            <th>{{ 'header.unique_identifier'|trans({}, domain) }}</th>
            <th>{{ 'header.email'|trans({}, domain) }}</th>
            {{ lm.sort_th('header.last_login'|trans({}, domain), 'last_login', this.sort, this.dir) }}
        {% endblock %}

        {% block table_body %}
            {% for user in pager %}
                {% set url = path('admin_user_form_edit', {'id': user.id}) %}
                <tr>
                    <td class="align-top">
                        <label class="flex flex-wrap items-center gap-2">
                            <input type="checkbox" name="users[]" value="{{ user.id }}" class="size-4 rounded border-gray-300 text-brand-600{{ user.id == current_id ? '' : ' selectable' }}"{{ user.id == current_id ? ' disabled' : '' }}>
                            <a href="{{ url }}" class="font-medium text-gray-900 hover:text-brand-700">{{ user.lastName }}, {{ user.firstName }}</a>
                            {%- if user.globalAdministrator %}<span title="{{ 'role.global_administrator'|trans({}, domain) }}" class="text-brand-700"><twig:Ui:Icon name="user-shield" /></span>{% endif -%}
                            {%- if user.forcePasswordChange and not user.externalCheck %}<span title="{{ 'table.force_password_change'|trans({}, domain) }}" class="text-amber-600"><twig:Ui:Icon name="lock-open" /></span>{% endif -%}
                            {%- if user.externalCheck %}<span title="{{ 'table.external_check'|trans({}, domain) }}" class="text-gray-500"><twig:Ui:Icon name="right-left" /></span>{% endif -%}
                            {%- if not user.enabled %}<span title="{{ 'table.disabled'|trans({}, domain) }}" class="text-red-600"><twig:Ui:Icon name="user-slash" /></span>{% endif -%}
                        </label>
                    </td>
                    <td class="align-top"><a href="{{ url }}" class="hover:text-brand-700">{{ user.loginUsername }}</a></td>
                    <td class="align-top">{{ user.uniqueIdentifier }}</td>
                    <td class="align-top">{{ user.emailAddress }}</td>
                    <td class="align-top">{{ user.lastAccess ? user.lastAccess|date('format.datetime'|trans({}, 'general')) }}</td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="py-8 text-center text-gray-500">{{ 'table.no_users'|trans({}, domain) }}</td></tr>
            {% endfor %}
        {% endblock %}

        {% block form_action %}{{ path('admin_user_delete') }}{% endblock %}
        {% block after_table %}{{ m.link_button(back_url, 'arrow-left', 'btn-info', 'form.back'|trans({}, domain)) }}{% endblock %}
        {% block selection_actions %}{{ m.submit_button('delete', 'trash', 'btn-danger enable-on-items', 'form.delete'|trans({}, domain), true) }}{% endblock %}
    {% endembed %}
</div>
