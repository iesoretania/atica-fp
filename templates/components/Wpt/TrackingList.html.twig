{% trans_default_domain 'wpt_tracking' %}
<div {{ attributes.defaults({
    'data-controller': 'live-history list',
    'data-live-history-base-url-value': this.baseUrl,
}) }}>
    {% embed 'ui/live_list.html.twig' with {pager: this.pager, domain: 'wpt_tracking', base_url: this.baseUrl, back_url: this.backUrl} %}
        {% import 'ui/macros.html.twig' as m %}
        {% block new_action %}{% endblock %}

        {#- Los bloques de un embed no heredan trans_default_domain: se indica el dominio en cada traducción -#}
        {% block table_header %}
            {% import 'ui/live_macros.html.twig' as lm %}
            {{ lm.sort_th('header.student'|trans({}, domain), 'student', this.sort, this.dir) }}
            {{ lm.sort_th('header.shift'|trans({}, domain), 'shift', this.sort, this.dir) }}
            {{ lm.sort_th('header.workcenter'|trans({}, domain), 'workcenter', this.sort, this.dir) }}
            <th>{{ 'header.work_tutor'|trans({}, domain) }}</th>
            <th>{{ 'header.educational_tutor'|trans({}, domain) }}</th>
            {{ lm.sort_th('header.dates'|trans({}, domain), 'dates', this.sort, this.dir) }}
            <th>{{ 'header.status'|trans({}, domain) }}</th>
        {% endblock %}

        {% block table_body %}
            {% for item in pager %}
                {% set agreementEnrollment = item[0] %}
                {% set agreement = item[0].agreement %}
                {% set url = path('workplace_training_tracking_calendar_list', {'id': agreementEnrollment.id}) %}
                <tr class="clickable-row" data-href="{{ url }}">
                    <td><a href="{{ url }}" class="font-medium text-gray-900 hover:text-brand-700">{{ agreementEnrollment.studentEnrollment }}</a></td>
                    <td>
                        {{ agreement.shift }}
                        {% if agreement.shift.locked %}<twig:Ui:Icon name="lock" class="ml-1 inline size-3.5 text-gray-400" />{% endif %}
                    </td>
                    <td>{{ agreement.workcenter }}</td>
                    <td>{{ agreementEnrollment.workTutor }}</td>
                    <td>{{ agreementEnrollment.educationalTutor }}</td>
                    <td class="whitespace-nowrap">{{ agreement.startDate ? agreement.startDate|date('format.date'|trans({}, 'general')) }}{{ agreement.endDate ? ' - ' ~ (agreement.endDate|date('format.date'|trans({}, 'general'))) }}</td>
                    <td>
                        {% if item[1] %}
                            {{ 'table.number'|trans({'count': item[2] / 100}, domain) }}/{{ 'table.hours'|trans({'count': item[1] / 100}, domain) }}
                            <span class="font-medium">({{ (item[2]*100/item[1])|number_format(2, 'format.decimal_separator'|trans({}, 'general')) }} %)</span>
                            {% if item[3] != 0 %}
                                - {{ 'table.absences'|trans({'count': item[3]}, domain) }}
                                {% if item[4] != 0 %}- {{ 'table.justified_absences'|trans({'count': item[4]}, domain) }}{% endif %}
                            {% endif %}
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="7" class="py-8 text-center text-gray-500">{{ 'table.no_items'|trans({}, domain) }}</td></tr>
            {% endfor %}
        {% endblock %}

        {% block after_table %}
            {{ m.link_button(back_url, 'arrow-left', 'btn-info', 'form.back'|trans({}, domain)) }}
        {% endblock %}
    {% endembed %}
</div>
