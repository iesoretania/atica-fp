{% trans_default_domain 'wpt_shift' %}
<div {{ attributes.defaults({
    'data-controller': 'live-history list',
    'data-live-history-base-url-value': this.baseUrl,
}) }}>
    {% embed 'ui/live_list.html.twig' with {pager: this.pager, domain: 'wpt_shift', base_url: this.baseUrl, back_url: this.backUrl, academic_year: this.academicYear} %}
        {% block path_new %}{{ path('workplace_training_shift_new', {'academicYear': academic_year.id}) }}{% endblock %}

        {#- Los bloques de un embed no heredan trans_default_domain: se indica el dominio en cada traducción -#}
        {% block table_header %}
            {% import 'ui/live_macros.html.twig' as lm %}
            <th aria-sort="{{ this.sort == 'name' ? (this.dir == 'desc' ? 'descending' : 'ascending') : 'none' }}">
                <div class="flex items-center gap-2">
                    <input type="checkbox" data-list-target="selectAll" class="size-4 rounded border-gray-300 text-brand-600" aria-label="{{ 'selection.clear'|trans({}, 'general') }}">
                    {{ lm.sort_button('header.name'|trans({}, domain), 'name', this.sort, this.dir) }}
                </div>
            </th>
            <th>{{ 'header.groups'|trans({}, domain) }}</th>
            <th>{{ 'header.type'|trans({}, domain) }}</th>
            {{ lm.sort_th('header.hours'|trans({}, domain), 'hours', this.sort, this.dir, 'text-right') }}
            <th class="text-right">{{ 'header.agreements'|trans({}, domain) }}</th>
            <th colspan="2"></th>
        {% endblock %}

        {% block table_body %}
            {% for item in pager %}
                {% set url = path('workplace_training_shift_edit', {'id': item.id}) %}
                <tr>
                    <td>
                        <label class="flex items-center gap-2">
                            <input type="checkbox" name="items[]" value="{{ item.id }}" class="selectable size-4 rounded border-gray-300 text-brand-600">
                            <a href="{{ url }}" class="font-medium text-gray-900 hover:text-brand-700">{{ item.name }}</a>
                            {% if item.locked %}<twig:Ui:Icon name="lock" class="size-3.5 text-gray-400" />{% endif %}
                        </label>
                    </td>
                    <td>{{ item.grade.groups|join(', ') }}</td>
                    <td>{{ item.type }}</td>
                    <td class="text-right tabular-nums">{{ (item.hours / 100)|number_format(2, 'format.decimal_separator'|trans({}, 'general'), 'format.thousand_separator'|trans({}, 'general')) }}</td>
                    <td class="text-right tabular-nums">{{ this.agreementCount(item) }}</td>
                    <td class="text-right">
                        <twig:Ui:Button href="{{ path('workplace_training_activity_list', {'id': item.id}) }}" variant="secondary" size="sm" icon="book" label="{{ 'table.learning_program'|trans({}, domain) }}" />
                    </td>
                    <td class="text-right">
                        <twig:Ui:Button href="{{ path('workplace_training_agreement_list', {'id': item.id}) }}" variant="secondary" size="sm" icon="handshake" label="{{ 'table.agreements'|trans({}, domain) }}" />
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" class="py-8 text-center text-gray-500">{{ 'table.no_items'|trans({}, domain) }}</td>
                </tr>
            {% endfor %}
        {% endblock %}

        {% block form_action %}{{ path('workplace_training_shift_operation', {'academicYear': academic_year.id}) }}{% endblock %}

        {% block after_table %}
            <twig:Ui:Button href="{{ back_url }}" variant="secondary" icon="arrow-left" label="{{ 'form.back'|trans({}, domain) }}" />
        {% endblock %}
        {% block selection_actions %}
            <twig:Ui:Button type="submit" name="delete" variant="danger" icon="trash" data-list-target="needsSelection" disabled label="{{ 'form.delete'|trans({}, domain) }}" />
        {% endblock %}
    {% endembed %}
</div>
