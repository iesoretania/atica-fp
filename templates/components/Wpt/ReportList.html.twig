{% trans_default_domain 'wpt_shift' %}
<div {{ attributes.defaults({
    'data-controller': 'live-history list',
    'data-live-history-base-url-value': this.baseUrl,
}) }}>
    {% embed 'ui/live_list.html.twig' with {pager: this.pager, domain: 'wpt_shift', base_url: this.baseUrl, back_url: this.backUrl, route_name: this.routeName} %}
        {% import 'ui/macros.html.twig' as m %}
        {% block new_action %}{% endblock %}

        {% block table_header %}
            <th>{{ 'header.name'|trans({}, domain) }}</th>
            <th>{{ 'header.grade'|trans({}, domain) }}</th>
            <th>{{ 'header.agreements'|trans({}, domain) }}</th>
        {% endblock %}

        {% block table_body %}
            {% for item in pager %}
                {% set url = path(route_name, {'shift': item.id}) %}
                <tr class="clickable-row" data-href="{{ url }}" data-target="_blank">
                    <td><a href="{{ url }}" target="_blank" class="font-medium text-gray-900 hover:text-brand-700">{{ item.name }}</a></td>
                    <td>{{ item.subject.grade }}</td>
                    <td>{{ item.agreements|length }}</td>
                </tr>
            {% else %}
                <tr><td colspan="3" class="py-8 text-center text-gray-500">{{ 'table.no_items'|trans({}, domain) }}</td></tr>
            {% endfor %}
        {% endblock %}

        {% block after_table %}
            {{ m.link_button(back_url, 'arrow-left', 'btn-info', 'form.back'|trans({}, domain)) }}
        {% endblock %}
    {% endembed %}
</div>
