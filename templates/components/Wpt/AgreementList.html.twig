{% trans_default_domain 'wpt_agreement' %}
{#- Listado dinámico de acuerdos (Live Component). Raíz: «live-history» guarda q y page en la URL (con «Atrás» del navegador) y «list» gestiona filas, selección y botones. -#}
<div {{ attributes.defaults({
    'data-controller': 'live-history list',
    'data-live-history-base-url-value': this.baseUrl,
}) }}>
    {% embed 'ui/live_list.html.twig' with {pager: this.pager, domain: 'wpt_agreement', base_url: this.baseUrl, back_url: this.backUrl} %}
        {% import 'ui/macros.html.twig' as m %}
        {% block path_new %}{{ path('workplace_training_agreement_new', {'shift': this.shift.id}) }}{% endblock %}
        {#- Los bloques de un embed no heredan trans_default_domain: se indica el dominio en cada traducción -#}
        {% block table_header %}
            {% import 'ui/live_macros.html.twig' as lm %}
            <th aria-sort="{{ this.sort == 'workcenter' ? (this.dir == 'desc' ? 'descending' : 'ascending') : 'none' }}">
                <div class="flex items-center gap-2">
                    <input type="checkbox" data-list-target="selectAll" class="size-4 rounded border-gray-300 text-brand-600" aria-label="{{ 'selection.clear'|trans({}, 'general') }}">
                    {{ lm.sort_button('header.workcenter'|trans({}, domain), 'workcenter', this.sort, this.dir) }}
                </div>
            </th>
            {{ lm.sort_th('header.dates'|trans({}, domain), 'dates', this.sort, this.dir) }}
            <th>{{ 'header.student_enrollments'|trans({}, domain) }}</th>
            <th>{{ 'header.educational_tutor'|trans({}, domain) }}</th>
            <th>{{ 'header.work_tutor'|trans({}, domain) }}</th>
            <th></th>
        {% endblock %}
        {% block table_body %}
            {% import 'wpt/agreement/_rows.html.twig' as rows %}
            {{ rows.draw_all(pager) }}
        {% endblock %}
        {% block form_action %}{{ path('workplace_training_agreement_operation', {'shift': this.shift.id}) }}{% endblock %}
        {% block after_table %}
            {{ m.link_button(back_url, 'arrow-left', 'btn-info', 'form.back'|trans({}, domain)) }}
        {% endblock %}
        {#- Acciones sobre las filas marcadas: aparecen en una barra al seleccionar -#}
        {% block selection_actions %}
            {{ m.submit_button('delete', 'trash', 'btn-danger enable-on-items', 'form.delete'|trans({}, domain), true) }}
            {{ m.submit_button('copy', 'copy', 'btn-primary enable-on-items', 'form.calendar_copy'|trans({}, domain), true) }}
        {% endblock %}
    {% endembed %}
</div>
