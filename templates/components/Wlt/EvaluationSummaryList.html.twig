{% trans_default_domain 'wlt_agreement_activity_realization' %}
<div {{ attributes.defaults({
    'data-controller': 'live-history list',
    'data-live-history-base-url-value': this.baseUrl,
}) }}>
    {% embed 'ui/live_list.html.twig' with {pager: this.pager, domain: 'wlt_agreement_activity_realization', base_url: this.baseUrl, back_url: this.backUrl, academic_year: this.academicYear} %}
        {% import 'ui/macros.html.twig' as m %}
        {% block new_action %}{% endblock %}

        {% block table_header %}
            {% import 'ui/live_macros.html.twig' as lm %}
            <th aria-sort="{{ this.sort == 'student' ? (this.dir == 'desc' ? 'descending' : 'ascending') : 'none' }}">{{ lm.sort_button('header.student_enrollment'|trans({}, domain), 'student', this.sort, this.dir) }}</th>
            <th aria-sort="{{ this.sort == 'group' ? (this.dir == 'desc' ? 'descending' : 'ascending') : 'none' }}">{{ lm.sort_button('header.training'|trans({}, domain), 'group', this.sort, this.dir) }}</th>
            <th>{{ 'header.agreement_count'|trans({}, domain) }}</th>
            <th>{{ 'header.completed_activity_realization_count'|trans({}, domain) }}</th>
        {% endblock %}

        {% block table_body %}
            {% for item in pager %}
                {% set url = path('work_linked_training_evaluation_summary_report', {'id': item[0].id}) %}
                <tr class="clickable-row" data-href="{{ url }}" data-target="_blank">
                    <td><a href="{{ url }}" target="_blank" class="font-medium text-gray-900 hover:text-brand-700">{{ item[0] }}</a></td>
                    <td>{{ item[0].group.grade.training }}</td>
                    <td>{{ item[1] }}</td>
                    <td>
                        {% if item[2] %}
                            {{ item[3] }}/{{ item[2] }} ({{ (item[3]*100/item[2])|number_format(2, 'format.decimal_separator'|trans({}, 'general'), 'format.thousand_separator'|trans({}, 'general')) }} %)
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="4" class="py-8 text-center text-gray-500">{{ 'table.no_items'|trans({}, domain) }}</td></tr>
            {% endfor %}
        {% endblock %}

        {% block after_table %}
            {{ m.link_button(back_url, 'arrow-left', 'btn-info', 'form.back'|trans({}, domain)) }}
        {% endblock %}
    {% endembed %}
</div>
