{% trans_default_domain 'wlt_activity_realization' %}
<div {{ attributes.defaults({
    'data-controller': 'live-history list',
    'data-live-history-base-url-value': this.baseUrl,
}) }}>
    {% embed 'ui/live_list.html.twig' with {pager: this.pager, domain: 'wlt_activity_realization', base_url: this.baseUrl, back_url: this.backUrl, activity: this.activity, read_only: this.readOnly} %}
        {% import 'ui/macros.html.twig' as m %}
        {% block path_new %}{{ path('work_linked_training_project_activity_realization_new', {'id': activity.id}) }}{% endblock %}

        {% block table_header %}
            {% import 'ui/live_macros.html.twig' as lm %}
            <th aria-sort="{{ this.sort == 'code' ? (this.dir == 'desc' ? 'descending' : 'ascending') : 'none' }}">
                <div class="flex items-center gap-2">
                    {% if not read_only %}<input type="checkbox" data-list-target="selectAll" class="size-4 rounded border-gray-300 text-brand-600" aria-label="{{ 'selection.clear'|trans({}, 'general') }}">{% endif %}
                    {{ lm.sort_button('header.code'|trans({}, domain), 'code', this.sort, this.dir) }}
                </div>
            </th>
            <th>{{ 'header.description'|trans({}, domain) }}</th>
            <th>{{ 'header.learning_outcomes'|trans({}, domain) }}</th>
        {% endblock %}

        {% block table_body %}
            {% for activity_realization in pager %}
                {% set url = path('work_linked_training_project_activity_realization_edit', {'id': activity_realization.id}) %}
                <tr>
                    <td class="align-top">
                        <label class="flex items-center gap-2">
                            {% if not read_only %}<input type="checkbox" name="items[]" value="{{ activity_realization.id }}" class="selectable size-4 rounded border-gray-300 text-brand-600">{% endif %}
                            <a href="{{ url }}" class="font-medium text-gray-900 hover:text-brand-700">{{ activity_realization.code }}</a>
                        </label>
                    </td>
                    <td class="align-top">{{ activity_realization.description|nl2br }}</td>
                    <td class="align-top">
                        <ul class="list-disc space-y-1 pl-4">
                            {% for subject, learning_outcomes in activity_realization.subjectLearningOutcomes %}
                                <li><i>{{ subject }}: </i>{% for learning_outcome in learning_outcomes %}{{ learning_outcome.code }}{% if not loop.last %}, {% endif %}{% endfor %}</li>
                            {% endfor %}
                        </ul>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="3" class="py-8 text-center text-gray-500">{{ 'table.no_items'|trans({}, domain) }}</td></tr>
            {% endfor %}
        {% endblock %}

        {% block form_action %}{% if not read_only %}{{ path('work_linked_training_project_activity_realization_delete', {'id': activity.id}) }}{% endif %}{% endblock %}

        {% block after_table %}
            {{ m.link_button(back_url, 'arrow-left', 'btn-info', 'form.back'|trans({}, domain)) }}
        {% endblock %}
        {% block selection_actions %}
            {% if not read_only %}{{ m.submit_button('delete', 'trash', 'btn-danger enable-on-items', 'form.delete'|trans({}, domain), true) }}{% endif %}
        {% endblock %}
    {% endembed %}
</div>
