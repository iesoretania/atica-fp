{% trans_default_domain 'wlt_survey' %}
<div {{ attributes.defaults({
    'data-controller': 'live-history list',
    'data-live-history-base-url-value': this.baseUrl,
}) }}>
    {% embed 'ui/live_list.html.twig' with {pager: this.pager, domain: 'wlt_survey', base_url: this.baseUrl, back_url: this.backUrl} %}
        {% import 'ui/macros.html.twig' as m %}
        {% block new_action %}{% endblock %}

        {% block table_header %}
            <th>{{ 'header.educational_tutor'|trans({}, domain) }}</th>
            <th>{{ 'header.project'|trans({}, domain) }}</th>
            <th>{{ 'header.academic_year'|trans({}, domain) }}</th>
            <th>{{ 'header.status'|trans({}, domain) }}</th>
        {% endblock %}

        {% block table_body %}
            {% for item in pager %}
                {% set url = path('work_linked_training_survey_educational_tutor_form', {'id': item.projectId, 'teacher': item.teacherId}) %}
                <tr class="clickable-row" data-href="{{ url }}">
                    <td><a href="{{ url }}" class="font-medium text-gray-900 hover:text-brand-700">{{ item.lastName }}, {{ item.firstName }}</a></td>
                    <td>
                        {{ item.projectName }}
                        {% if item.projectLocked %}<twig:Ui:Icon name="lock" class="ml-1 inline size-3.5 text-gray-400" />{% endif %}
                    </td>
                    <td>{{ item.academicYearDescription }}</td>
                    <td>{{ (item[1] ? 'table.answered.yes' : 'table.answered.no')|trans({}, domain) }}</td>
                </tr>
            {% else %}
                <tr><td colspan="4" class="py-8 text-center text-gray-500">{{ 'table.no_items'|trans({}, domain) }}</td></tr>
            {% endfor %}
        {% endblock %}

        {% block after_table %}
            {{ m.link_button(back_url, 'arrow-left', 'btn-info', 'form.back'|trans({}, domain)) }}
        {% endblock %}
    {% endembed %}
</div>
