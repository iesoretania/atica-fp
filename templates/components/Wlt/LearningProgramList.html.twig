{% trans_default_domain 'wlt_learning_program' %}
<div {{ attributes.defaults({
    'data-controller': 'live-history list',
    'data-live-history-base-url-value': this.baseUrl,
}) }}>
    {% embed 'ui/live_list.html.twig' with {pager: this.pager, domain: 'wlt_learning_program', base_url: this.baseUrl, back_url: this.backUrl, project: this.project, read_only: this.readOnly} %}
        {% import 'ui/macros.html.twig' as m %}
        {% block path_new %}{{ path('work_linked_training_learning_program_new', {'project': project.id}) }}{% endblock %}

        {% block table_header %}
            {% import 'ui/live_macros.html.twig' as lm %}
            <th aria-sort="{{ this.sort == 'company' ? (this.dir == 'desc' ? 'descending' : 'ascending') : 'none' }}">
                <div class="flex items-center gap-2">
                    {% if not read_only %}<input type="checkbox" data-list-target="selectAll" class="size-4 rounded border-gray-300 text-brand-600" aria-label="{{ 'selection.clear'|trans({}, 'general') }}">{% endif %}
                    {{ lm.sort_button('header.company'|trans({}, domain), 'company', this.sort, this.dir) }}
                </div>
            </th>
            <th aria-sort="{{ this.sort == 'items' ? (this.dir == 'desc' ? 'descending' : 'ascending') : 'none' }}">{{ lm.sort_button('header.items'|trans({}, domain), 'items', this.sort, this.dir) }}</th>
        {% endblock %}

        {% block table_body %}
            {% for item in pager %}
                {% set url = path('work_linked_training_learning_program_edit', {'id': item.id}) %}
                <tr>
                    <td class="align-top">
                        <label class="flex items-center gap-2">
                            {% if not read_only %}<input type="checkbox" name="items[]" value="{{ item.id }}" class="selectable size-4 rounded border-gray-300 text-brand-600">{% endif %}
                            <a href="{{ url }}" class="font-medium text-gray-900 hover:text-brand-700">{{ item.company }}</a>
                        </label>
                    </td>
                    <td class="align-top">{{ item.activityRealizations.count() }}</td>
                </tr>
            {% else %}
                <tr><td colspan="2" class="py-8 text-center text-gray-500">{{ 'table.no_items'|trans({}, domain) }}</td></tr>
            {% endfor %}
        {% endblock %}

        {% block form_action %}{% if not read_only %}{{ path('work_linked_training_learning_program_operation', {'project': project.id}) }}{% endif %}{% endblock %}

        {% block after_table %}
            {{ m.link_button(back_url, 'arrow-left', 'btn-info', 'form.back'|trans({}, domain)) }}
        {% endblock %}
        {% block selection_actions %}
            {% if not read_only %}{{ m.submit_button('delete', 'trash', 'btn-danger enable-on-items', 'form.delete'|trans({}, domain), true) }}{% endif %}
        {% endblock %}
    {% endembed %}
</div>
