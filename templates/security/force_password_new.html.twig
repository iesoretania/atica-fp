{% trans_default_domain 'user' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}
{% import 'ui/form_layout.html.twig' as fl %}
{% form_theme form 'ui/form_theme.html.twig' %}

{% block content %}
    <twig:Ui:Alert type="info" :message="'prompt.forced_password_change'|trans|nl2br" />
    {{ form_start(form) }}
    {{ fl.grid(form, [
        ['currentPassword'],
        ['newPassword'],
    ], {}, 'card.password_title'|trans) }}
    {{ m.start_button() }}
        {{ m.submit_button('submit', 'check', 'btn-success', 'form.save'|trans) }}
        {{ m.link_button(path('logout'), 'power-off', 'btn-primary', 'form.disconnect'|trans) }}
    {{ m.end_button() }}
    {{ form_end(form) }}
{% endblock %}
