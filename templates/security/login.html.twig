{% trans_default_domain "security" %}
{% extends 'security/login_base.html.twig' %}
{% import 'security/login_macros.html.twig' as lm %}

{% block login_title %}{{ 'form.login.title'|trans }}{% endblock %}
{% block login_heading %}{{ 'form.login.title'|trans }}{% endblock %}
{% block login_subtitle %}<p class="mt-1 text-gray-500">{{ 'form.login.subtitle'|trans }}</p>{% endblock %}

{% block login_action %}{{ path('login_check') }}{% endblock %}

{% block login_content %}
<form method="post" action="{{ path('login_check') }}" class="space-y-5">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
    <div>
        <label for="email" class="mb-1.5 block text-sm font-medium text-gray-700">{{ 'form.login.username_email'|trans }}</label>
        <div class="relative">
            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400"><twig:Ui:Icon name="user" class="size-4" /></span>
            <input type="text" name="_username" id="email" required class="{{ lm.input_class() }} pl-10" tabindex="1"
                   autocorrect="off" autocapitalize="none" autocomplete="username" value="{{ last_username|default('') }}"
                   {% if not last_username %}autofocus {% endif %}>
        </div>
    </div>
    <div data-controller="password-visibility" class="relative">
        <label for="password" class="mb-1.5 block text-sm font-medium text-gray-700">{{ 'form.login.password'|trans }}</label>
        <div class="relative">
            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400"><twig:Ui:Icon name="lock" class="size-4" /></span>
            <input type="password" name="_password" id="password" required class="{{ lm.input_class() }} pl-10 pr-11" tabindex="2" autocomplete="current-password"
                   data-password-visibility-target="input" {% if last_username %}autofocus {% endif %}>
            <button type="button" tabindex="3" data-action="password-visibility#toggle" aria-pressed="false" aria-controls="password"
                    aria-label="{{ 'form.login.password.toggle'|trans }}" title="{{ 'form.login.password.toggle'|trans }}"
                    class="absolute inset-y-0 right-0 flex items-center pr-3.5 text-gray-400 transition-colors hover:text-gray-600">
                <span data-password-visibility-target="eyeOpen"><twig:Ui:Icon name="eye" class="size-4" /></span>
                <span data-password-visibility-target="eyeClosed" class="hidden"><twig:Ui:Icon name="eye-slash" class="size-4" /></span>
            </button>
        </div>
        {#- El enlace va después del campo en el DOM (y arriba a la derecha con CSS) para que Tab pase del usuario a la contraseña -#}
        <a href="{{ path('login_password_reset') }}" tabindex="5" class="absolute right-0 top-0 text-xs font-medium text-brand-700 hover:underline">{{ 'form.login.password.reset'|trans }}</a>
    </div>
    {{ lm.submit('form.login.submit'|trans, 4) }}
</form>
{% endblock %}
