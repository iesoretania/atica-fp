{% trans_default_domain "security" %}
{% form_theme form 'ui/form_theme.html.twig' %}
{% extends 'security/login_base.html.twig' %}
{% import 'security/login_macros.html.twig' as lm %}

{% block title 'form.reset.title'|trans %}

{% block login_title %}{{ 'form.reset.title'|trans }}{% endblock %}
{% block login_heading %}{{ 'form.reset.title'|trans }}{% endblock %}

{% block login_content %}
    {{ form_start(form, {attr: {class: 'space-y-4'}}) }}
    {{ form_row(form.email) }}
    {{ lm.submit('form.reset.submit'|trans, 2) }}
    {{ lm.link(path('login'), 'form.reset.back'|trans, 3) }}
    {{ form_end(form) }}
{% endblock %}
