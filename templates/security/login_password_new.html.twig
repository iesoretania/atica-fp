{% trans_default_domain "security" %}
{% form_theme form 'ui/form_theme.html.twig' %}
{% extends 'security/login_base.html.twig' %}
{% import 'security/login_macros.html.twig' as lm %}

{% block title 'form.reset.title'|trans %}

{% block login_title %}{{ 'form.reset.title'|trans }} - {{ user.emailAddress }}{% endblock %}
{% block login_heading %}{{ 'form.reset.title'|trans }} - {{ user.emailAddress }}{% endblock %}

{% block login_action %}{% endblock %}

{% block login_content %}
    {{ form_start(form, {attr: {class: 'space-y-4'}}) }}
    {{ form_row(form.newPassword) }}
    {{ lm.submit('form.reset.submit_set'|trans) }}
    {{ lm.link(path('logout'), 'form.reset.back'|trans) }}
    {{ form_end(form) }}
{% endblock %}
