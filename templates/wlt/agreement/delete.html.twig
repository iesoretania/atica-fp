{% extends 'ui/delete.html.twig' %}
{% set domain = 'wlt_agreement' %}
{% trans_default_domain 'wlt_agreement' %}

{% block delete_header %}
    <th>{{ 'header.student_enrollment'|trans }}</th>
    <th>{{ 'header.workcenter'|trans }}</th>
    <th>{{ 'header.work_tutor'|trans }}</th>
    <th>{{ 'header.educational_tutor'|trans }}</th>
    <th>{{ 'header.dates'|trans }}</th>
{% endblock %}

{% block delete_rows %}
    {% for item in items %}
        <tr>
            <td>{{ item.studentEnrollment }}</td>
            <td>{{ item.workcenter }}</td>
            <td>{{ item.workTutor }}</td>
            <td>{{ item.educationalTutor }}</td>
            <td class="whitespace-nowrap">
                {{ item.startDate ? item.startDate|date('format.date'|trans({}, 'general')) }}
                {% if item.endDate %} - {{ item.endDate|date('format.date'|trans({}, 'general')) }}{% endif %}
            </td>
        </tr>
    {% endfor %}
{% endblock %}
