{% trans_default_domain 'wlt_agreement' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}
{% import 'ui/form_layout.html.twig' as fl %}
{% form_theme form 'ui/form_theme.html.twig' %}

{% block content %}
    {% set ajax_url = path('work_linked_training_agreement_new', {'project': agreement.project.id}) %}
    {# Al elegir el estudiante se recalculan empresa, centro, concreciones y tutor docente; al cambiar la empresa, el centro (selecciona el primero) y las concreciones #}
    {{ form_start(form, {'attr': {
        'data-ajax': ajax_url,
        'data-controller': 'dependent-fields',
        'data-dependent-fields-url-value': ajax_url,
        'data-dependent-fields-rules-value': ([
            {
                on: ['#agreement_studentEnrollment'],
                send: ['#agreement_studentEnrollment', '#agreement_company', '#agreement_workcenter', '#agreement_workTutor'],
                replace: ['#agreement_company', '#agreement_workcenter', '#agreement_activityRealizations', '#agreement_educationalTutor'],
            },
            {
                on: ['#agreement_company'],
                send: ['#agreement_studentEnrollment', '#agreement_company', '#agreement_workcenter', '#agreement_workTutor'],
                replace: ['#agreement_workcenter', '#agreement_activityRealizations'],
                selectFirst: '#agreement_workcenter',
            },
        ])|json_encode,
    }}) }}
    {{ fl.grid(form, [
        ['studentEnrollment', 'internalCode'],
        ['company', 'workcenter'],
        ['workTutor', 'additionalWorkTutor'],
        ['educationalTutor', 'additionalEducationalTutor'],
        ['startDate', 'endDate'],
        ['defaultStartTime1', 'defaultEndTime1', 'defaultStartTime2', 'defaultEndTime2'],
        ['activityRealizations'],
    ], {}, 'card.title'|trans) }}
    {{ m.start_button() }}
        {% if not read_only %}{{ m.submit_button('submit', 'check', 'btn-success', 'form.save'|trans) }}{% endif %}
        {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
    {{ m.end_button() }}
    {{ form_end(form) }}
    {% if agreement.id and not read_only %}
        {{ fl.danger_zone('danger.title'|trans, 'danger.text'|trans, path('work_linked_training_agreement_operation', {'project': agreement.project.id}), agreement.id) }}
    {% endif %}

    {% include 'ui/new_person_modal.html.twig' %}
{% endblock %}
