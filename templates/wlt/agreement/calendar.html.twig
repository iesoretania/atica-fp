{% trans_default_domain 'calendar' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}

{% block content %}
    <div data-controller="list">
        <form action="{{ path('work_linked_training_agreement_calendar_delete', {'id': agreement.id}) }}" method="post">
            {% embed 'ui/calendar.html.twig' with {hours_divisor: 1} %}
                {% block day %}
                    {% if day %}
                        {% set url = path('work_linked_training_agreement_calendar_form', {'id': day.id}) %}
                        <td class="bg-brand-50 text-brand-900">
                            <label class="flex items-center gap-1">
                                {% if not read_only %}<input type="checkbox" name="items[]" value="{{ day.id }}" class="selectable size-3.5 rounded border-gray-300 text-brand-600">{% endif %}
                                <a href="{{ url }}" class="text-sm font-bold hover:underline">{{ day.date|date('d') }}</a>
                            </label>
                            <div class="mt-1">{{ 'caption.hours'|trans({'count': day.hours}, 'calendar') }}</div>
                        </td>
                    {% else %}
                        <td class="text-gray-400">{% if n > 0 %}{{ n }}{% endif %}</td>
                    {% endif %}
                {% endblock %}
            {% endembed %}

            <div class="mt-6 flex flex-wrap gap-2">
                {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
                {% if not read_only %}
                    {{ m.link_button(path('work_linked_training_agreement_calendar_add', {'id': agreement.id}), 'calendar-plus', 'btn-success', 'form.add'|trans) }}
                    <twig:Ui:Button type="button" variant="secondary" icon="check-square" data-action="list#toggle" :label="'form.select_deselect'|trans" />
                    {{ m.submit_button('delete', 'trash', 'btn-danger enable-on-items', 'form.delete'|trans, true) }}
                {% endif %}
            </div>
        </form>
    </div>
{% endblock %}
