{% trans_default_domain 'wlt_learning_program' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}
{% import 'ui/form_layout.html.twig' as fl %}
{% form_theme form 'ui/form_theme.html.twig' %}

{% block content %}
    {{ form_start(form) }}
    {{ fl.grid(form, [
        ['company'],
        ['activityRealizations'],
    ], {}, 'card.title'|trans) }}
    {{ m.start_button() }}
        {% if not read_only|default(false) %}{{ m.submit_button('submit', 'check', 'btn-success', 'form.save'|trans) }}{% endif %}
        {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
    {{ m.end_button() }}
    {{ form_end(form) }}

    {% if learning_program.id and not read_only|default(false) %}
        {{ fl.danger_zone('danger.title'|trans, 'danger.text'|trans, path('work_linked_training_learning_program_operation', {'project': learning_program.project.id}), learning_program.id) }}
    {% endif %}
{% endblock %}
