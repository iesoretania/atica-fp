{% extends 'ui/delete.html.twig' %}
{% set domain = 'wlt_learning_program' %}
{% trans_default_domain 'wlt_learning_program' %}

{% block delete_header %}
    <th>{{ 'header.company'|trans }}</th>
    <th>{{ 'header.project'|trans }}</th>
{% endblock %}

{% block delete_rows %}
    {% for item in items %}
        <tr>
            <td>{{ item.company }}</td>
            <td>{{ item.project }}</td>
        </tr>
    {% endfor %}
{% endblock %}
