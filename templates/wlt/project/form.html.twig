{% trans_default_domain 'wlt_project' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}
{% import 'ui/form_layout.html.twig' as fl %}
{% form_theme form 'ui/form_theme.html.twig' %}

{% block content %}
    {{ form_start(form) }}
    {{ fl.grid(form, [
        ['name', 'manager'],
        ['groups'],
        ['locked'],
        ['performanceScale'],
        ['attendanceReportTemplate', 'weeklyActivityReportTemplate'],
        ['studentSurvey', 'companySurvey', 'educationalTutorSurvey'],
    ], {}, 'card.title'|trans) }}
    {{ m.start_button() }}
        {% if not read_only|default(false) %}{{ m.submit_button('submit', 'check', 'btn-success', 'form.save'|trans) }}{% endif %}
        {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
    {{ m.end_button() }}
    {{ form_end(form) }}

    {% if project.id and not read_only|default(false) %}
        {{ fl.danger_zone('danger.title'|trans, 'danger.text'|trans, path('work_linked_training_project_operation'), project.id) }}
    {% endif %}
{% endblock %}
