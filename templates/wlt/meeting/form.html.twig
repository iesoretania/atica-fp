{% trans_default_domain 'wlt_meeting' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/form_layout.html.twig' as fl %}

{#- Los campos que dependen de otros (autor → proyecto → alumnado y docentes) los recalcula el Live Component Wlt:MeetingForm -#}
{% block content %}
    <twig:Wlt:MeetingForm :meetingEntity="meeting.id ? meeting : null" :teacher="meeting.id ? null : meeting.createdBy" :form="form" :backUrl="path('work_linked_training_meeting_list', {'academicYear': academic_year.id})" />
    {% if meeting.id and not read_only %}
        {{ fl.danger_zone('danger.title'|trans, 'danger.text'|trans, path('work_linked_training_meeting_operation'), meeting.id) }}
    {% endif %}
{% endblock %}
