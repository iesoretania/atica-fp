{% extends 'ui/delete.html.twig' %}
{% set domain = 'wlt_meeting' %}
{% trans_default_domain 'wlt_meeting' %}

{% block delete_header %}
    <th>{{ 'header.datetime'|trans }}</th>
    <th>{{ 'header.created_by'|trans }}</th>
    <th>{{ 'header.student_enrollments'|trans }}</th>
    <th>{{ 'header.teachers'|trans }}</th>
{% endblock %}

{% block delete_rows %}
    {% for item in items %}
        <tr>
            <td class="whitespace-nowrap">{{ item.dateTime|date('format.datetime'|trans({}, 'general')) }}</td>
            <td>{{ item.createdBy }}</td>
            <td>{{ item.studentEnrollments|join(', ') }}</td>
            <td>{{ item.teachers|join(', ') }}</td>
        </tr>
    {% endfor %}
{% endblock %}
