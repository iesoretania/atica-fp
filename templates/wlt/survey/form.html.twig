{% trans_default_domain 'wlt_survey' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}
{% form_theme form 'ui/form_theme.html.twig' %}

{% block content %}
    {% if survey %}
        {{ form_start(form) }}
        {% if read_only %}
            <twig:Ui:Alert type="warning" :message="'prompt.read_only_warning'|trans" />
        {% endif %}
        <div class="mb-4 overflow-hidden rounded-xl bg-white shadow-xs ring-1 ring-gray-200">
            <div class="border-b border-gray-200 bg-gray-50 px-5 py-4">
                {% if project is defined %}
                    <h2 class="text-lg font-semibold text-gray-900">{{ project }}</h2>
                {% endif %}
                {% if person is defined %}
                    <h2 class="text-lg font-semibold text-gray-900">{{ person }}</h2>
                {% endif %}
                {% if survey.startTimestamp or survey.endTimestamp %}
                    <p class="mt-1 text-sm text-gray-500">
                        {{ 'title.available'|trans }}
                        {% if survey.startTimestamp %}
                            {{ 'title.start_timestamp'|trans({'date': survey.startTimestamp|date('format.datetime'|trans({}, 'general'))}) }}
                        {% endif %}
                        {% if survey.endTimestamp %}
                            {{ 'title.end_timestamp'|trans({'date': survey.endTimestamp|date('format.datetime'|trans({}, 'general'))}) }}
                        {% endif %}
                    </p>
                {% endif %}
            </div>
            {{ form_label(form.answers) }}
            {{ form_errors(form.answers) }}

            <div class="p-5">
                {% set table = false %}
                {% for answer in form.answers %}
                    {% if answer.vars.data.surveyQuestion.type == 'fixed' %}
                        {% if table %}
                            </tbody></table></div>
                            {% set table = false %}
                        {% endif %}
                        <div class="prose prose-sm my-4 max-w-none">{{ answer.vars.data.surveyQuestion.description|sanitize_html }}</div>
                    {% else %}
                        {% if not table %}
                            <div class="my-3 overflow-x-auto rounded-lg ring-1 ring-gray-200">
                            <table class="w-full text-left text-sm survey">
                            <tbody class="divide-y divide-gray-100 [&_td]:px-4 [&_td]:py-3 [&_td]:align-top">
                            {% set table = true %}
                        {% endif %}
                        <tr>
                            <td class="w-1/2 question{% if answer.vars.data.surveyQuestion.mandatory %} required font-medium{% endif %}">{{ answer.vars.data.surveyQuestion.description|sanitize_html }}</td>
                            <td class="w-1/2 response">
                                {{ form_errors(answer) }}
                                {{ form_widget(answer) }}
                            </td>
                        </tr>
                    {% endif %}
                {% endfor %}
                {% if table %}
                    </tbody></table></div>
                {% endif %}
            </div>
        </div>
        <div class="flex flex-wrap gap-2">
            {% if not read_only %}{{ m.submit_button('submit', 'check', 'btn-success', 'form.save'|trans) }}{% endif %}
            {{ m.link_button(back_url|default(last_url), 'arrow-left', 'btn-info', 'form.back'|trans) }}
        </div>
        {{ form_end(form) }}
    {% else %}
        <twig:Ui:Alert type="danger" :message="'prompt.no_survey'|trans" />
        {{ m.link_button(back_url|default(last_url), 'arrow-left', 'btn-info', 'form.back'|trans) }}
    {% endif %}
{% endblock %}
