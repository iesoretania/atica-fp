{% trans_default_domain 'calendar' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}
{% import 'ui/form_layout.html.twig' as fl %}
{% form_theme form 'ui/form_theme.html.twig' %}

{% block content %}
    {% if read_only %}
        <twig:Ui:Alert type="warning" :message="'prompt.read_only_warning'|trans" />
    {% elseif work_day.locked %}
        <twig:Ui:Alert type="warning" :message="'prompt.locked_warning'|trans" />
    {% endif %}
    {{ form_start(form) }}
    {{ fl.grid(form, [
        ['activityRealizations'],
        ['absence'],
        ['locked'],
        ['startTime1', 'endTime1', 'startTime2', 'endTime2'],
        ['otherActivities'],
        ['notes'],
    ], {activityRealizations: {label: false}, otherActivities: {attr: {rows: 3}}, notes: {attr: {rows: 3}}}, 'card.title.tracking'|trans) }}
    {{ m.start_button() }}
        {% if not read_only %}{{ m.submit_button('submit', 'check', 'btn-success', 'form.save'|trans) }}{% endif %}
        {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
        {% if previous_work_day %}
            {{ m.link_button(path('work_linked_training_tracking_calendar_form', {'id': previous_work_day.id}), 'angle-left', 'btn-info', 'form.previous_work_day'|trans) }}
        {% endif %}
        {% if next_work_day %}
            {{ m.link_button(path('work_linked_training_tracking_calendar_form', {'id': next_work_day.id}), 'angle-right', 'btn-info', 'form.next_work_day'|trans) }}
        {% endif %}
    {{ m.end_button() }}
    {{ form_end(form) }}
{% endblock %}

{# Flechas para pasar al día anterior o siguiente junto al título #}
{% block content_title %}
    <span class="inline-flex items-center gap-3">
        {% if previous_work_day %}
            <a href="{{ path('work_linked_training_tracking_calendar_form', {'id': previous_work_day.id}) }}" title="{{ 'form.previous_work_day'|trans }}"
               class="rounded-lg p-2 text-gray-500 ring-1 ring-inset ring-gray-300 hover:bg-gray-50"><twig:Ui:Icon name="angle-left" /></a>
        {% endif %}
        {{ parent() }}
        {% if next_work_day %}
            <a href="{{ path('work_linked_training_tracking_calendar_form', {'id': next_work_day.id}) }}" title="{{ 'form.next_work_day'|trans }}"
               class="rounded-lg p-2 text-gray-500 ring-1 ring-inset ring-gray-300 hover:bg-gray-50"><twig:Ui:Icon name="angle-right" /></a>
        {% endif %}
    </span>
{% endblock %}
