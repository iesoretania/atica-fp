{% extends 'ui/delete.html.twig' %}
{% set domain = 'wlt_contact' %}
{% trans_default_domain 'wlt_contact' %}

{% block delete_header %}
    <th>{{ 'header.datetime'|trans }}</th>
    <th>{{ 'header.teacher'|trans }}</th>
    <th>{{ 'header.workcenter'|trans }}</th>
{% endblock %}

{% block delete_rows %}
    {% for item in items %}
        <tr>
            <td class="whitespace-nowrap">{{ item.dateTime|date('format.datetime'|trans({}, 'general')) }}</td>
            <td>{{ item.teacher }}</td>
            <td>{{ item.workcenter }}</td>
        </tr>
    {% endfor %}
{% endblock %}
