{% trans_default_domain 'wlt_contact' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/form_layout.html.twig' as fl %}

{#- Los campos que dependen de otros (fecha y centro → proyectos → alumnado) los recalcula el Live Component Wlt:ContactForm -#}
{% block content %}
    <twig:Wlt:ContactForm :contactEntity="contact.id ? contact : null" :teacher="contact.id ? null : contact.teacher" :form="form" :backUrl="path('work_linked_training_contact_list', {'academicYear': academic_year.id})" />
    {% if contact.id and not read_only %}
        {{ fl.danger_zone('danger.title'|trans, 'danger.text'|trans, path('work_linked_training_contact_operation'), contact.id) }}
    {% endif %}
{% endblock %}
