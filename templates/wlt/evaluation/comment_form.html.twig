{% trans_default_domain 'wlt_agreement_activity_realization' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}
{% form_theme form 'ui/form_theme.html.twig' %}

{% block content %}
    <p class="text-lg font-semibold text-gray-900">
        {{ agreement }}
        {{ agreement.startDate ? ' - ' ~ agreement.startDate|date('format.date'|trans({}, 'general')) }}
        {{ agreement.endDate ? ' - ' ~ agreement.endDate|date('format.date'|trans({}, 'general')) }}
    </p>
    <p class="mb-4 text-sm text-gray-600">{{ agreement_activity_realization.activityRealization }}</p>

    {{ form_start(form) }}
    <div class="max-w-5xl overflow-hidden rounded-xl bg-white shadow-xs ring-1 ring-gray-200">
        <div class="space-y-5 p-5 sm:p-6">
            {{ form_row(form.disabled) }}
            {% if agreement_activity_realization.comments.count() > 0 %}
                <div>
                    <p class="mb-2 text-sm font-medium text-gray-700">{{ 'form.comments'|trans }}</p>
                    <div class="space-y-2">
                        {% for comment in agreement_activity_realization.comments %}
                            <div class="rounded-lg bg-gray-50 ring-1 ring-gray-200">
                                <div class="p-3 text-sm">{{ comment.comment|nl2br }}</div>
                                <div class="flex items-center justify-between border-t border-gray-200 px-3 py-1.5 text-xs font-semibold text-gray-500">
                                    <span>{{ comment.timestamp|date('format.datetime'|trans({}, 'general')) }} - {{ comment.person }}</span>
                                    {% if is_granted('WLT_AGREEMENT_ACTIVITY_REALIZATION_COMMENT_DELETE', comment) %}
                                        <a href="{{ path('work_linked_training_evaluation_comment_delete', {'id': comment.id}) }}" class="text-red-600 hover:text-red-800" aria-label="{{ 'title.delete_comment'|trans }}"><twig:Ui:Icon name="trash" class="size-3.5" /></a>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
            {{ form_rest(form) }}
        </div>
    </div>
    {{ m.start_button() }}
        {% if not read_only %}{{ m.submit_button('submit', 'check', 'btn-success', 'form.save'|trans) }}{% endif %}
        {{ m.link_button(path('work_linked_training_evaluation_form', {'id': agreement.id}), 'arrow-left', 'btn-info', 'form.back'|trans) }}
    {{ m.end_button() }}
    {{ form_end(form) }}
{% endblock %}
