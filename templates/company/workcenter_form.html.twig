{% trans_default_domain 'workcenter' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}
{% import 'ui/form_layout.html.twig' as fl %}
{% form_theme form 'ui/form_theme.html.twig' %}

{% block content %}
    {{ form_start(form) }}
    {{ fl.grid(form, [
        ['name'],
        ['manager'],
        ['emailAddress'],
        ['phoneNumber', 'faxNumber'],
        ['address'],
        ['city', 'zipCode'],
    ], {}, 'card.title'|trans) }}
    {{ m.start_button() }}
        {{ m.submit_button('submit', 'check', 'btn-success', 'form.save'|trans) }}
        {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
    {{ m.end_button() }}
    {{ form_end(form) }}

    {% include 'ui/new_person_modal.html.twig' %}

    {% set entity = form.vars.data %}
    {% if entity.id %}
        {{ fl.danger_zone('danger.title'|trans, 'danger.text'|trans, path('company_workcenter_delete', {'id': entity.company.id}), entity.id) }}
    {% endif %}
{% endblock %}
