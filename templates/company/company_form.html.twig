{% trans_default_domain 'company' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}
{% import 'ui/form_layout.html.twig' as fl %}
{% form_theme form 'ui/form_theme.html.twig' %}

{% block content %}
    {{ form_start(form) }}
    {{ fl.grid(form, [
        ['code:1', 'name:3'],
        ['manager'],
        ['emailAddress', 'webSite'],
        ['phoneNumber', 'faxNumber'],
        ['address'],
        ['city', 'zipCode'],
    ], {}, 'card.title'|trans) }}
    {{ m.start_button() }}
        {{ m.submit_button('submit', 'check', 'btn-success', 'form.save'|trans) }}
        {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
        {% if company.id %}{{ m.link_button(path('company_workcenter_list', {'id': company.id}), 'building', 'btn-primary', 'table.workcenters'|trans) }}{% endif %}
    {{ m.end_button() }}
    {{ form_end(form) }}

    {% include 'ui/new_person_modal.html.twig' %}

    {% if company.id %}
        {{ fl.danger_zone('danger.title'|trans, 'danger.text'|trans, path('company_delete'), company.id) }}
    {% endif %}
{% endblock %}
