{#-
  Layout del diseño nuevo (Tailwind + Stimulus). Mantiene los mismos bloques y variables que
  layout.html.twig (title, content_header, content, menu, breadcrumb, last_url...) para que las
  plantillas se puedan migrar cambiando solo el «extends».
-#}
{% trans_default_domain 'layout' %}
{% extends 'base.html.twig' %}

{% block title %}
    {% if title is defined and title is not empty %}{{ title }} - {% endif %}
    {{ user_extension.currentOrganization.name }}
{%- endblock %}

{# Solo puede haber una llamada a importmap() por página: el diseño nuevo carga «app_v2», nunca «app» #}
{% block importmap %}{{ importmap(['app_v2']|merge(js_entries|default([]))) }}{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 text-gray-800 antialiased" data-controller="sidebar" style="font-family: var(--font-sans)">

    {# Fondo oscuro al abrir el menú en móvil #}
    <div class="fixed inset-0 z-30 hidden bg-gray-900/50 lg:hidden" data-sidebar-target="overlay" data-action="click->sidebar#close"></div>

    <aside class="no-print fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full flex-col bg-brand-950 text-brand-100 transition-transform duration-300 ease-in-out lg:translate-x-0"
           data-sidebar-target="panel">
        {# Cabecera: logo y nombre de la aplicación #}
        <a href="{{ path('frontpage') }}" class="flex h-16 shrink-0 items-center gap-3 border-b border-white/10 px-5 transition-colors hover:bg-brand-900">
            {% if app_logo_navbar %}<img src="{{ asset(app_logo_navbar) }}" alt="" class="h-8 w-auto shrink-0">{% endif %}
            <span class="min-w-0">
                <span class="block truncate text-sm font-semibold leading-none text-white">{{ app_name }}</span>
                {% if app_version %}<span class="mt-1 block text-xs text-brand-300">v{{ app_version }}</span>{% endif %}
            </span>
        </a>

        {# Centro educativo actual y cambio de centro #}
        {% set organizations = user_extension.organizations(app.user) %}
        <div class="shrink-0 border-b border-white/10 px-3 py-2">
            {% if organizations|length > 8 %}
                {#- Muchos centros: el nombre lleva a la pantalla de selección -#}
                <a href="{{ path('login_organization') }}" title="{{ 'user.organization'|trans }}" aria-label="{{ 'user.organization'|trans }}"
                   class="flex items-center gap-2 rounded-lg px-2 py-2 transition-colors hover:bg-brand-900">
                    <twig:Ui:Icon name="building" class="size-4 shrink-0 text-brand-300" />
                    <span class="min-w-0 flex-1 truncate text-xs font-medium text-white" title="{{ user_extension.currentOrganization }}">{{ user_extension.currentOrganization }}</span>
                    <twig:Ui:Icon name="chevron-down" class="size-3.5 shrink-0 text-brand-300" />
                </a>
            {% elseif organizations|length > 1 %}
                {#- Pocos centros: el nombre despliega la lista para cambiar de centro -#}
                <details class="group">
                    <summary class="flex cursor-pointer list-none items-center gap-2 rounded-lg px-2 py-2 transition-colors hover:bg-brand-900 [&::-webkit-details-marker]:hidden"
                             title="{{ 'user.organization'|trans }}" aria-label="{{ 'user.organization'|trans }}">
                        <twig:Ui:Icon name="building" class="size-4 shrink-0 text-brand-300" />
                        <span class="min-w-0 flex-1 truncate text-xs font-medium text-white" title="{{ user_extension.currentOrganization }}">{{ user_extension.currentOrganization }}</span>
                        <twig:Ui:Icon name="chevron-down" class="size-3.5 shrink-0 text-brand-300 transition-transform group-open:rotate-180" />
                    </summary>
                    <div class="mt-1 space-y-0.5">
                        {% for organization in organizations %}
                            <a href="{{ path('switch_organization', {'id': organization.id}) }}"
                               class="flex items-center justify-between gap-2 rounded-md px-2 py-1.5 text-xs text-brand-100 hover:bg-brand-900 hover:text-white">
                                <span class="truncate">{{ organization }}</span>
                                {% if organization.id == user_extension.currentOrganization.id %}<twig:Ui:Icon name="check" class="size-3 shrink-0 text-brand-300" />{% endif %}
                            </a>
                        {% endfor %}
                    </div>
                </details>
            {% else %}
                <div class="flex items-center gap-2 px-2 py-2">
                    <twig:Ui:Icon name="building" class="size-4 shrink-0 text-brand-300" />
                    <p class="min-w-0 flex-1 truncate text-xs font-medium text-white" title="{{ user_extension.currentOrganization }}">{{ user_extension.currentOrganization }}</p>
                </div>
            {% endif %}
        </div>

        {# Navegación principal #}
        <nav class="grow space-y-0.5 overflow-y-auto px-3 py-4" aria-label="{{ 'hint.toggle'|trans }}">
            {#- «Datos personales» no va en el menú: ya está en el bloque de la persona, abajo -#}
            {% for item in module_extension.menu.children|filter(item => item.routeName != 'personal_data') %}
                {% set active = item.routeName and app.current_route starts with item.routeName %}
                {#- «Empresas colaboradoras» y «Gestión del centro» van separadas de los módulos -#}
                {% if not loop.first and item.routeName in ['company', 'organization'] %}
                    <div role="separator" class="my-2 border-t border-white/10"></div>
                {% endif %}
                <a href="{{ item.routeName ? path(item.routeName) : '#' }}"
                   title="{{ (item.caption ~ '.detail')|trans({}, item.module ? 'module_' ~ item.module : 'menu') }}"
                   {% if active %}aria-current="page"{% endif %}
                   class="group flex items-center gap-3 rounded-lg border-l-2 px-3 py-2 text-sm font-medium transition-colors duration-150 {{ active ? 'border-brand-300 bg-brand-800 text-white' : 'border-transparent text-brand-100 hover:bg-brand-900 hover:text-white' }}">
                    <twig:Ui:Icon name="{{ item.icon }}" class="size-4 shrink-0 opacity-80" />
                    <span class="truncate">{{ item.caption|trans({}, item.module ? 'module_' ~ item.module : 'menu') }}</span>
                </a>
            {% endfor %}
        </nav>

        {# Persona conectada, perfil y desconexión #}
        {% if app.user %}
            <div class="shrink-0 space-y-3 border-t border-white/10 p-4">
                {% if is_granted('IS_IMPERSONATOR') %}
                    <div class="rounded-lg border border-amber-400/25 bg-amber-500/15 px-3 py-2.5">
                        <p class="mb-2 flex items-center gap-2 text-xs font-medium text-amber-200">
                            <twig:Ui:Icon name="user-secret" class="size-3.5 shrink-0 text-amber-300" />
                            <span class="truncate">{{ 'user.logged.as'|trans({'user': app.user}) }}</span>
                        </p>
                        <a href="{{ path('admin_user_list', {'_switch_user': '_exit'}) }}"
                           class="inline-flex items-center gap-1.5 rounded-md bg-amber-400/20 px-2.5 py-1 text-xs font-medium text-amber-200 transition-colors hover:bg-amber-400/30 hover:text-white">
                            <twig:Ui:Icon name="user-slash" class="size-3.5" />
                            {{ 'user.exit_impersonation'|trans }}
                        </a>
                    </div>
                {% endif %}

                <div class="flex min-w-0 items-center gap-3">
                    <div class="flex size-9 shrink-0 select-none items-center justify-center rounded-full bg-brand-700 text-sm font-semibold text-white" aria-hidden="true">
                        {{ ((app.user.firstName ?? '')|first ?: app.user.userIdentifier|first)|upper }}
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="truncate text-sm font-medium leading-none text-white">{{ app.user }}</p>
                        <p class="mt-1 truncate text-xs text-brand-300">@{{ app.user.userIdentifier }}</p>
                    </div>
                </div>

                <div class="space-y-0.5">
                    <a href="{{ path('personal_data') }}"
                       class="flex items-center gap-2.5 rounded-md px-2 py-2.5 text-xs font-medium transition-colors lg:py-1.5 {{ app.current_route == 'personal_data' ? 'bg-brand-800 text-white' : 'text-brand-100 hover:bg-brand-900 hover:text-white' }}">
                        <twig:Ui:Icon name="user" class="size-4 shrink-0" />
                        {{ 'user.data'|trans }}
                    </a>
                    {% if not is_granted('IS_IMPERSONATOR') %}
                        <a href="{{ path('logout') }}"
                           class="flex items-center gap-2.5 rounded-md px-2 py-2.5 text-xs font-medium text-brand-100 transition-colors hover:bg-red-500/15 hover:text-red-300 lg:py-1.5">
                            <twig:Ui:Icon name="power-off" class="size-4 shrink-0" />
                            {{ 'user.logout'|trans }}
                        </a>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </aside>

    <div class="lg:pl-64">
        {# Cabecera: solo en pantallas pequeñas (en las grandes todo está en la barra lateral) #}
        <header class="no-print sticky top-0 z-20 flex h-14 items-center gap-3 border-b border-gray-200 bg-white px-4 sm:px-6 lg:hidden">
            <button type="button" class="-ml-2 flex size-11 items-center justify-center rounded-lg text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-700" data-action="sidebar#toggle" aria-label="{{ 'hint.toggle'|trans }}">
                <twig:Ui:Icon name="bars" class="size-5" />
            </button>
            <a href="{{ path('frontpage') }}" class="text-sm font-semibold text-brand-900">{{ app_name }}</a>
        </header>

        <main role="main" class="px-4 py-6 sm:px-6">
            <ol class="no-print mb-4 flex flex-wrap items-center gap-x-1.5 gap-y-1 text-sm text-gray-500">
                {#- «last_url» (URL del último enlace de las migas) la usan las plantillas hijas para el botón «Volver» -#}
                {% set last_url = '' %}
                {% set crumbs = [] %}
                {% for menu_item in module_extension.pathByRouteName(menu_path|default(app.current_route)) %}
                    {% set crumb_url = (not loop.last or (breadcrumb is defined and breadcrumb)) ? path(menu_item.routeName, menu_item.routeParams) : null %}
                    {% set last_url = crumb_url ?? last_url %}
                    {% set crumbs = crumbs|merge([{
                        url: crumb_url,
                        icon: menu_item.icon,
                        text: loop.first ? user_extension.currentOrganization.name : (menu_item.caption ? menu_item.caption|trans({}, menu_item.module is not empty ? 'module_' ~ menu_item.module : 'menu') : ''),
                    }]) %}
                {% endfor %}
                {% for item in breadcrumb|default([]) %}
                    {% set crumb_url = item.routeName is defined ? path(item.routeName, item.routeParams ?: {}) : null %}
                    {% set last_url = crumb_url ?? last_url %}
                    {% set crumbs = crumbs|merge([{
                        url: crumb_url,
                        icon: item.icon|default(null),
                        text: (item.caption is defined ? item.caption|trans({}, item.module is defined and item.module is not empty ? 'module_' ~ item.module : 'menu') : '') ~ item.fixed|default(''),
                    }]) %}
                {% endfor %}
                {% for crumb in crumbs %}
                    {% if not loop.first %}<li aria-hidden="true" class="text-gray-300">/</li>{% endif %}
                    <li class="inline-flex items-center gap-1.5{% if loop.last %} font-medium text-gray-700{% endif %}"{% if loop.last %} aria-current="page"{% endif %}>
                        {% if crumb.url %}<a href="{{ crumb.url }}" class="inline-flex items-center gap-1.5 hover:text-brand-700">{% endif %}
                        {% if crumb.icon %}<twig:Ui:Icon name="{{ crumb.icon }}" class="size-3.5" />{% endif %}
                        {{ crumb.text }}
                        {% if crumb.url %}</a>{% endif %}
                    </li>
                {% endfor %}
            </ol>

            {% block content_header %}
                {% if title is defined and (show_title is not defined or show_title == true) %}
                    <h1 class="mb-6 text-2xl font-semibold tracking-tight text-gray-900">{% block content_title %}{{ title }}{% endblock %}</h1>
                {% endif %}
                {% include 'ui/partial_flash.html.twig' %}
            {% endblock %}

            {% if menu ?? false %}
                {% include 'ui/partial_menu.html.twig' %}
            {% endif %}

            {% block content %}{% endblock %}
        </main>

        <footer class="no-print px-4 pb-8 pt-4 text-xs text-gray-400 sm:px-6" role="contentinfo">
            {% block footer %}&copy; 2018{% if 'now'|date('Y') > 2018 %}-{{ 'now'|date('Y') }}{% endif %}, Luis Ramón López López{% endblock %}
        </footer>
    </div>
</div>
{% endblock %}
