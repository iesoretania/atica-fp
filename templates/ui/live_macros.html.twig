{#- Macros para las cabeceras de los listados dinámicos con columnas ordenables (ver AbstractListComponent::sortableColumns) -#}
{% macro sort_button(label, key, sort, dir) %}
    {% set active = sort == key %}
    <button type="button" data-action="live#action:prevent" data-live-action-param="sortBy" data-live-column-param="{{ key }}"
            class="inline-flex items-center gap-1 font-semibold uppercase tracking-wide hover:text-gray-900{{ active ? ' text-gray-900' : '' }}"
            title="{{ (active ? (dir == 'desc' ? 'filters.sorted_desc' : 'filters.sorted_asc') : 'filters.sort_by')|trans({'column': label}, 'general') }}">
        {{- label -}}
        <twig:Ui:Icon name="{{ active ? (dir == 'desc' ? 'sort-down' : 'sort-up') : 'sort' }}" class="size-3{{ active ? '' : ' opacity-40' }}" />
    </button>
{% endmacro %}

{#- <th> con una columna ordenable: lm.sort_th('Nombre', 'name', this.sort, this.dir) -#}
{% macro sort_th(label, key, sort, dir, class = '') %}
    <th aria-sort="{{ sort == key ? (dir == 'desc' ? 'descending' : 'ascending') : 'none' }}"{% if class %} class="{{ class }}"{% endif %}>
        {{ _self.sort_button(label, key, sort, dir) }}
    </th>
{% endmacro %}

{#- Primera cabecera de un listado con casillas: casilla «seleccionar todo» + título ordenable (o fijo si key está vacía) -#}
{% macro select_th(label, key, sort, dir) %}
    <th{% if key %} aria-sort="{{ sort == key ? (dir == 'desc' ? 'descending' : 'ascending') : 'none' }}"{% endif %}>
        <div class="flex items-center gap-2">
            <input type="checkbox" data-list-target="selectAll" class="size-4 rounded border-gray-300 text-brand-600" aria-label="{{ 'selection.clear'|trans({}, 'general') }}">
            {% if key %}{{ _self.sort_button(label, key, sort, dir) }}{% else %}<span class="font-semibold uppercase tracking-wide">{{ label }}</span>{% endif %}
        </div>
    </th>
{% endmacro %}

{#- Primera celda de una fila con casilla: casilla + enlace a la ficha (tachado si struck) -#}
{% macro select_cell(id, url, text, struck = false) %}
    <td class="align-top">
        <label class="flex items-center gap-2">
            <input type="checkbox" name="items[]" value="{{ id }}" class="selectable size-4 rounded border-gray-300 text-brand-600">
            <a href="{{ url }}" class="font-medium text-gray-900 hover:text-brand-700{{ struck ? ' line-through text-gray-500' : '' }}">{{ text }}</a>
        </label>
    </td>
{% endmacro %}
