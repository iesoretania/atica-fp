{#- Tema de formularios del diseño nuevo (sobre el tema Tailwind de Symfony). Uso: {% form_theme form 'ui/form_theme.html.twig' %} -#}
{% extends 'tailwind_2_layout.html.twig' %}

{%- block form_row -%}
    {%- set row_attr = row_attr|merge({class: row_attr.class|default('@container mb-5 max-w-2xl')}) -%}
    {{- parent() -}}
{%- endblock form_row -%}

{%- block widget_attributes -%}
    {%- if 'hidden' in block_prefixes -%}
        {#- los campos ocultos no llevan estilo -#}
    {%- elseif 'checkbox' in block_prefixes or 'radio' in block_prefixes -%}
        {%- set attr = attr|merge({class: attr.class|default('size-4 border-gray-300 text-brand-600 focus:ring-brand-500 ' ~ ('radio' in block_prefixes ? 'rounded-full' : 'rounded'))}) -%}
    {%- else -%}
        {%- set attr = attr|merge({class: attr.class|default('mt-1 block w-full rounded-lg border-0 bg-white px-3 py-2 text-sm text-gray-900 shadow-xs ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-brand-500 disabled:bg-gray-100')}) -%}
    {%- endif -%}
    {{- parent() -}}
{%- endblock widget_attributes -%}

{#- Desplegables (selección única y múltiple): todos son selectores con búsqueda (controlador Stimulus choice-select) -#}
{%- block choice_widget_collapsed -%}
    {%- if attr['data-controller'] is not defined -%}
        {%- set attr = attr|merge({'data-controller': 'choice-select'}) -%}
    {%- endif -%}
    {{- parent() -}}
{%- endblock choice_widget_collapsed -%}

{#- Fecha y hora (dos campos «single_text») en la misma línea en vez de apilados -#}
{%- block datetime_widget -%}
    {%- if widget == 'single_text' -%}
        {{- block('form_widget_simple') -}}
    {%- else -%}
        {%- set attr = attr|merge({class: (attr.class|default('') ~ ' grid grid-cols-2 gap-3')|trim}) -%}
        <div {{ block('widget_container_attributes') }}>
            {{- form_errors(form.date) -}}
            {{- form_errors(form.time) -}}
            {{- form_widget(form.date) -}}
            {{- form_widget(form.time) -}}
        </div>
    {%- endif -%}
{%- endblock datetime_widget -%}

{#- Importe con su símbolo de moneda en la misma línea (el tema base lo deja debajo) -#}
{%- block money_widget -%}
    <span class="flex items-center gap-2">{{- money_pattern|form_encode_currency(block('form_widget_simple')) -}}</span>
{%- endblock money_widget -%}

{%- block form_label -%}
    {%- set label_attr = label_attr|merge({class: label_attr.class|default('block text-sm font-medium text-gray-700')}) -%}
    {{- parent() -}}
{%- endblock form_label -%}

{#- Ayuda de un campo: la opción «help» o, por convención, la traducción de «<etiqueta>.help» en el dominio del formulario
    (la misma convención que las explicaciones de las opciones de una lista de tarjetas). -#}
{%- block form_help -%}
    {%- if help is empty and label is not empty and label is not same as(false) and label is not iterable and translation_domain is not same as(false) -%}
        {%- set help_key = label ~ '.help' -%}
        {%- set help_candidate = help_key|trans(label_translation_parameters|default({}), translation_domain) -%}
        {%- if help_candidate != help_key -%}
            {%- set help = help_candidate -%}
            {%- set help_translation_domain = false -%}
        {%- endif -%}
    {%- endif -%}
    {%- set help_attr = help_attr|merge({class: help_attr.class|default('mt-1 text-xs text-gray-500')}) -%}
    {{- parent() -}}
{%- endblock form_help -%}

{%- block form_errors -%}
    {%- if errors|length > 0 -%}
        <ul class="mt-1">
            {%- for error in errors -%}
                <li class="text-sm text-red-700" id="{{ id ~ '_error' ~ loop.index }}">{{ error.message }}</li>
            {%- endfor -%}
        </ul>
    {%- endif -%}
{%- endblock form_errors -%}

{#- Listas expandidas. Selección única (radio): tarjetas seleccionables, con una descripción opcional bajo la etiqueta
    (por convención, la traducción de «<etiqueta de la opción>.help» en el mismo dominio; o la opción «choice_attr» del campo:
    'data-description' => 'texto o clave de traducción'). Selección múltiple (casillas): lista simple.
    form_label() no dibuja nada para los hijos de una lista expandida en el tema Tailwind de Symfony; la etiqueta se pinta a mano. -#}
{%- block choice_widget_expanded -%}
    {%- if multiple -%}
        {#- Lista de casillas: recuadro con tarjetas y un único enlace «Seleccionar todos / Quitar todos» (si hay más de una opción).
            Es el aspecto general de cualquier selección múltiple expandida; las listas con textos propios pueden usar ui/form_checklist. -#}
        {%- set count = form|length -%}
        {%- set has_groups = false -%}
        {%- for group_label, group in form.vars.choices -%}{%- if group is iterable -%}{%- set has_groups = true -%}{%- endif -%}{%- endfor -%}
        {%- if has_groups -%}
        {#- Opciones agrupadas (group_by): un recuadro por grupo, con su propio «Seleccionar todos» -#}
        <div {{ block('widget_container_attributes') }} class="mt-2 space-y-4">
            {%- for group_label, group in form.vars.choices -%}
                {%- set grouped = group is iterable -%}
                <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-xs" data-controller="check-group"
                     data-check-group-select-label-value="{{ 'selection.select_group'|trans({}, 'general') }}"
                     data-check-group-clear-label-value="{{ 'selection.clear_group'|trans({}, 'general') }}">
                    {%- if grouped %}
                        <div class="mb-2 flex items-start justify-between gap-3">
                            <h3 class="text-sm font-semibold text-gray-700">{{ group_label }}</h3>
                            {%- if group|length > 1 %}
                                <button type="button" data-check-group-target="toggle" data-action="check-group#toggle"
                                        class="shrink-0 text-sm font-medium text-brand-700 hover:text-brand-900"></button>
                            {% endif -%}
                        </div>
                    {% endif -%}
                    <div class="grid grid-cols-1 gap-2">
                        {%- for key, choice in (grouped ? group : {(group_label): group}) %}
                            {%- set child = form[key] -%}
                            <label for="{{ child.vars.id }}"
                                   class="flex cursor-pointer items-start gap-3 rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-800 transition hover:border-gray-300 has-checked:border-brand-500 has-checked:bg-brand-50 has-focus-visible:ring-2 has-focus-visible:ring-brand-500 has-disabled:cursor-not-allowed has-disabled:opacity-60">
                                <span class="mt-0.5">{{- form_widget(child, {translation_domain: false}) -}}</span>
                                <span class="min-w-0">{{ child.vars.label }}</span>
                            </label>
                        {% endfor -%}
                    </div>
                </div>
            {%- endfor -%}
        </div>
        {%- else -%}
        <div {{ block('widget_container_attributes') }} data-controller="check-group"
             data-check-group-select-label-value="{{ 'selection.select_group'|trans({}, 'general') }}"
             data-check-group-clear-label-value="{{ 'selection.clear_group'|trans({}, 'general') }}"
             class="mt-2 rounded-2xl border border-gray-200 bg-white p-4 shadow-xs">
            {%- if count > 1 %}
                <div class="mb-2 flex justify-end">
                    <button type="button" data-check-group-target="toggle" data-action="check-group#toggle"
                            class="text-sm font-medium text-brand-700 hover:text-brand-900"></button>
                </div>
            {% endif -%}
            <div class="grid grid-cols-1 gap-2 {{ count > 6 ? '@lg:grid-cols-2' : '' }}">
                {%- for child in form %}
                    {%- set child_label = child.vars.label is same as(false) ? '' : (child.vars.label ?: child.vars.name|humanize) -%}
                    <label for="{{ child.vars.id }}"
                           class="flex cursor-pointer items-start gap-3 rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-800 transition hover:border-gray-300 has-checked:border-brand-500 has-checked:bg-brand-50 has-focus-visible:ring-2 has-focus-visible:ring-brand-500 has-disabled:cursor-not-allowed has-disabled:opacity-60">
                        <span class="mt-0.5">{{- form_widget(child) -}}</span>
                        <span class="min-w-0">
                            {{- child.vars.translation_domain is same as(false) ? child_label : child_label|trans(child.vars.label_translation_parameters|default({}), child.vars.translation_domain) -}}
                        </span>
                    </label>
                {% endfor -%}
            </div>
        </div>
        {%- endif -%}
    {%- else -%}
        {%- set count = form|length -%}
        {#- Las columnas dependen del ancho de la fila (la fila es un «@container»): 1 si es estrecha, 2 y, con tres opciones, 3 si es ancha -#}
        <div {{ block('widget_container_attributes') }} class="mt-2 grid grid-cols-1 gap-3 {{ count == 3 ? '@md:grid-cols-2 @2xl:grid-cols-3' : (count == 1 ? '' : '@md:grid-cols-2') }}">
            {%- for child in form %}
                {%- set child_label = child.vars.label is same as(false) ? '' : (child.vars.label ?: child.vars.name|humanize) -%}
                {#- Explicación de la opción (texto gris): «choice_attr» 'data-description' o, por convención, la traducción de «<etiqueta>.help» -#}
                {%- set description = child.vars.attr['data-description'] ?? null -%}
                {%- set description_translated = false -%}
                {%- if description is null and child.vars.translation_domain is not same as(false) and child.vars.label is not iterable and child.vars.label is not same as(false) and child.vars.label is not empty -%}
                    {%- set help_key = child.vars.label ~ '.help' -%}
                    {%- set help_text = help_key|trans(child.vars.label_translation_parameters|default({}), child.vars.translation_domain) -%}
                    {%- if help_text != help_key -%}
                        {%- set description = help_text -%}
                        {%- set description_translated = true -%}
                    {%- endif -%}
                {%- endif -%}
                <label for="{{ child.vars.id }}"
                       class="flex cursor-pointer items-start gap-3 rounded-xl border border-gray-200 bg-white p-4 text-sm transition hover:border-gray-300 has-checked:border-brand-500 has-checked:bg-brand-50 has-focus-visible:ring-2 has-focus-visible:ring-brand-500 has-disabled:cursor-not-allowed has-disabled:opacity-60">
                    <span class="mt-0.5">{{- form_widget(child) -}}</span>
                    <span class="min-w-0">
                        <span class="block font-medium text-gray-900">
                            {{- child.vars.translation_domain is same as(false) ? child_label : child_label|trans(child.vars.label_translation_parameters|default({}), child.vars.translation_domain) -}}
                        </span>
                        {%- if description %}
                            <span class="mt-0.5 block text-gray-500">
                                {{- (description_translated or child.vars.translation_domain is same as(false)) ? description : description|trans({}, child.vars.translation_domain) -}}
                            </span>
                        {% endif -%}
                    </span>
                </label>
            {% endfor -%}
        </div>
    {%- endif -%}
{%- endblock choice_widget_expanded -%}

{#- Alumnado (StudentEnrollmentChoiceType): bloques por grupo, tarjetas a dos columnas (una si la fila es estrecha) y un botón para
    marcar o quitar a todo el grupo. Si no es múltiple y expandido, se dibuja como un desplegable normal. -#}
{%- block student_enrollment_choice_widget -%}
    {%- if expanded and multiple -%}
        <div {{ block('widget_container_attributes') }} class="mt-2 space-y-5">
            {%- for group_label, group in form.vars.choices -%}
                {%- set grouped = group is iterable -%}
                <div role="group" {% if grouped %}aria-labelledby="{{ id }}_group_{{ loop.index }}"{% endif %}
                     class="rounded-2xl border border-gray-200 bg-white p-4 shadow-xs"
                     data-controller="check-group"
                     data-check-group-select-label-value="{{ 'selection.select_group'|trans({}, 'general') }}"
                     data-check-group-clear-label-value="{{ 'selection.clear_group'|trans({}, 'general') }}">
                    {%- if grouped %}
                        <div class="mb-2 flex items-center justify-between gap-3">
                            <h3 id="{{ id }}_group_{{ loop.index }}" class="flex items-center gap-2 text-sm font-semibold text-gray-700">
                                <twig:Ui:Icon name="users" class="size-4 text-gray-400" />
                                {{ group_label }}
                            </h3>
                            <button type="button" data-check-group-target="toggle" data-action="check-group#toggle"
                                    class="text-sm font-medium text-brand-700 hover:text-brand-900"></button>
                        </div>
                    {% endif -%}
                    <div class="grid grid-cols-1 gap-2 @lg:grid-cols-2">
                        {%- for key, choice in (grouped ? group : {(group_label): group}) %}
                            <label for="{{ form[key].vars.id }}"
                                   class="flex cursor-pointer items-center gap-3 rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-800 transition hover:border-gray-300 has-checked:border-brand-500 has-checked:bg-brand-50 has-focus-visible:ring-2 has-focus-visible:ring-brand-500 has-disabled:cursor-not-allowed has-disabled:opacity-60">
                                {{- form_widget(form[key], {translation_domain: false}) -}}
                                <span class="min-w-0">{{ form[key].vars.label }}</span>
                            </label>
                        {% endfor -%}
                    </div>
                </div>
            {%- endfor -%}
        </div>
    {%- else -%}
        {{- block('choice_widget') -}}
    {%- endif -%}
{%- endblock student_enrollment_choice_widget -%}

{#- RichTextType: el controlador Stimulus rich-editor lo sustituye por un editor Quill (el textarea sigue siendo el campo enviado) -#}
{%- block rich_text_widget -%}
    {%- set attr = attr|merge({'data-controller': (attr['data-controller']|default('') ~ ' rich-editor')|trim}) -%}
    {{- block('textarea_widget') -}}
{%- endblock rich_text_widget -%}

{#- Select2EntityType con búsqueda remota: lo gestiona el controlador Stimulus entity-select (Tom Select) -#}
{%- block tetranz_select2entity_widget -%}
    {%- set attr = attr|merge({
        'data-controller': 'entity-select',
        'data-entity-select-url-value': remote_path,
        'data-entity-select-min-length-value': minimum_input_length,
        'data-entity-select-placeholder-value': placeholder ? placeholder|trans({}, translation_domain) : '',
        'data-entity-select-field-name-value': name,
        'data-entity-select-class-type-value': class_type ?? '',
        'data-entity-select-scroll-value': scroll ? 'true' : 'false',
        'data-entity-select-allow-clear-value': allow_clear ? 'true' : 'false',
        'data-entity-select-render-html-value': render_html ? 'true' : 'false',
        'data-entity-select-query-parameters-value': (query_parameters ?: {})|json_encode,
        'data-entity-select-req-params-value': attr['data-req_params'] ?? '{}',
    }) -%}
    {%- if multiple -%}{%- set attr = attr|merge({multiple: 'multiple'}) -%}{%- endif -%}
    <select {{ block('widget_attributes') }}>
        {%- if allow_clear %}<option value=""></option>{% endif -%}
        {%- if value is iterable -%}
            {%- for id, label in value -%}
                <option value="{{ id }}" selected="selected">{{ label }}</option>
            {%- endfor -%}
        {%- endif -%}
    </select>
{%- endblock tetranz_select2entity_widget -%}

{%- block checkbox_row -%}
    <div class="mb-5 max-w-2xl">
        {{- form_errors(form) -}}
        <div class="inline-flex items-center gap-2">
            {{- form_widget(form) -}}
            {{- form_label(form, null, {label_attr: {class: 'text-sm text-gray-700'}}) -}}
        </div>
        {{- form_help(form) -}}
    </div>
{%- endblock checkbox_row -%}
