{#-
  Disposición de un formulario de Symfony en filas de columnas iguales (rejilla), dentro de una tarjeta.
  Se sigue usando el componente Form (validación, CSRF, transformadores): solo cambia cómo se colocan los campos.

    {% import 'ui/form_layout.html.twig' as fl %}
    {{ fl.grid(form, [
        ['company', 'workcenter'],              {# dos campos en la misma fila #}
        ['signDate', 'startDate', 'endDate'],   {# tres campos #}
        ['notes'],                              {# un campo a todo el ancho #}
        ['code', null, null],                   {# un campo que ocupa solo un tercio: null reserva la columna #}
    ]) }}

  - Cada fila tiene de 1 a 6 columnas, iguales por defecto (en pantallas pequeñas se apilan). Con «campo:peso» una columna
    es proporcionalmente más ancha: ['code:1', 'name:4'] → código corto y nombre largo.
  - Los grupos de radio (tarjetas seleccionables) van siempre solos en su fila: la macro los separa de los demás campos.
  - Tercer argumento opcional: opciones de form_row por campo, p. ej. {description: {attr: {rows: 4}}}.
  - Los campos que no aparecen en la disposición se añaden al final, a todo el ancho; así nunca se pierde un campo.
  - Los campos ya dibujados antes (form_widget(form.campo)) y los que no existen en este formulario se omiten.
  - Para un campo con un ancho propio, el tema y los bloques personalizados (_formulario_campo_widget) siguen funcionando.
-#}
{% macro grid(form, layout = [], options = {}, title = null) %}
    {% set columns = {1: 'md:grid-cols-1', 2: 'md:grid-cols-2', 3: 'md:grid-cols-3', 4: 'md:grid-cols-4', 5: 'md:grid-cols-5', 6: 'md:grid-cols-6'} %}
    {% set placed = [] %}
    {{ form_errors(form) }}
    {#- Un grupo de radio (tarjetas) siempre va solo en su fila, aunque la disposición lo ponga junto a otros campos -#}
    {% set rows = [] %}
    {% for row in layout %}
        {% set others = [] %}
        {% for entry in row %}
            {% set name = entry is null ? null : (entry|split(':'))[0] %}
            {% if name is not null and form[name] is defined and (form[name].vars.expanded|default(false)) and not (form[name].vars.multiple|default(false)) %}
                {% if others|filter(n => n is not null) %}{% set rows = rows|merge([others]) %}{% set others = [] %}{% endif %}
                {% set rows = rows|merge([[name]]) %}
            {% else %}
                {% set others = others|merge([entry]) %}
            {% endif %}
        {% endfor %}
        {% if others|filter(n => n is not null) %}{% set rows = rows|merge([others]) %}{% endif %}
    {% endfor %}
    <div class="max-w-5xl overflow-hidden rounded-xl bg-white shadow-xs ring-1 ring-gray-200">
        {#- Cabecera de la tarjeta, separada del cuerpo -#}
        {% if title %}<h2 class="border-b border-gray-100 px-5 py-4 text-sm font-semibold text-gray-900 sm:px-6">{{ title }}</h2>{% endif %}
        <div class="space-y-5 p-5 sm:p-6">
        {% for row in rows %}
            {% set fields = [] %}
            {% set tracks = [] %}
            {% for entry in row %}
                {% set name = entry is null ? null : (entry|split(':'))[0] %}
                {% set tracks = tracks|merge(['minmax(0,' ~ (entry is null ? 1 : ((entry|split(':'))[1] ?? 1)) ~ 'fr)']) %}
                {% if name is not null %}
                    {% set placed = placed|merge([name]) %}
                    {% if form[name] is defined and not form[name].rendered %}{% set fields = fields|merge([name]) %}{% endif %}
                {% endif %}
            {% endfor %}
            {% if fields %}
                {#- «campo:3» da a la columna un ancho proporcional (p. ej. ['code:1', 'name:4']: código corto y nombre largo) -#}
                <div class="grid grid-cols-1 gap-x-6 gap-y-5 md:grid-cols-(--cols)" style="--cols: {{ tracks|join(' ') }}">
                    {% for entry in row %}
                        {% set name = entry is null ? null : (entry|split(':'))[0] %}
                        {% if name is null %}
                            <div class="hidden md:block" aria-hidden="true"></div>
                        {% elseif name in fields %}
                            {{ form_row(form[name], {row_attr: {class: '@container min-w-0'}}|merge(options[name]|default({}))) }}
                        {% endif %}
                    {% endfor %}
                </div>
            {% endif %}
        {% endfor %}
        {#- lo que no esté en la disposición, a todo el ancho -#}
        {% for child in form %}
            {% if child.vars.name not in placed and not child.rendered and 'hidden' not in child.vars.block_prefixes %}
                {{ form_row(child, {row_attr: {class: '@container min-w-0'}}|merge(options[child.vars.name]|default({}))) }}
            {% endif %}
        {% endfor %}
        {{ form_rest(form) }}
        </div>
    </div>
{% endmacro %}

{#- Zona de peligro: tarjeta roja bajo el formulario para eliminar el registro. Envía el id a la operación de borrado del
    listado (que pide confirmación). Debe ir FUERA del <form> principal (no se pueden anidar formularios).
        {{ fl.danger_zone('Peligro: eliminación de la visita', 'Una vez eliminada, no se podrá recuperar.', path('...operation', {...}), visit.id) }} -#}
{% macro danger_zone(title, text, action, id, name = 'items') %}
    <div class="mt-8 max-w-5xl overflow-hidden rounded-xl bg-white ring-1 ring-red-200">
        <h2 class="border-b border-red-100 bg-red-50 px-5 py-4 text-sm font-semibold text-red-900 sm:px-6">{{ title }}</h2>
        <form method="post" action="{{ action }}" class="flex flex-wrap items-center justify-between gap-3 px-5 py-4 sm:px-6">
            <p class="text-sm text-gray-600">{{ text }}</p>
            <input type="hidden" name="{{ name }}[]" value="{{ id }}">
            <button type="submit" name="delete"
                    class="inline-flex items-center gap-2 rounded-lg px-3.5 py-2 text-sm font-medium text-red-700 shadow-xs ring-1 ring-inset ring-red-300 transition hover:bg-red-50">
                <twig:Ui:Icon name="trash" />
                {{- 'danger.delete'|trans({}, 'general') -}}
            </button>
        </form>
    </div>
{% endmacro %}
