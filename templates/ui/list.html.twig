{#-
  Listado genérico del diseño nuevo. Mantiene los mismos bloques que generic/list.html.twig
  (path_new, more_actions, table_header, table_body, before_table, after_table, pagerfanta...).
  Las filas pueden llevar class="clickable-row" y data-href="..." y las casillas class="selectable".
-#}
{% trans_default_domain domain %}
{% extends 'ui/layout.html.twig' %}

{% block content %}
<div data-controller="list">
    {% block filter %}
        {% block before_filter %}{% endblock %}
        <div class="mb-4 flex flex-wrap items-center gap-3">
            <div class="relative w-full sm:max-w-sm">
                <twig:Ui:Icon name="search" class="pointer-events-none absolute left-3 top-1/2 size-3.5 -translate-y-1/2 text-gray-400" />
                <input type="search" id="search" data-list-target="search" data-action="input->list#search" autofocus autocomplete="off"
                       value="{{ q|default('') }}" placeholder="{{ 'table.filter'|trans }}"
                       class="block w-full rounded-lg border-0 bg-white py-2 pl-9 pr-9 text-sm [&::-webkit-search-cancel-button]:hidden shadow-xs ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-brand-500">
                <button type="button" data-action="list#clear" aria-label="{{ 'table.filter'|trans }}" class="absolute right-2 top-1/2 -translate-y-1/2 rounded p-1 text-gray-400 hover:text-gray-600">
                    <twig:Ui:Icon name="times" class="size-3.5" />
                </button>
            </div>
            {% block new_action %}
                {% if not (read_only|default(false) or is_read_only()) %}
                    {#- La URL se captura en una variable: un «{% block %}» dentro del atributo de un componente no se evalúa -#}
                    {% set new_url %}{% block path_new %}{% endblock %}{% endset %}
                    <twig:Ui:Button :href="new_url|trim" icon="plus" label="{{ 'table.new'|trans }}" />
                {% endif %}
                {% block more_actions %}{% endblock %}
            {% endblock %}
        </div>
    {% endblock %}

    {#- URL del formulario de operaciones por lote (borrar, copiar...); si está vacía no se dibuja <form> -#}
    {% set form_action_url %}{% block form_action %}{% endblock %}{% endset %}
    <section id="exchange" class="transition-opacity">
        {% if form_action_url|trim %}<form method="post" action="{{ form_action_url|trim }}">{% endif %}
        {% block before_table %}{% endblock %}
        <div class="overflow-hidden rounded-xl bg-white shadow-xs ring-1 ring-gray-200">
            {% if pager is defined %}
                <p class="border-b border-gray-200 px-4 py-2.5 text-sm text-gray-500">{{ 'table.total'|trans({'count': pager.count}) }}</p>
            {% endif %}
            <div class="overflow-x-auto">
                <table id="list" class="w-full text-left text-sm">
                    <thead class="bg-gray-50 text-xs font-semibold uppercase tracking-wide text-gray-500 [&_th]:px-4 [&_th]:py-3">
                        <tr>{% block table_header %}{% endblock %}</tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 [&_td]:px-4 [&_td]:py-3 [&_tr.clickable-row]:cursor-pointer [&_tr.clickable-row:hover]:bg-brand-50/60">
                        {% block table_body %}{% endblock %}
                    </tbody>
                    {% block table_footer %}{% endblock %}
                </table>
            </div>
        </div>
        {% if pager is defined and pager.haveToPaginate %}
            <div class="mt-4 flex justify-center">
                {% block pagerfanta %}
                    {{ pagerfanta(pager, 'tailwind', {'prev_message': 'paginator.prev'|trans([], 'general'), 'next_message': 'paginator.next'|trans([], 'general')}) }}
                {% endblock %}
            </div>
        {% endif %}
        <div class="mt-6 flex flex-wrap gap-2">
            {% block after_table %}{% endblock %}
        </div>
        {% if form_action_url|trim %}</form>{% endif %}
    </section>
</div>
{% endblock %}
