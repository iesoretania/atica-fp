{% trans_default_domain 'itp_grading' %}
{% extends 'layout.html.twig' %}
{% import 'macros.html.twig' as m %}
{% block content %}
    <h3>{{ student_program_workcenter }} {{ student_program_workcenter.startDate ? ' - ' ~ student_program_workcenter.startDate|date('format.date'|trans({}, 'general')) }} {{ student_program_workcenter.endDate ? ' - ' ~ student_program_workcenter.endDate|date('format.date'|trans({}, 'general')) }}</h3>
    <h4>{{ student_program_workcenter_activity.activity }}</h4>
    {{ form_start(form) }}
    {{ form_row(form.disabled) }}
    {% if student_program_workcenter_activity.comments.count() > 0 %}
    <div class="form-group row">
        <label class="col-form-label col-sm-2">{{ 'form.comments'|trans }}</label>
        <div class="col-sm-10">
            {% for comment in student_program_workcenter_activity.comments %}
                <div class="card">
                    <div class="card-body">{{ comment.comment|nl2br }}</div>
                    <div class="card-footer small">
                        <b>{{ comment.timestamp|date('format.datetime'|trans({}, 'general')) }} - {{ comment.person }}</b>
                        {% if is_granted(constant('App\\Security\\ItpModule\\StudentProgramWorkcenterActivityCommentVoter::DELETE'), comment) %}
                            <a href="{{ path('in_company_training_phase_tracking_grading_comment_delete', {'activityComment': comment.id}) }}"><i class="fa fa-trash"></i></a>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}
    {{ form_rest(form) }}
    {{ m.start_button() }}
    {% if not read_only %}{{ m.submit_button('submit', 'check', 'btn-success', 'form.save'|trans) }}{% endif %}
    {{ m.link_button(path('in_company_training_phase_tracking_grading_form', {'studentProgramWorkcenter': student_program_workcenter.id }), 'arrow-left', 'btn-info', 'form.back'|trans) }}
    {{ m.end_button() }}
    {{ form_end(form) }}
{% endblock %}
