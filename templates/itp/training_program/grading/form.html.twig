{% trans_default_domain 'itp_grading' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}
{% form_theme form 'ui/form_theme.html.twig' %}

{% block content %}
    <p class="mb-4 text-lg font-semibold text-gray-900">
        {{ student_program_workcenter }}
        {{ student_program_workcenter.startDate ? ' - ' ~ student_program_workcenter.startDate|date('format.date'|trans({}, 'general')) }}
        {{ student_program_workcenter.endDate ? ' - ' ~ student_program_workcenter.endDate|date('format.date'|trans({}, 'general')) }}
    </p>
    <div class="mb-4 max-w-5xl rounded-xl bg-brand-50 p-4 text-sm text-brand-900 ring-1 ring-brand-200">
        <ul class="list-disc space-y-1 pl-5">
            {% for line in 'prompt.tracking_info'|trans|split('\n') %}
                {% if line is not empty %}<li>{{ line }}</li>{% endif %}
            {% endfor %}
        </ul>
    </div>

    {% if grades %}
        <div class="mb-6 max-w-5xl overflow-hidden rounded-xl bg-white shadow-xs ring-1 ring-gray-200">
            <table class="w-full text-left text-sm">
                <thead class="bg-gray-50 text-xs font-semibold uppercase tracking-wide text-gray-500 [&_th]:px-4 [&_th]:py-3">
                    <tr>
                        <th class="w-1/3">{{ 'header.grade'|trans }}</th>
                        <th>{{ 'header.description'|trans }}</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 [&_td]:px-4 [&_td]:py-3">
                    {% for grade in grades %}
                        <tr>
                            <td>{{ grade.description }}</td>
                            <td>{{ grade.notes|nl2br }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    {{ form_start(form) }}
    {{ form_errors(form.activities) }}
    <div class="mb-3">{{ form_label(form.activities) }}</div>
    {% for activity in form.activities %}
        {% set data = activity.vars.data %}
        <div class="mb-4 max-w-5xl overflow-hidden rounded-xl bg-white shadow-xs ring-1 ring-gray-200">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-gray-100 px-5 py-3">
                <h3 class="flex items-center gap-2 text-sm font-semibold text-gray-900">
                    {{ data.activity }}
                    {% if data.disabled %}<span title="{{ 'form.disabled.hint'|trans }}"><twig:Ui:Icon name="lock" class="size-3.5 text-gray-400" /></span>{% endif %}
                </h3>
                <a href="{{ path('in_company_training_phase_tracking_grading_comment_form', {'studentProgramWorkcenterActivity': data.id}) }}" target="_blank"
                   title="{{ 'form.edit.hint'|trans }}" class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
                    <twig:Ui:Icon name="pen" class="size-3" /> {{ 'form.edit.hint'|trans }}
                </a>
            </div>
            <div class="p-5">
                {{ form_errors(activity) }}
                {{ form_row(activity.scaleValue, {label: false}) }}
                {{ form_rest(activity) }}
                {% if data.comments.count() > 0 %}
                    <details class="mt-4 rounded-lg bg-gray-50 p-3 text-sm">
                        <summary class="flex cursor-pointer items-center gap-2 font-medium text-gray-700" title="{{ 'form.comments.hint'|trans }}">
                            <twig:Ui:Icon name="comments" class="size-3.5 text-gray-400" /> {{ data.comments.count() }}
                        </summary>
                        <div class="mt-3 space-y-2">
                            {% for comment in data.comments %}
                                <div class="rounded-lg bg-white ring-1 ring-gray-200">
                                    <div class="p-3">{{ comment.comment|nl2br }}</div>
                                    <div class="border-t border-gray-100 px-3 py-1.5 text-xs font-semibold text-gray-500">{{ comment.timestamp|date('format.datetime'|trans({}, 'general')) }} - {{ comment.person }}</div>
                                </div>
                            {% endfor %}
                        </div>
                    </details>
                {% endif %}
            </div>
        </div>
    {% endfor %}

    <div class="max-w-5xl overflow-hidden rounded-xl bg-white shadow-xs ring-1 ring-gray-200">
        <h2 class="border-b border-gray-100 px-5 py-4 text-sm font-semibold text-gray-900 sm:px-6">{{ 'form.remarks'|trans }}</h2>
        <div class="p-5 sm:p-6">{{ form_row(form.workTutorRemarks, {label: false}) }}</div>
    </div>
    {{ form_rest(form) }}
    {{ m.start_button() }}
        {% if not read_only %}{{ m.submit_button('submit', 'check', 'btn-success', 'form.save'|trans) }}{% endif %}
        {{ m.link_button(path('in_company_training_phase_tracking_grading_list', {'academicYear': student_program_workcenter.studentProgram.programGroup.programGrade.grade.training.academicYear.id}), 'arrow-left', 'btn-info', 'form.back'|trans) }}
    {{ m.end_button() }}
    {{ form_end(form) }}
{% endblock %}
