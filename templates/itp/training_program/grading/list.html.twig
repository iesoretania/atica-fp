{% trans_default_domain 'itp_grading' %}
{% extends 'generic/list.html.twig' %}
{% import 'macros.html.twig' as m %}

{% block new_action %}{% endblock %}

{% block table_header %}
    <th class="w-20">{{ 'header.student'|trans }}</th>
    <th class="w-20">{{ 'header.workcenter'|trans }}</th>
    <th class="w-10">{{ 'header.educational_tutor'|trans }}</th>
    <th class="w-10">{{ 'header.work_tutor'|trans }}</th>
    <th class="w-10">{{ 'header.date_range'|trans }}</th>
    <th class="w-10">{{ 'header.activities'|trans }}</th>
{% endblock %}

{% block table_body %}
            {% for item in pager %}
                {% set spw = item[0] %}
                {% set url = path('in_company_training_phase_tracking_grading_form', {'studentProgramWorkcenter': spw.id}) %}
                <tr class="clickable-row" data-href="{{ url }}">
                    <td>
                        <a href="{{ url }}">{{ spw.studentProgram.studentEnrollment }}</a>
                    </td>
                    <td>
                        {{ spw.workcenter }}
                    </td>
                    <td>
                        {{ spw.educationalTutor }}
                    </td>
                    <td>
                        {{ spw.workTutor }}
                    </td>
                    <td>
                        {% if spw.startDate and spw.endDate %}
                            {{ spw.startDate|date('format.date'|trans({}, 'general')) }} - {{ spw.endDate|date('format.date'|trans({}, 'general')) }}
                        {% endif %}
                    </td>
                    <td>
                        {{ item.graded_activities }}/{{ item.total_activities }}
                        {% if item.total_activities != 0 %}
                            ({{ (item.graded_activities * 100.0 / item.total_activities)|number_format(2, 'format.decimal_separator'|trans({}, 'general')) }} %)
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">{{ 'table.no_items'|trans }}</td>
                </tr>
            {% endfor %}
{% endblock %}

{% block before_filter %}
    {% include 'organization/partial_academic_year.html.twig' %}
{% endblock %}

{% block pagerfanta %}
    {{ pagerfanta(pager, 'twitter_bootstrap4', {'prev_message': 'paginator.prev'|trans([], 'general'), 'next_message': 'paginator.next'|trans([], 'general'), 'routeParams': {'academicYear': academic_year.id }}) }}
{% endblock %}

{% block after_table %}
    <div class="clearfix"></div>
    {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
</form>
{% endblock %}
