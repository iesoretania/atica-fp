{% trans_default_domain 'itp_grading' %}
{% extends 'ui/layout.html.twig' %}

{#- Listado dinámico (Live Component Itp:GradingList): por curso académico o, con program_group, de un grupo -#}
{% block content %}
    {% if academic_years is defined %}
        <div data-controller="list">
            {% include 'ui/partial_academic_year.html.twig' with {academic_year_route: app.current_route} %}
        </div>
        {% include 'ui/_live_list.html.twig' with {component: 'Itp:GradingList', props: {academicYear: academic_year, urlPath: url_path, reportPath: report_path}} %}
    {% else %}
        {% include 'ui/_live_list.html.twig' with {component: 'Itp:GradingList', props: {programGroup: program_group, urlPath: url_path, reportPath: report_path}} %}
    {% endif %}
{% endblock %}
