{% trans_default_domain 'itp_grading' %}
{% extends 'layout/base_report.html.twig' %}

{% block title %}{{ 'title.evaluation_report'|trans }} - {{ student_program_workcenter }}{% endblock %}

{% block style %}
    {{ parent() }}
    <style>
        body {
            font-size: 10px;
        }

        @page {
            margin-top: 2.65cm;
            margin-left: 2cm;
            margin-right: 2cm;
            margin-bottom: 6.5cm;
            odd-header-name: html_header;
            even-header-name: html_header;
            odd-footer-name: html_footer;
            even-footer-name: html_footer;
        }

        td, th {
            border: 1px solid;
            padding: 0.1cm;
        }

        tr.title {
            background-color: lightgray;
        }

        th.big-title {
            background-color: darkgrey;
            font-size: 120%;
        }

        th.left {
            text-align: left;
        }

        td.center {
            text-align: center;
            vertical-align: center;
        }
    </style>
{% endblock %}

{% block body %}
    <htmlpageheader name="header">
        <div style="padding-top: 0.2cm; font-size: 12px">
            <div style="float: right; text-align: right; width: 8cm;">{{ 'report.council'|trans }}</div>
            <br />
            <div style="float: right; text-align: right; width: 5cm;">
                {{ 'report.page'|trans({'page': '{PAGENO}', 'total': '{nbpg}'}) }}
            </div>
            {{ 'report.evaluation_title'|trans }}
        </div>
    </htmlpageheader>

    <htmlpagefooter name="footer">
        <div style="page-break-inside: avoid; text-align: center; padding-bottom: 1cm; font-weight: bold">
            <div>{{ 'report.signature'|trans({
                    'city': student_program_workcenter.educationalTutor.academicYear.organization.city,
                    'day': student_program_workcenter.endDate|date('j', false),
                    'month_string': ('r_month' ~ (student_program_workcenter.endDate|date('m', false) - 1))|trans({}, 'calendar'),
                    'year': student_program_workcenter.endDate|date('Y', false)
                }) }}</div>
            <table style="margin-top: 0.5cm; vertical-align: top; margin-left: auto; margin-right: auto; width: 70%">
                <tr style="width: 100%">
                    <td style="width: 70%; text-align: left">
                        {{ 'report.educational_tutor.signature'|trans }}<br /><br /><br /><br /><br /><br /><br /><br />
                    </td>
                    <td style="width: 30%; text-align: center">
                        {{ 'report.organization.stamp'|trans }}
                    </td>
                </tr>
                <tr>
                    <td colspan="2">{{ 'report.signed'|trans }} {{ student_program_workcenter.educationalTutor }}</td>
                </tr>
            </table>
        </div>
    </htmlpagefooter>

    {% include 'itp/training_program/grading/evaluation_data_partial.html.twig' %}

{% endblock %}
