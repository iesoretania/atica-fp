{% extends 'ui/delete.html.twig' %}
{% set domain = 'itp_activity' %}
{% trans_default_domain 'itp_activity' %}

{% block delete_header %}
    <th>{{ 'header.code'|trans }}</th>
    <th>{{ 'header.name'|trans }}</th>
    <th>{{ 'header.description'|trans }}</th>
{% endblock %}

{% block delete_rows %}
    {% for item in items %}
        <tr>
            <td>{{ item.code }}</td>
            <td>{{ item.name }}</td>
            <td>{{ item.description|nl2br }}</td>
        </tr>
    {% endfor %}
{% endblock %}
