{% trans_default_domain 'itp_activity' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/form_layout.html.twig' as fl %}

{#- Cascada módulos → resultados de aprendizaje → criterios: la recalcula el Live Component Itp:ActivityForm -#}
{% block content %}
    <twig:Itp:ActivityForm :activityEntity="activity.id ? activity : null" :programGrade="activity.id ? null : activity.programGrade" :form="form" :backUrl="last_url" />
    {% if activity.id and not is_read_only() %}
        {{ fl.danger_zone('danger.title'|trans, 'danger.text'|trans, path('in_company_training_phase_activity_operation', {'programGrade': activity.programGrade.id}), activity.id) }}
    {% endif %}
{% endblock %}
