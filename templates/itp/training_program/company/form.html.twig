{% trans_default_domain 'itp_company' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}
{% import 'ui/form_layout.html.twig' as fl %}
{% import 'ui/form_checklist.html.twig' as cl %}
{% form_theme form 'ui/form_theme.html.twig' _self %}

{% block content %}
    {{ form_start(form) }}
    {{ fl.grid(form, [
        ['company'],
        ['agreementNumber'],
        ['monitoringInstruments'],
        ['programActivities'],
    ], {monitoringInstruments: {attr: {rows: 4}}}, 'card.title'|trans) }}
    {{ m.start_button() }}
        {% if not is_read_only() %}{{ m.submit_button('submit', 'check', 'btn-success', 'form.save'|trans) }}{% endif %}
        {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
    {{ m.end_button() }}
    {{ form_end(form) }}
{% endblock %}

{% block _company_program_programActivities_widget %}
    {{ cl.checklist(form, choices, 'form.activities.all'|trans, 'form.activities.none'|trans, 'form.no_activity'|trans) }}
{% endblock %}
