{% trans_default_domain 'calendar' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}

{% block content %}
    <div data-controller="list">
        <form action="{{ path('in_company_training_phase_student_program_workcenter_manage_calendar_delete', {'studentProgramWorkcenter': student_program_workcenter.id}) }}" method="post">
            {% embed 'ui/calendar.html.twig' %}
                {% block day %}
                    {% if day %}
                        {% set url = path('in_company_training_phase_student_program_workcenter_manage_calendar_form', {'workDay': day.id}) %}
                        <td class="bg-brand-50 text-brand-900">
                            <label class="flex items-center gap-1">
                                {% if not (read_only or is_read_only()) %}<input type="checkbox" name="items[]" value="{{ day.id }}" class="selectable size-3.5 rounded border-gray-300 text-brand-600">{% endif %}
                                <a href="{{ url }}" class="text-sm font-bold hover:underline">{{ day.date|date('d') }}</a>
                            </label>
                            <div class="mt-1">
                                {% if day.hours is divisible by 100 %}
                                    {{ 'caption.hours'|trans({'count': day.hours / 100}, 'calendar') }}
                                {% else %}
                                    {{ (day.hours / 100)|number_format(2, 'format.decimal_separator'|trans({}, 'general'), 'format.thousand_separator'|trans({}, 'general')) }}
                                    {{ 'caption.hour_suffix'|trans({'count': day.hours / 100}, 'calendar') }}
                                {% endif %}
                            </div>
                        </td>
                    {% else %}
                        <td class="text-gray-400">{% if n > 0 %}{{ n }}{% endif %}</td>
                    {% endif %}
                {% endblock %}
            {% endembed %}

            <div class="mt-6 flex flex-wrap gap-2">
                {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
                {% if not (read_only or is_read_only()) %}
                    {{ m.link_button(path(add_route_name, {'studentProgramWorkcenter': student_program_workcenter.id}), 'calendar-plus', 'btn-success', 'form.add'|trans) }}
                    <twig:Ui:Button type="button" variant="secondary" icon="check-square" data-action="list#toggle" :label="'form.select_deselect'|trans" />
                    {{ m.submit_button('delete', 'trash', 'btn-danger enable-on-items', 'form.delete'|trans, true) }}
                {% endif %}
            </div>
        </form>
    </div>
{% endblock %}
