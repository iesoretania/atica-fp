{% trans_default_domain 'itp_student_program_workcenter' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/form_layout.html.twig' as fl %}

{#- Los campos que dependen de otros (empresa → centro de trabajo y actividades) los recalcula el Live Component Itp:StayForm -#}
{% block content %}
    <twig:Itp:StayForm :stay="stay.id ? stay : null" :studentProgram="stay.id ? null : stay.studentProgram" :form="form" :backUrl="last_url" :manage="manage" />
    {% if stay.id and not is_read_only() %}
        {{ fl.danger_zone('danger.title'|trans, 'danger.text'|trans, delete_url, stay.id) }}
    {% endif %}
    {% if not is_read_only() %}{% include 'ui/new_person_modal.html.twig' %}{% endif %}
{% endblock %}
