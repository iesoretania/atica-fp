{% trans_default_domain 'itp_student_program_workcenter' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}
{% import 'ui/form_layout.html.twig' as fl %}
{% import 'ui/form_checklist.html.twig' as cl %}
{% form_theme form 'ui/form_theme.html.twig' _self %}

{% block content %}
    {#- Al cambiar la empresa se recalculan sus centros de trabajo (se elige el primero) y las actividades -#}
    {% set prefix = '#student_program_workcenter_batch_' %}
    {{ form_start(form, {'attr': {
        'data-controller': 'dependent-fields',
        'data-dependent-fields-rules-value': ([{
            on: [prefix ~ 'company'],
            send: [prefix ~ 'company', prefix ~ 'workcenter', prefix ~ 'educationalTutor', prefix ~ 'additionalEducationalTutor', prefix ~ 'workTutor', prefix ~ 'additionalWorkTutor'],
            replace: [prefix ~ 'workcenter', prefix ~ 'selectedActivities'],
            selectFirst: prefix ~ 'workcenter',
        }])|json_encode,
    }}) }}
    {{ fl.grid(form, [
        ['students'],
        ['company', 'workcenter'],
        ['educationalTutor', 'additionalEducationalTutor'],
        ['workTutor', 'additionalWorkTutor'],
        ['startDate', 'endDate'],
        ['selectedActivities'],
    ], {}, 'card.title.batch'|trans) }}
    {{ m.start_button() }}
        {% if not is_read_only() %}{{ m.submit_button('submit', 'check', 'btn-success', 'form.save'|trans) }}{% endif %}
        {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
    {{ m.end_button() }}
    {{ form_end(form) }}

    {% if not is_read_only() %}{% include 'ui/new_person_modal.html.twig' %}{% endif %}
{% endblock %}

{% block _student_program_workcenter_batch_selectedActivities_widget %}
    {{ cl.checklist(form, choices, 'form.select_all'|trans, 'form.select_none'|trans, 'form.no_activity'|trans) }}
{% endblock %}
