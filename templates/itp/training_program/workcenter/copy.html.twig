{% trans_default_domain 'itp_student_program_workcenter' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/macros.html.twig' as m %}
{% form_theme form 'ui/form_theme.html.twig' %}

{% block content %}
    {{ form_start(form) }}
    {{ form_widget(form) }}
    {% for item in items %}
        <input type="hidden" name="items[]" value="{{ item.id }}">
    {% endfor %}
    <input type="hidden" name="confirm" value="ok">
    <div class="mb-4 overflow-hidden rounded-xl bg-white shadow-xs ring-1 ring-gray-200">
        <table id="list" class="w-full text-left text-sm">
            <thead class="bg-gray-50 text-xs font-semibold uppercase tracking-wide text-gray-500 [&_th]:px-4 [&_th]:py-3">
                <tr>
                    <th>{{ 'header.student'|trans }}</th>
                    <th>{{ 'header.workcenter'|trans }}</th>
                    <th>{{ 'header.educational_tutor'|trans }}</th>
                    <th>{{ 'header.work_tutor'|trans }}</th>
                    <th>{{ 'header.date_range'|trans }}</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 [&_td]:px-4 [&_td]:py-3">
                {% for item in items %}
                    <tr>
                        <td>{{ item.studentProgram.studentEnrollment }}</td>
                        <td>{{ item.workcenter }}</td>
                        <td>{{ item.educationalTutor }}</td>
                        <td>{{ item.workTutor }}</td>
                        <td class="whitespace-nowrap">
                            {% if item.startDate and item.endDate %}
                                {{ item.startDate|date('format.date'|trans({}, 'general')) }} - {{ item.endDate|date('format.date'|trans({}, 'general')) }}
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <twig:Ui:Alert type="warning" :message="'prompt.copy_confirm'|trans|nl2br" />
    {{ m.start_button() }}
        {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
        {{ m.submit_button('copy', 'copy', 'btn-success', 'form.copy_confirm'|trans) }}
    {{ m.end_button() }}
    {{ form_end(form) }}
{% endblock %}
