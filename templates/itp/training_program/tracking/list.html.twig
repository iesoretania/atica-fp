{% trans_default_domain 'itp_tracking' %}
{% extends 'generic/list.html.twig' %}
{% import 'macros.html.twig' as m %}

{% block new_action %}{% endblock %}

{% block table_header %}
    <th class="w-20">{{ 'header.student'|trans }}</th>
    <th class="w-20">{{ 'header.workcenter'|trans }}</th>
    <th class="w-10">{{ 'header.educational_tutor'|trans }}</th>
    <th class="w-10">{{ 'header.work_tutor'|trans }}</th>
    <th class="w-10">{{ 'header.date_range'|trans }}</th>
    <th class="w-10">{{ 'header.hours'|trans }}</th>
    <th class="w-20">{{ 'header.attendance'|trans }}</th>
{% endblock %}

{% block table_body %}
            {% for item in pager %}
                {% set spw = item[0] %}
                {% set url = path('in_company_training_phase_tracking_calendar_list', {'studentProgramWorkcenter': spw.id}) %}
                <tr class="clickable-row" data-href="{{ url }}">
                    <td>
                        <a href="{{ url }}">{{ spw.studentProgram.studentEnrollment }}</a>
                    </td>
                    <td>
                        {{ spw.workcenter }}
                    </td>
                    <td>
                        {{ spw.educationalTutor }}
                    </td>
                    <td>
                        {{ spw.workTutor }}
                    </td>
                    <td>
                        {% if spw.startDate and spw.endDate %}
                            {{ spw.startDate|date('format.date'|trans({}, 'general')) }} - {{ spw.endDate|date('format.date'|trans({}, 'general')) }}
                        {% endif %}
                    </td>
                    <td>
                        {{ (item.hours / 100.0)|number_format(2, 'format.decimal_separator'|trans({}, 'general'), 'format.thousand_separator'|trans({}, 'general')) }}
                    </td>
                    <td>
                        {% if item.hours %}
                            {{ item.locked_hours / 100 }}/{{ 'table.hours'|trans({'count': item.hours / 100}) }} ({{ (item.locked_hours*100/item.hours) | number_format(2, 'format.decimal_separator'|trans({}, 'general'), 'format.thousand_separator'|trans({}, 'general')) }} %)
                            {% if item.absences != 0 %}
                                - {{ 'table.absences'|trans({'count': item.absences}) }}
                                {% if item.justified_absences != 0 %}
                                    - {{ 'table.justified_absences'|trans({'count': item.justified_absences}) }}
                                {% endif %}
                            {% endif %}
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7">{{ 'table.no_items'|trans }}</td>
                </tr>
            {% endfor %}
{% endblock %}

{% block before_filter %}
    {% include 'organization/partial_academic_year.html.twig' %}
{% endblock %}

{% block after_table %}
    <div class="clearfix"></div>
    {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
</form>
{% endblock %}
