{% trans_default_domain 'itp_tracking' %}
{% set activities_total = activities|length %}
{% set submitted_activities_total = submitted_activities|length %}
{% if activities_total %}
    {% set graded_activities = 0 %}
    {% set ungraded_disabled_activities = 0 %}
    {% for activity in activities %}
        {% if activity.scaleValue is not null %}{% set graded_activities = graded_activities + 1 %}{% endif %}
        {% if activity.disabled and activity.scaleValue is null %}
            {% set activities_total = activities_total - 1 %}
            {% if activity in submitted_activities %}
                {% set submitted_activities_total = submitted_activities_total - 1 %}
            {% endif %}
        {% endif %}
    {% endfor %}
    {% set submitted_activities_total = submitted_activities_total - graded_activities %}
    {% set percentage = 100 * graded_activities / activities_total %}
    {% set worked_percentage = 100 * submitted_activities_total / activities_total %}
    <div class="progress progress-stat collapse-zone" data-toggle="collapse" data-target="#activities_stats" aria-expanded="false"
         title="{{ 'form.stats.activities_hint' | trans({'count' : graded_activities, 'total' :activities_total}) }}">
        <div class="progress-bar bg-success" role="progressbar" aria-valuenow="{{ percentage }}"
             aria-valuemin="0" aria-valuemax="100" style="width:{{ percentage }}%">
            {{ 'form.stats.activities_bar' | trans({'count' : graded_activities, 'total' :activities_total}) }}
        </div>
        <div class="progress-bar" role="progressbar" aria-valuenow="{{ worked_percentage }}"
             aria-valuemin="0" aria-valuemax="100" style="width:{{ worked_percentage }}%">
            {{ 'form.stats.activities_bar' | trans({'count' : submitted_activities_total, 'total' :activities_total}) }}
        </div>
    </div>
    <div class="collapse" id="activities_stats">
        <h3>{{ 'form.stats.activities'|trans }}: {{ 'form.stats.activities_hint' | trans({'count' : graded_activities, 'total' :activities_total}) }}</h3>
        <table class="table table-striped table-sm">
            <tbody>
            {% for item in activities %}
                <tr {% if item.scaleValue %} class="bg-success"{% elseif item.disabled %} class="bg-warning"{% elseif item in submitted_activities %} class="bg-info"{% endif %}{% if item.activity.description %} title="{{ item.activity.description }}"{% endif %}>
                    <td>
                        {% if item.scaleValue %}
                            <i class="fas fa-award text-dark fa-fw" title="{{ 'form.stats.activity.graded_hint'|trans }}"></i>
                        {% elseif item in submitted_activities %}
                            <i class="fas fa-check text-dark fa-fw" title="{{ 'form.stats.activity.worked_hint'|trans }}"></i>
                        {% else %}
                            <i class="fas fa-times text-dark fa-fw" title="{{ 'form.stats.activity.unworked_hint'|trans }}"></i>
                        {% endif %}
                        {% if item.disabled or item.scaleValue %}
                            <i class="fas fa-lock text-dark fa-fw" title="{{ 'form.stats.activity.locked_hint'|trans }}"></i>
                        {% else %}
                            <i class="fas fa-space text-dark fa-fw"></i>
                        {% endif %}
                        {{ item.activity.code }}
                    </td>
                    <td>{{ item.activity.name }}</td>
                    <td>
                        {% if item.disabled and not item.scaleValue %}
                            {{ 'table.activity_realization.graded.disabled'|trans }}
                        {% elseif selectable and item in submitted_activities %}
                            {{ item.scaleValue ? item.scaleValue : ('table.activity_realization.graded.no'|trans) }}
                        {% elseif item in submitted_activities %}
                            {{ (item.scaleValue ? 'table.activity_realization.graded.yes' : 'table.activity_realization.graded.no')|trans }}
                        {% elseif item.disabled %}
                            {{ 'table.activity_realization.graded.disabled'|trans }}
                        {% else %}
                            {{ 'table.activity_realization.graded.pending'|trans }}
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
{% if work_day_stats and work_day_stats[1] %}
    {% set percentage_locked = 100 * work_day_stats[2] / work_day_stats[1] %}
    {% set percentage_absence = 100 * work_day_stats[3] / work_day_stats[1] %}
    {% set percentage_justified_absence = 100 * work_day_stats[4] / work_day_stats[1] %}
    <div class="progress progress-stat collapse-zone" data-toggle="collapse" data-target="#hours_stats" aria-expanded="false">
        <div class="progress-bar bg-success" role="progressbar" aria-valuenow="{{ percentage_locked|number_format(2, 'format.decimal_separator'|trans({}, 'general')) }}"
             aria-valuemin="0" aria-valuemax="100" style="width:{{ percentage_locked }}%"
             title="{{ 'form.stats.hours_locked_hint' | trans({'count' : work_day_stats[2] / 100.0}) }}">
            {{ 'form.stats.hours_bar' | trans({'count' : (work_day_stats[2] / 100.0)|number_format(2, 'format.decimal_separator'|trans({}, 'general')), 'total': (work_day_stats[1] / 100.0)|number_format(2, 'format.decimal_separator'|trans({}, 'general'))}) }}
        </div>
        {% if work_day_stats[4] %}
        <div class="progress-bar bg-warning" role="progressbar" aria-valuenow="{{ percentage_justified_absence|number_format(2, 'format.decimal_separator'|trans({}, 'general')) }}"
             aria-valuemin="0" aria-valuemax="100" style="width:{{ percentage_justified_absence }}%"
             title="{{ 'form.stats.hours_justified_absence_hint' | trans({'count' : work_day_stats[4] / 100.0}) }}">
            {{ 'form.stats.hours_bar' | trans({'count' : (work_day_stats[4] / 100.0)|number_format(2, 'format.decimal_separator'|trans({}, 'general')), 'total': (work_day_stats[1] / 100.0)|number_format(2, 'format.decimal_separator'|trans({}, 'general'))}) }}
        </div>
        {% endif %}
        {% if work_day_stats[3] %}
        <div class="progress-bar bg-danger" role="progressbar" aria-valuenow="{{ percentage_absence|number_format(2, 'format.decimal_separator'|trans({}, 'general')) }}"
             aria-valuemin="0" aria-valuemax="100" style="width:{{ percentage_absence }}%"
             title="{{ 'form.stats.hours_absence_hint' | trans({'count': work_day_stats[3] / 100.0}) }}">
            {{ 'form.stats.hours_bar' | trans({'count': (work_day_stats[3] / 100.0)|number_format(2, 'format.decimal_separator'|trans({}, 'general')), 'total': (work_day_stats[1] / 100.0)|number_format(2, 'format.decimal_separator'|trans({}, 'general'))}) }}
        </div>
        {% endif %}
    </div>
    <div class="collapse" id="hours_stats">
        <h3>{{ 'form.stats.hours'|trans }}</h3>
        <table class="table table-striped table-sm">
            <tbody>
                <tr>
                    <th>{{ 'form.stats.hours.total.caption'|trans }}</th>
                    <th>{{ 'form.stats.hours.total.days'|trans({'count': work_day_stats[6]}) }}</th>
                    <th>{{ 'form.stats.hours.total.hours'|trans({'count': work_day_stats[1] / 100.0}) }}</th>
                </tr>
                <tr>
                    <td>{{ 'form.stats.hours.locked.caption'|trans }}</td>
                    <td>{{ 'form.stats.hours.locked.days'|trans({'count': work_day_stats[10], 'total': work_day_stats[6]}) }}{% if work_day_stats[6] %} ({{ (100*work_day_stats[10]/work_day_stats[6])|number_format }} %){% endif %}</td>
                    <td>{{ 'form.stats.hours.locked.hours'|trans({'count': work_day_stats[5] / 100.0, 'total': (work_day_stats[1] / 100.0)|number_format(2, 'format.decimal_separator'|trans({}, 'general'))}) }}{% if work_day_stats[1] %} ({{ (100*work_day_stats[5]/work_day_stats[1])|number_format }} %){% endif %}</td>
                </tr>
                <tr>
                    <td>{{ 'form.stats.hours.worked.caption'|trans }}</td>
                    <td>{{ 'form.stats.hours.locked.days'|trans({'count': work_day_stats[7], 'total': work_day_stats[6]}) }}{% if work_day_stats[6] %} ({{ (100*work_day_stats[7]/work_day_stats[6])|number_format }} %){% endif %}</td>
                    <td>{{ 'form.stats.hours.locked.hours'|trans({'count': work_day_stats[2] / 100.0, 'total': (work_day_stats[1] / 100.0)|number_format(2, 'format.decimal_separator'|trans({}, 'general'))}) }}{% if work_day_stats[1] %} ({{ (100*work_day_stats[2]/work_day_stats[1])|number_format }} %){% endif %}</td>
                </tr>
                <tr>
                    <td>{{ 'form.stats.hours.absence.caption'|trans }}</td>
                    <td>{{ 'form.stats.hours.locked.days'|trans({'count': work_day_stats[8], 'total': work_day_stats[6]}) }}{% if work_day_stats[6] %} ({{ (100*work_day_stats[8]/work_day_stats[6])|number_format }} %){% endif %}</td>
                    <td>{{ 'form.stats.hours.locked.hours'|trans({'count': work_day_stats[3] / 100.0, 'total': (work_day_stats[1] / 100.0)|number_format(2, 'format.decimal_separator'|trans({}, 'general'))}) }}{% if work_day_stats[1] %} ({{ (100*work_day_stats[3]/work_day_stats[1])|number_format }} %){% endif %}</td>
                </tr>
                <tr>
                    <td>{{ 'form.stats.hours.justified_absence.caption'|trans }}</td>
                    <td>{{ 'form.stats.hours.locked.days'|trans({'count': work_day_stats[9], 'total': work_day_stats[6]}) }}{% if work_day_stats[6] %} ({{ (100*work_day_stats[9]/work_day_stats[6])|number_format }} %){% endif %}</td>
                    <td>{{ 'form.stats.hours.locked.hours'|trans({'count': work_day_stats[4] / 100.0, 'total': (work_day_stats[1] / 100.0)|number_format(2, 'format.decimal_separator'|trans({}, 'general'))}) }}{% if work_day_stats[1] %} ({{ (100*work_day_stats[4]/work_day_stats[1])|number_format }} %){% endif %}</td>
                </tr>
            </tbody>
        </table>
    </div>
{% endif %}
