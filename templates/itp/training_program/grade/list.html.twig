{% trans_default_domain 'itp_grade' %}
{% extends 'ui/list.html.twig' %}
{% import 'ui/macros.html.twig' as m %}

{% block table_header %}
    <th>{{ 'header.grade'|trans }}</th>
    <th>{{ 'header.groups'|trans }}</th>
    <th>{{ 'header.target_hours'|trans }}</th>
    <th>{{ 'header.subjects'|trans }}</th>
    <th>{{ 'header.learning_outcomes'|trans }}</th>
    <th>{{ 'header.criteria'|trans }}</th>
    <th>{{ 'header.activities'|trans }}</th>
    <th colspan="3"></th>
{% endblock %}

{% block table_body %}
    {% set grade_hours_total = training_program.totalHours %}
    {% for item in pager %}
        {% set program_grade = item.program_grade %}
        {% set url = path('in_company_training_phase_group_list', {'programGrade': program_grade.id}) %}
        <tr class="clickable-row" data-href="{{ url }}">
            <td class="align-top"><a href="{{ url }}" class="font-medium text-gray-900 hover:text-brand-700">{{ program_grade.grade.name }} ({{ program_grade.grade.training.academicYear }})</a></td>
            <td class="align-top">{% for group in program_grade.grade.groups %}{{ group.name }} ({{ program_grade.grade.training.academicYear }}){% if not loop.last %}, {% endif %}{% endfor %}</td>
            <td class="align-top whitespace-nowrap">
                {{ (program_grade.targetHours / 100)|number_format(2, 'format.decimal_separator'|trans({}, 'general'), 'format.thousand_separator'|trans({}, 'general')) }}
                {%- if grade_hours_total -%}
                    /{{ (grade_hours_total / 100)|number_format(2, 'format.decimal_separator'|trans({}, 'general'), 'format.thousand_separator'|trans({}, 'general')) }}
                    ({{ (program_grade.targetHours * 100 / grade_hours_total)|number_format(2, 'format.decimal_separator'|trans({}, 'general'), 'format.thousand_separator'|trans({}, 'general')) }} %)
                {% endif %}
            </td>
            <td class="align-top">{{ item.selected_subjects }}/{{ item.total_subjects }}</td>
            <td class="align-top">
                {{ item.selected_learning_outcomes }}/{{ item.total_learning_outcomes }}
                {% if item.total_subjects %}<br>({{ (item.weight * 100)|number_format(2, 'format.decimal_separator'|trans({}, 'general'), 'format.thousand_separator'|trans({}, 'general')) }} %){% endif %}
            </td>
            <td class="align-top">{{ item.selected_criteria }}/{{ item.total_criteria }}</td>
            <td class="align-top">{{ program_grade.activities|length }}</td>
            <td class="text-right">
                <div class="inline-flex flex-wrap justify-end gap-2">
                    {{ m.link_button(path('in_company_training_phase_activity_list', {'programGrade': program_grade.id}), 'book', 'btn-info btn-sm', 'table.activities'|trans) }}
                    {{ m.link_button(path('in_company_training_phase_company_list', {'programGrade': program_grade.id}), 'industry', 'btn-info btn-sm', 'table.companies'|trans) }}
                    {{ m.link_button(path('in_company_training_phase_grade_detail_edit', {'programGrade': program_grade.id}), 'list-ol', 'btn-info btn-sm', 'table.target_hours'|trans) }}
                </div>
            </td>
        </tr>
    {% else %}
        <tr><td colspan="8" class="py-8 text-center text-gray-500">{{ 'table.no_items'|trans }}</td></tr>
    {% endfor %}
{% endblock %}

{#- Totales (cuando hay más de un nivel) -#}
{% block table_footer %}
    {% if pager.count > 1 %}
        {% set percentage_total = 0 %}
        {% set percentage_sum = 0 %}
        {% set hours_sum = 0 %}
        {% set subjects_total = 0 %}
        {% set subjects_sum = 0 %}
        {% set learning_outcomes_total = 0 %}
        {% set learning_outcomes_sum = 0 %}
        {% set criteria_total = 0 %}
        {% set criteria_sum = 0 %}
        {% set activities_sum = 0 %}
        {% set grade_hours_total = training_program.totalHours %}
        {% for item in pager %}
            {% set program_grade = item.program_grade %}
            {% set hours_sum = hours_sum + program_grade.targetHours %}
            {% set subjects_total = subjects_total + item.total_subjects %}
            {% set subjects_sum = subjects_sum + item.selected_subjects %}
            {% set learning_outcomes_total = learning_outcomes_total + item.total_learning_outcomes %}
            {% set learning_outcomes_sum = learning_outcomes_sum + item.selected_learning_outcomes %}
            {% set criteria_total = criteria_total + item.total_criteria %}
            {% set criteria_sum = criteria_sum + item.selected_criteria %}
            {% set activities_sum = activities_sum + program_grade.activities|length %}
            {% if item.total_subjects %}
                {% set percentage_sum = percentage_sum + item.weight %}
                {% set percentage_total = percentage_total + 1 %}
            {% endif %}
        {% endfor %}
        <tfoot class="border-t border-gray-200 bg-gray-50 text-sm font-medium [&_td]:px-4 [&_td]:py-3">
            <tr>
                <td colspan="2" class="text-right">{{ 'header.stats'|trans }}</td>
                <td class="whitespace-nowrap">
                    {{ (hours_sum / 100)|number_format(2, 'format.decimal_separator'|trans({}, 'general'), 'format.thousand_separator'|trans({}, 'general')) }}
                    {%- if grade_hours_total -%}
                        /{{ (grade_hours_total / 100)|number_format(2, 'format.decimal_separator'|trans({}, 'general'), 'format.thousand_separator'|trans({}, 'general')) }}
                        ({{ (hours_sum * 100 / grade_hours_total)|number_format(2, 'format.decimal_separator'|trans({}, 'general'), 'format.thousand_separator'|trans({}, 'general')) }} %)
                    {% endif %}
                </td>
                <td>{{ subjects_sum }}/{{ subjects_total }}</td>
                <td>
                    {{ learning_outcomes_sum }}/{{ learning_outcomes_total }}
                    {% if percentage_total %}<br>({{ (percentage_sum * 100 / percentage_total)|number_format(2, 'format.decimal_separator'|trans({}, 'general'), 'format.thousand_separator'|trans({}, 'general')) }} %){% endif %}
                </td>
                <td>{{ criteria_sum }}/{{ criteria_total }}</td>
                <td>{{ activities_sum }}</td>
                <td></td>
            </tr>
        </tfoot>
    {% endif %}
{% endblock %}

{% block filter %}{% endblock %}

{% block after_table %}
    {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
{% endblock %}
