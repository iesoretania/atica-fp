{% trans_default_domain 'itp_student_program' %}
{% extends 'ui/list.html.twig' %}
{% import 'ui/macros.html.twig' as m %}

{% block new_action %}{% endblock %}

{% block table_header %}
    <th><label class="flex items-center gap-2"><input type="checkbox" data-list-target="selectAll" class="size-4 rounded border-gray-300 text-brand-600"> {{ 'header.student_name'|trans }}</label></th>
    <th>{{ 'header.tutors'|trans }}</th>
    <th>{{ 'header.date_range'|trans }}</th>
    <th>{{ 'header.activities'|trans }}</th>
    <th>{{ 'header.hours'|trans }}</th>
    <th></th>
{% endblock %}

{% block table_body %}
    {% for data in pager %}
        {% set item = data[0] %}
        {% set url = path('in_company_training_phase_student_program_workcenter_list', {'studentProgram': item.id}) %}
        <tr class="clickable-row" data-href="{{ url }}">
            <td class="align-top">
                <label class="flex items-center gap-2">
                    <input type="checkbox" name="items[]" value="{{ item.id }}" class="selectable size-4 rounded border-gray-300 text-brand-600">
                    <a href="{{ url }}" class="font-medium text-gray-900 hover:text-brand-700">{{ item.studentEnrollment.person.lastFirstName }}</a>
                    {% if item.isAuthorizationNeeded %}<span title="{{ item.authorizationDescription }}"><twig:Ui:Icon name="user-shield" class="size-3.5 text-gray-500" /></span>{% endif %}
                    {% if item.isAdaptationNeeded %}<span title="{{ item.adaptationDescription }}"><twig:Ui:Icon name="universal-access" class="size-3.5 text-gray-500" /></span>{% endif %}
                </label>
            </td>
            <td class="align-top">
                {% set student_program_workcenters = item.studentProgramWorkcenters %}
                {% set multiple = student_program_workcenters | length > 1 %}
                {% if multiple %}<ul class="list-disc space-y-1 pl-4">{% endif %}
                {% for student_program_workcenter in student_program_workcenters %}
                    {% if multiple %}<li>{% endif %}
                    <i>{{ student_program_workcenter.workcenter }}</i>:
                    {{ student_program_workcenter.educationalTutor }} / {{ student_program_workcenter.workTutor }}
                    {% if multiple %}</li>{% endif %}
                {% endfor %}
                {% if multiple %}</ul>{% endif %}
            </td>
            <td class="align-top whitespace-nowrap">
                {% if data.min_start_date and data.max_end_date %}
                    {{ data.min_start_date|date('format.date'|trans({}, 'general')) }} - {{ data.max_end_date|date('format.date'|trans({}, 'general')) }}
                {% endif %}
            </td>
            <td class="align-top">{{ activities_stats[item.studentEnrollment.id].total_activities }}/{{ training_program_total_activities }}</td>
            <td class="align-top">{{ (work_days_stats[item.studentEnrollment.id].total_hours/100)|number_format(2, 'format.decimal_separator'|trans({}, 'general'), 'format.thousand_separator'|trans({}, 'general')) }}</td>
            <td class="text-right">{{ m.link_button(path('in_company_training_phase_student_program_edit', {'studentProgram': item.id}), 'info-circle', 'btn-info btn-sm', 'form.edit'|trans) }}</td>
        </tr>
    {% else %}
        <tr><td colspan="6" class="py-8 text-center text-gray-500">{{ 'table.no_items'|trans }}</td></tr>
    {% endfor %}
{% endblock %}

{% block form_action %}{{ path('in_company_training_phase_student_program_operation', {'programGroup': program_group.id}) }}{% endblock %}

{% block pagerfanta %}
    {{ pagerfanta(pager, 'tailwind', {'prev_message': 'paginator.prev'|trans([], 'general'), 'next_message': 'paginator.next'|trans([], 'general'), 'routeParams': {'programGroup': program_group.id}}) }}
{% endblock %}

{% block after_table %}
    {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
    {% if not is_read_only() %}{{ m.submit_button('delete', 'trash', 'btn-danger enable-on-items', 'form.delete'|trans, true) }}{% endif %}
{% endblock %}
