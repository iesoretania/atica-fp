{% trans_default_domain 'itp_student_program' %}
{% extends 'generic/list.html.twig' %}
{% import 'macros.html.twig' as m %}

{% block new_action %}{% endblock %}

{% block table_header %}
    <th class="w-20"><label><input type="checkbox" id="select"> {{ 'header.student_name'|trans }}</label></th>
    <th class="w-40">{{ 'header.tutors'|trans }}</th>
    <th class="w-10">{{ 'header.date_range'|trans }}</th>
    <th class="w-5">{{ 'header.activities'|trans }}</th>
    <th class="w-5">{{ 'header.hours'|trans }}</th>
    <th class="w-20"></th>
{% endblock %}

{% block table_body %}
            {% for data in pager %}
                {% set item = data[0] %}
                {% set url = path('in_company_training_phase_student_program_workcenter_list', {'studentProgram': item.id}) %}
                <tr class="clickable-row" data-href="{{ url }}">
                    <td>
                        <label><input type="checkbox" name="items[]" value="{{ item.id }}" class="selectable">
                        <a href="{{ url }}">{{ item.studentEnrollment.person.lastFirstName }}</a>
                        </label>
                        <span class="float-right">
                        {% if item.isAuthorizationNeeded %}
                            <i class="fa fa-user-shield" title="{{ item.authorizationDescription }}"></i>
                        {% endif %}
                        {% if item.isAdaptationNeeded %}
                            <i class="fa fa-universal-access" title="{{ item.adaptationDescription }}"></i>
                        {% endif %}
                        </span>
                    </td>
                    <td>
                        {% set student_program_workcenters = item.studentProgramWorkcenters %}
                        {% set list = student_program_workcenters | length > 1 %}
                        {% if list %}<ul class="pl-3 mb-0">{% endif %}
                        {% for student_program_workcenter in student_program_workcenters %}
                            {% if list %}<li>{% endif %}
                            <i>{{ student_program_workcenter.workcenter }}</i>:
                            {{ student_program_workcenter.educationalTutor }} / {{ student_program_workcenter.workTutor }}
                            {% if list %}</li>{% endif %}
                        {% endfor %}
                        {% if list %}</ul>{% endif %}
                    </td>
                    <td>
                        {% if data.min_start_date and data.max_end_date %}
                            {{ data.min_start_date|date('format.date'|trans({}, 'general')) }} - {{ data.max_end_date|date('format.date'|trans({}, 'general')) }}
                        {% endif %}
                    </td>
                    <td>
                        {{ activities_stats[item.studentEnrollment.id].total_activities }}/{{ training_program_total_activities }}
                    </td>
                    <td>
                        {{ (work_days_stats[item.studentEnrollment.id].total_hours/100)|number_format(2, 'format.decimal_separator'|trans({}, 'general'), 'format.thousand_separator'|trans({}, 'general')) }}
                    </td>
                    <td>
                        {{ m.link_button(path('in_company_training_phase_student_program_edit', {'studentProgram': item.id}), 'info-circle', 'btn-info btn-sm btn-block', 'form.edit'|trans) }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8">{{ 'table.no_items'|trans }}</td>
                </tr>
            {% endfor %}
{% endblock %}

{% block before_table %}
    <form action="{{ path('in_company_training_phase_student_program_operation', {'programGroup': program_group.id}) }}" method="post">
{% endblock %}

{% block after_table %}
    <div class="clearfix"></div>
    {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
    {{ m.submit_button('delete', 'trash', 'btn-danger enable-on-items', 'form.delete'|trans) }}
</form>
{% endblock %}
