{% trans_default_domain 'itp_training_program' %}
{% extends 'generic/list.html.twig' %}
{% import 'macros.html.twig' as m %}

{% block new_action %}{% endblock %}

{% block table_header %}
    <th class="w-30">{{ 'header.name'|trans }}</th>
    <th class="w-10">{{ 'header.modality'|trans }}</th>
    <th class="w-30">{{ 'header.groups'|trans }}</th>
    <th class="w-10">{{ 'header.target_hours'|trans }}</th>
    <th class="w-20"></th>
{% endblock %}

{% block table_body %}
            {% for item in pager %}
                {% set url = path(route_name, {'trainingProgram': item.id, 'academicYear': academic_year.id}) %}
                <tr>
                    <td>
                        {{ item.name }}
                        {% if item.locked %} <i class="fa fa-lock"></i>{% endif %}
                    </td>
                    <td>
                        {{ ('table.modality.' ~ item.modality) | trans }}
                    </td>
                    <td>
                        {% for program_grade in item.trainingProgramGrades %}{% for group in program_grade.grade.groups %}{{ group.name }} ({{ group.grade.training.academicYear }}){% if not loop.last %}, {% endif %}{% endfor %}{% if not loop.last %}, {% endif %}{% endfor %}
                    </td>
                    <td>
                        {{ (item.targetHours / 100)|number_format(2, 'format.decimal_separator'|trans({}, 'general'), 'format.thousand_separator'|trans({}, 'general')) -}}
                        {%- if item.totalHours %}/{{ (item.totalHours / 100)|number_format(2, 'format.decimal_separator'|trans({}, 'general'), 'format.thousand_separator'|trans({}, 'general')) }} ({{ (item.targetHours * 100 / item.totalHours)|number_format(2, 'format.decimal_separator'|trans({}, 'general'), 'format.thousand_separator'|trans({}, 'general')) }} %){% endif %}
                    </td>
                    <td>
                        {{ m.link_button_new(url, 'file-alt', 'btn-info btn-sm btn-block', 'form.report'|trans) }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">{{ 'table.no_items'|trans }}</td>
                </tr>
            {% endfor %}
{% endblock %}

{% block before_filter %}
    {% include 'organization/partial_academic_year.html.twig' %}
{% endblock %}

{% block pagerfanta %}
    {{ pagerfanta(pager, 'twitter_bootstrap4', {'prev_message': 'paginator.prev'|trans([], 'general'), 'next_message': 'paginator.next'|trans([], 'general'), 'routeParams': {'academicYear': academic_year.id }}) }}
{% endblock %}

{% block after_table %}
    <div class="clearfix"></div>
    {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
{% endblock %}
