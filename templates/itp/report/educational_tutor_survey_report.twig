{% trans_default_domain 'itp_report' %}

{% extends 'itp/report/base_survey.twig' %}

{% macro row(data, additional) %}
    {% for datum in data %}
        <tr>
            {% if loop.first %}
                <td rowspan="{{ data|length }}">
                    {{ datum.educationalTutor }}
                    {% if datum.additionalEducationalTutor %}
                        <br>{{ datum.additionalEducationalTutor }}
                    {% endif %}
                </td>
            {% endif %}
            <td>
                {{ datum.studentProgram.studentEnrollment }}
            </td>
            <td>
                {{ datum.workcenter }}
            </td>
            {% if loop.first %}
                <td rowspan="{{ data|length }}" style="text-align: center">
                    {{ (additional ? 'report.status.answered' : 'report.status.unanswered')|trans }}
                </td>
            {% endif %}
        </tr>
    {% endfor %}
{% endmacro %}

{% block title %}{{ 'title.educational_tutor_survey'|trans }} - {{ training_program }} ({{ academic_year }}){% endblock %}

{% block body %}
    <h1>{{ organization }} - {{ training_program }} ({{ academic_year }})</h1>
    <h2>{{ 'title.educational_tutor_survey'|trans }}</h2>
    <h3>{{ 'title.educational_tutor_survey.summary'|trans }}</h3>
    <table class="survey">
        <thead>
        <tr>
            <th width="30%">{{ 'header.educational_tutor'|trans }}</th>
            <th width="30%">{{ 'header.students'|trans }}</th>
            <th width="30%">{{ 'header.workcenter'|trans }}</th>
            <th width="10%">{{ 'header.status'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% set total = 0 %}
        {% set answered = 0 %}
        {% set last_id = 0 %}
        {% set data = [] %}
        {% set additional = 0 %}
        {% for item in educational_tutor_stats %}
            {% if last_id != item[0].educationalTutor.id %}
                {% if last_id != 0 %}{{ _self.row(data, additional) }}{% endif %}
                {% set last_id = item[0].educationalTutor.id %}
                {% set data = [item[0]] %}
                {% set answered = answered + (additional > 0 ? 1 : 0) %}
                {% set additional = item[1] %}
                {% set total = total + 1 %}
            {% else %}
                {% set data = data|merge([item[0]]) %}
                {% set additional = additional + item[1] %}
            {% endif %}
        {% else %}
            <tr>
                <td colspan="4">{{ 'report.no_surveys'|trans }}</td>
            </tr>
        {% endfor %}
        {% if last_id != 0 %}
            {{ _self.row(data, additional) }}
            {% set answered = answered + (additional > 0 ? 1 : 0) %}
        {% endif %}
        </tbody>
        {% if total %}
            <tfoot>
            <tr>
                <td class="right" colspan="4"><b>{{ 'report.answered_surveys'|trans }} {{ answered }}/{{ total }}
                        ({{ (answered*100/total)|number_format(2, 'format.decimal_separator'|trans({}, 'general')) }}
                        %)</b></td>
            </tr>
            </tfoot>
        {% endif %}
    </table>

    {% include 'itp/report/survey_stats_partial.html.twig' %}

    {% for educational_tutor_survey in educational_tutor_surveys %}
        <pagebreak></pagebreak>
        <h1>{{ organization }} - {{ training_program }} ({{ academic_year }})</h1>
        <h2>{{ 'title.educational_tutor_survey'|trans }}</h2>
        <table class="data">
            <tr>
                <td class="info">{{ 'report.work_tutor'|trans }}</td>
                <td>{{ educational_tutor_survey.teacher }}</td>
            </tr>
            <tr>
                <td class="info">{{ 'report.answered_on'|trans }}</td>
                <td>{{ educational_tutor_survey.answeredSurvey.timestamp|date('format.datetime'|trans({}, 'general')) }}</td>
            </tr>
        </table>

        {% set answered_survey = educational_tutor_survey.answeredSurvey %}
        {% include 'itp/report/answered_survey_responses_partial.html.twig' %}
    {% endfor %}
{% endblock %}
