{% trans_default_domain 'itp_attendance_report' %}

{% extends 'layout/base_report.html.twig' %}

{% block style %}
    <style>
        @page {
            margin-top: 3cm;
            margin-bottom: 6cm;
            margin-left: 1.5cm;
            margin-right: 1.5cm;
            odd-footer-name: html_footer;
            even-footer-name: html_footer;
        }
        body {
            font-family: sans-serif;
            font-size: 12px;
        }
    </style>

{% endblock %}

{% block body %}

<htmlpagefooter name="footer">
    <div style="page-break-inside: avoid; text-align: center; padding-bottom: 1cm; font-weight: bold">
        <div>{{ 'report.signature'|trans({
                'city': student_program_workcenter.workCenter.city,
                'day': student_program_workcenter.endDate|date('d', false),
                'month_string': ('r_month' ~ (student_program_workcenter.endDate|date('m', false) - 1))|trans({}, 'calendar'),
                'year': student_program_workcenter.endDate|date('Y', false)
            }) }}</div>
        <table style="margin-top: 0.5cm; vertical-align: top">
            <tr style="width: 100%">
                <td width="83%" style="text-align: left">
                    {{ 'report.work_tutor.signature'|trans }}<br /><br /><br /><br /><br /><br /><br /><br />
                </td>
                <td style="text-align: right">
                    {{ 'report.work_tutor.stamp'|trans }}
                </td>
            </tr>
            <tr>
                <td>{{ 'report.signed'|trans }} {{ student_program_workcenter.workTutor }}</td>
                <td style="text-align:right">{{ 'report.page'|trans({'page': '{PAGENO}', 'total': '{nbpg}'}) }}</td>
            </tr>
        </table>

    </div>
</htmlpagefooter>

<p style="text-align: center; font-weight: bold">
    {{ 'report.title'|trans }}
</p>

{% set column = 0 %}
<table style="width: 100%; vertical-align: top; font-weight: bold">
    <tr>
        <td width="50%">{{ 'report.organization.title'|trans }} {{ academic_year.organization }}</td>
        <td width="50%">{{ 'report.academic_year.title'|trans }} {{ academic_year }}</td>
    </tr>
    <tr>
        <td colspan="2">{{ 'report.student.title'|trans }} {{ student_program_workcenter.studentProgram.studentEnrollment }}</td>
    </tr>
    <tr>
        <td colspan="2">{{ 'report.workcenter.title'|trans }} {{ student_program_workcenter.workcenter }}</td>
    </tr>
    <tr>
        <td colspan="2">{{ 'report.work_tutor.title'|trans }} {{ student_program_workcenter.workTutor }}</td>
    </tr>
</table>
<p></p>
<table style="border: 1px solid; border-spacing: 0; width: 100%; vertical-align: middle; margin-bottom: 0.3cm">
    <thead>
        <tr>
            <th width="11%" style="border: 1px solid; background-color: #DDDDDD; text-align: center; font-size: 110%; font-weight: bold">{{ 'report.date.header'|trans }}</th><th width="7%" style="border: 1px solid; background-color: #DDDDDD; text-align: center; font-size: 110%; font-weight: bold">{{ 'report.in.header'|trans }}</th><th width="7%" style="border: 1px solid; background-color: #DDDDDD; text-align: center; font-size: 110%; font-weight: bold">{{ 'report.out.header'|trans }}</th>
            <th width="11%" style="border: 1px solid; background-color: #DDDDDD; text-align: center; font-size: 110%; font-weight: bold">{{ 'report.date.header'|trans }}</th><th width="7%" style="border: 1px solid; background-color: #DDDDDD; text-align: center; font-size: 110%; font-weight: bold">{{ 'report.in.header'|trans }}</th><th width="7%" style="border: 1px solid; background-color: #DDDDDD; text-align: center; font-size: 110%; font-weight: bold">{{ 'report.out.header'|trans }}</th>
            <th width="11%" style="border: 1px solid; background-color: #DDDDDD; text-align: center; font-size: 110%; font-weight: bold">{{ 'report.date.header'|trans }}</th><th width="7%" style="border: 1px solid; background-color: #DDDDDD; text-align: center; font-size: 110%; font-weight: bold">{{ 'report.in.header'|trans }}</th><th width="7%" style="border: 1px solid; background-color: #DDDDDD; text-align: center; font-size: 110%; font-weight: bold">{{ 'report.out.header'|trans }}</th>
            <th width="11%" style="border: 1px solid; background-color: #DDDDDD; text-align: center; font-size: 110%; font-weight: bold">{{ 'report.date.header'|trans }}</th><th width="7%" style="border: 1px solid; background-color: #DDDDDD; text-align: center; font-size: 110%; font-weight: bold">{{ 'report.in.header'|trans }}</th><th width="7%" style="border: 1px solid; background-color: #DDDDDD; text-align: center; font-size: 110%; font-weight: bold">{{ 'report.out.header'|trans }}</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            {% set total = 0 %}
            {% set hours = 0 %}
            {% for workday in student_program_workcenter.workdays %}
                {% if workday.locked == 1 and workday.absence == 0 and (workday.activities.count() or workday.otherActivities is not empty) %}
                    {% set total = total + 1 %}
                    {% set hours = hours + workday.timeHours %}
                    <td style="border: 1px solid; padding: 0.1cm; text-align: center">{{ workday.date|date('report.date_format'|trans) }}</td>
                    {% if workday.startTime1 and workday.endTime1 %}
                        <td style="border: 1px solid; padding: 0.1cm; text-align: center">{{ workday.startTime1|default('report.no_data'|trans) }}</td>
                        <td style="border: 1px solid; padding: 0.1cm; text-align: center">{{ workday.endTime1|default('report.no_data'|trans) }}</td>
                    {% else %}
                        <td style="border: 1px solid; padding: 0.1cm; text-align: center">{{ 'report.no_data'|trans }}</td>
                        <td style="border: 1px solid; padding: 0.1cm; text-align: center">{{ 'report.no_data'|trans }}</td>
                    {% endif %}
                    {% set column = column + 1 %}
                    {% if column == 4 %}
                        {% set column = 0 %}
                        </tr><tr>
                    {% endif %}
                    {% if workday.startTime2 and workday.endTime2 %}
                        <td style="border: 1px solid; padding: 0.1cm; text-align: center">{{ workday.date|date('report.date_format'|trans) }}</td>
                        <td style="border: 1px solid; padding: 0.1cm; text-align: center">{{ workday.startTime2|default('report.no_data'|trans) }}</td>
                        <td style="border: 1px solid; padding: 0.1cm; text-align: center">{{ workday.endTime2|default('report.no_data'|trans) }}</td>
                        {% set column = column + 1 %}
                        {% if column == 4 %}
                            {% set column = 0 %}
                            </tr><tr>
                        {% endif %}
                    {% endif %}
                {% endif %}
            {% endfor %}
        </tr>
    </tbody>
</table>

<table width="100%">
    <tr>
        <td width="50%">
            <p style="text-align: left; font-weight: bold">
                {{ 'report.days_total.title'|trans }} {{ total }}
            </p>
        </td>
        <td width="50%" style="text-align: right">
            <p style="font-weight: bold">
                {{ 'report.hours_total.title'|trans }} {{ (hours / 100.0) | number_format(2, 'format.decimal_separator'|trans({}, 'general'), 'format.thousand_separator'|trans({}, 'general')) }}
            </p>
        </td>
    </tr>
</table>
{% endblock %}
