{% trans_default_domain 'itp_tracking' %}
{#- Barra de progreso de las actividades (valoradas y trabajadas); al pulsarla se despliega el detalle. Cada tramo de la barra es solo color y el texto va en una leyenda, para que no se recorte. -#}
{% set activities_total = activities|length %}
{% set submitted_activities_total = submitted_activities|length %}
{% if activities_total %}
    {% set graded_activities = 0 %}
    {% for activity in activities %}
        {% if activity.scaleValue is not null %}{% set graded_activities = graded_activities + 1 %}{% endif %}
        {% if activity.disabled and activity.scaleValue is null %}
            {% set activities_total = activities_total - 1 %}
            {% if activity in submitted_activities %}
                {% set submitted_activities_total = submitted_activities_total - 1 %}
            {% endif %}
        {% endif %}
    {% endfor %}
    {% set submitted_activities_total = submitted_activities_total - graded_activities %}
    {% set percentage = activities_total ? 100 * graded_activities / activities_total : 0 %}
    {% set worked_percentage = activities_total ? 100 * submitted_activities_total / activities_total : 0 %}
    <details class="mb-4 rounded-xl bg-white shadow-xs ring-1 ring-gray-200">
        <summary class="cursor-pointer list-none p-3" title="{{ 'form.stats.activities_hint' | trans({'count' : graded_activities, 'total' : activities_total}) }}">
            <div class="flex h-3 overflow-hidden rounded-full bg-gray-100">
                <div role="progressbar" aria-valuenow="{{ percentage|round }}" aria-valuemin="0" aria-valuemax="100" style="width: {{ percentage }}%" class="h-full bg-emerald-600"></div>
                <div role="progressbar" aria-valuenow="{{ worked_percentage|round }}" aria-valuemin="0" aria-valuemax="100" style="width: {{ worked_percentage }}%" class="h-full bg-brand-500"></div>
            </div>
            <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-gray-700">
                <li class="inline-flex items-center gap-1.5"><span class="size-2.5 shrink-0 rounded-full bg-emerald-600" aria-hidden="true"></span>{{ 'form.stats.activities_bar' | trans({'count' : graded_activities, 'total' : activities_total}) }}</li>
                <li class="inline-flex items-center gap-1.5"><span class="size-2.5 shrink-0 rounded-full bg-brand-500" aria-hidden="true"></span>{{ 'form.stats.activities_bar' | trans({'count' : submitted_activities_total, 'total' : activities_total}) }}</li>
            </ul>
        </summary>
        <div class="border-t border-gray-100 p-4">
            <h2 class="mb-2 text-sm font-semibold text-gray-900">{{ 'form.stats.activities'|trans }}: {{ 'form.stats.activities_hint' | trans({'count' : graded_activities, 'total' : activities_total}) }}</h2>
            <table class="w-full text-left text-sm [&_td]:px-3 [&_td]:py-2 [&_tr]:border-b [&_tr]:border-gray-100">
                <tbody>
                    {% for item in activities %}
                        <tr class="{% if item.scaleValue %}bg-emerald-50{% elseif item.disabled %}bg-amber-50{% elseif item in submitted_activities %}bg-brand-50{% endif %}"{% if item.activity.description %} title="{{ item.activity.description }}"{% endif %}>
                            <td class="whitespace-nowrap">
                                {% if item.scaleValue %}
                                    <span title="{{ 'form.stats.activity.graded_hint'|trans }}"><twig:Ui:Icon name="award" class="mr-1 inline size-3.5 text-gray-700" /></span>
                                {% elseif item in submitted_activities %}
                                    <span title="{{ 'form.stats.activity.worked_hint'|trans }}"><twig:Ui:Icon name="check" class="mr-1 inline size-3.5 text-gray-700" /></span>
                                {% else %}
                                    <span title="{{ 'form.stats.activity.unworked_hint'|trans }}"><twig:Ui:Icon name="times" class="mr-1 inline size-3.5 text-gray-700" /></span>
                                {% endif %}
                                {% if item.disabled or item.scaleValue %}
                                    <span title="{{ 'form.stats.activity.locked_hint'|trans }}"><twig:Ui:Icon name="lock" class="mr-1 inline size-3.5 text-gray-700" /></span>
                                {% endif %}
                                {{ item.activity.code }}
                            </td>
                            <td>{{ item.activity.name }}</td>
                            <td>
                                {% if item.disabled and not item.scaleValue %}
                                    {{ 'table.activity_realization.graded.disabled'|trans }}
                                {% elseif selectable and item in submitted_activities %}
                                    {{ item.scaleValue ? item.scaleValue : ('table.activity_realization.graded.no'|trans) }}
                                {% elseif item in submitted_activities %}
                                    {{ (item.scaleValue ? 'table.activity_realization.graded.yes' : 'table.activity_realization.graded.no')|trans }}
                                {% elseif item.disabled %}
                                    {{ 'table.activity_realization.graded.disabled'|trans }}
                                {% else %}
                                    {{ 'table.activity_realization.graded.pending'|trans }}
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </details>
{% endif %}
