{% trans_default_domain 'itp_contact' %}
{% extends 'ui/layout.html.twig' %}
{% import 'ui/form_layout.html.twig' as fl %}

{#- Los campos que dependen de otros (fecha y centro → planes de formación → alumnado) los recalcula el Live Component Itp:ContactForm -#}
{% block content %}
    <twig:Itp:ContactForm :contactEntity="contact.id ? contact : null" :teacher="contact.id ? null : contact.teacher" :form="form" :backUrl="path('in_company_training_phase_contact_list', {'academicYear': academic_year.id})" />
    {% if contact.id and not read_only %}
        {{ fl.danger_zone('danger.title'|trans, 'danger.text'|trans, path('in_company_training_phase_contact_operation'), contact.id) }}
    {% endif %}
{% endblock %}
