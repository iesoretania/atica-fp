{% extends 'ui/delete.html.twig' %}
{% set domain = 'itp_travel_expense' %}
{% trans_default_domain 'itp_travel_expense' %}

{% block delete_header %}
    <th>{{ 'header.travel_route'|trans }}</th>
    <th>{{ 'header.training_programs'|trans }}</th>
    <th>{{ 'header.distance'|trans }}</th>
    <th>{{ 'header.other_expenses'|trans }}</th>
    <th>{{ 'header.verified'|trans }}</th>
{% endblock %}

{% block delete_rows %}
    {% for item in items %}
        <tr>
            <td>{{ item.travelRoute }}</td>
            <td>{{ item.trainingPrograms.count() }}</td>
            <td class="whitespace-nowrap">{{ item.travelRoute.distance ? item.travelRoute.distance|number_format ~ ' ' ~ 'suffix.distance'|trans({}, 'general') : '---' }}</td>
            <td>{{ item.otherExpenses|trans() }}</td>
            <td>{{ (item.travelRoute.verified ? 'table.verified_yes' : 'table.verified_no')|trans }}</td>
        </tr>
    {% endfor %}
{% endblock %}
