{% trans_default_domain 'itp_survey' %}
{% extends 'generic/list.html.twig' %}
{% import 'macros.html.twig' as m %}

{% block new_action %}{% endblock %}

{% block table_header %}
    <th>{{ 'header.student'|trans }}</th>
    <th>{{ 'header.training_program'|trans }}</th>
    <th>{{ 'header.workcenter'|trans }}</th>
    <th>{{ 'header.work_tutor'|trans }}</th>
    <th>{{ 'header.dates'|trans }}</th>
    <th>{{ 'header.status'|trans }}</th>
{% endblock %}

{% macro row(data, additional) %}
    {% set url = path('work_linked_training_survey_student_form', {'id': data[0].id}) %}
    {% for datum in data %}
        <tr>
            {% if loop.first %}
                <td rowspan="{{ data|length }}">
                    <a href="{{ url }}">{{ datum.studentEnrollment }}</a>
                </td>
                <td rowspan="{{ data|length }}">
                    {{ datum.project }}
                    {% if datum.project.locked %} <i class="fa fa-lock"></i>{% endif %}
                </td>
            {% endif %}
            <td>
                {{ datum.workcenter }}
            </td>
            <td>
                {{ datum.workTutor }}
            </td>
            <td>
                {{ datum.startDate ? datum.startDate|date('format.date'|trans({}, 'general')) }}
                {% if datum.endDate %} - {{ datum.endDate|date('format.date'|trans({}, 'general')) }}{% endif %}
            </td>
            {% if loop.first %}
                <td rowspan="{{ data|length }}">
                    {{ (additional ? 'table.answered.yes' : 'table.answered.no')|trans }}
                </td>
            {% endif %}
        </tr>
    {% endfor %}
{% endmacro %}

{% block table_body %}
    {% for data in pager %}
        {% set item = data[0] %}
        {% set url = path('in_company_training_phase_survey_student_form', {'id': item.id}) %}
        <tr>
            <td>
                <a href="{{ url }}">{{ item.studentProgram.studentEnrollment }}</a>
            </td>
            <td>
                {{ item.studentProgram.programGroup.programGrade.trainingProgram }}
            </td>
            <td>
                {{ item.workcenter }}
            </td>
            <td>
                {{ item.workTutor }}
            </td>
            <td>
                {{ item.startDate ? item.startDate|date('format.date'|trans({}, 'general')) }}
                {% if item.endDate %} - {{ item.endDate|date('format.date'|trans({}, 'general')) }}{% endif %}
            </td>
            <td>
                {{ data[1] ? 'table.answered.yes'|trans : 'table.answered.no'|trans }}
            </td>
        </tr>
    {% else %}
        <tr>
            <td colspan="6">{{ 'table.no_items'|trans }}</td>
        </tr>
    {% endfor %}
{% endblock %}

{% block before_filter %}
    {% include 'organization/partial_academic_year.html.twig' %}
{% endblock %}

{% block pagerfanta %}
    {{ pagerfanta(pager, 'twitter_bootstrap4', {'prev_message': 'paginator.prev'|trans([], 'general'), 'next_message': 'paginator.next'|trans([], 'general'), 'routeParams': {'academicYear': academic_year.id }}) }}
{% endblock %}

{% block after_table %}
    <div class="clearfix"></div>
    {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
{% endblock %}
