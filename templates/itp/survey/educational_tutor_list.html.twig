{% trans_default_domain 'itp_survey' %}
{% extends 'generic/list.html.twig' %}
{% import 'macros.html.twig' as m %}

{% block new_action %}{% endblock %}

{% block table_header %}
    <th>{{ 'header.educational_tutor'|trans }}</th>
    <th>{{ 'header.training_program'|trans }}</th>
    <th>{{ 'header.student'|trans }}</th>
    <th>{{ 'header.workcenter'|trans }}</th>
    <th>{{ 'header.dates'|trans }}</th>
    <th>{{ 'header.status'|trans }}</th>
{% endblock %}


{% macro row(data, additional) %}
    {% for datum in data %}
        {% set training_program = data[0].studentProgram.programGroup.programGrade.trainingProgram %}
        <tr>
            {% if loop.first %}
                <td rowspan="{{ data|length }}">
                    {% set url = path('in_company_training_phase_survey_educational_tutor_form', {'id': data[0].id, 'teacher': data[0].educationalTutor.id}) %}
                    <a href="{{ url }}">{{ datum.educationalTutor }}</a>
                    {% if datum.additionalEducationalTutor %}
                        {% set url = path('in_company_training_phase_survey_educational_tutor_form', {'id': data[0].id, 'teacher': data[0].educationalTutor.id}) %}
                        <br/><a href="{{ url }}">{{ datum.additionalEducationalTutor }}</a>
                    {% endif %}
                </td>
                <td rowspan="{{ data|length }}">
                    {{ training_program }}
                    {% if training_program.locked %} <i class="fa fa-lock"></i>{% endif %}
                </td>
            {% endif %}
            <td>
                {{ datum.studentProgram.studentEnrollment }}
            </td>
            <td>
                {{ datum.workcenter }}
            </td>
            <td>
                {{ datum.startDate ? datum.startDate|date('format.date'|trans({}, 'general')) }}
                {% if datum.endDate %} - {{ datum.endDate|date('format.date'|trans({}, 'general')) }}{% endif %}
            </td>
            {% if loop.first %}
                <td rowspan="{{ data|length }}">
                    {{ (additional ? 'table.answered.yes' : 'table.answered.no')|trans }}
                </td>
            {% endif %}
        </tr>
    {% endfor %}
{% endmacro %}

{% block table_body %}
    {% set last_id = 0 %}
    {% set data = [] %}
    {% set additional = 0 %}
    {% for item in pager %}
        {% set training_program = item[0].studentProgram.programGroup.programGrade.trainingProgram %}
        {% if last_id != item[0].educationalTutor.id  ~ '-' ~ training_program.id %}
            {% if last_id != 0 %}{{ _self.row(data, additional) }}{% endif %}
            {% set last_id = item[0].educationalTutor.id ~ '-' ~ training_program.id %}
            {% set data = [item[0]] %}
            {% set additional = item[1] %}
        {% else %}
            {% set data = data|merge([item[0]]) %}
            {% set additional = additional + item[1] %}
        {% endif %}
    {% else %}
        <tr>
            <td colspan="4">{{ 'table.no_items'|trans }}</td>
        </tr>
    {% endfor %}
    {% if last_id != 0 %}
        {{ _self.row(data, additional) }}
    {% endif %}
{% endblock %}

{% block before_filter %}
    {% include 'organization/partial_academic_year.html.twig' %}
{% endblock %}

{% block pagerfanta %}
    {{ pagerfanta(pager, 'twitter_bootstrap4', {'prev_message': 'paginator.prev'|trans([], 'general'), 'next_message': 'paginator.next'|trans([], 'general'), 'routeParams': {'academicYear': academic_year.id }}) }}
{% endblock %}

{% block after_table %}
        <div class="clearfix"></div>
        {{ m.link_button(last_url, 'arrow-left', 'btn-info', 'form.back'|trans) }}
{% endblock %}
