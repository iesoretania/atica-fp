{
    "name": "iesoretania/atica-fp",
    "license": "AGPL-3.0-only",
    "type": "project",
    "description": "Aplicación web para el seguimiento del alumnado durante el período de alternancia y en la FCT",
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-iconv": "*",
        "ext-libxml": "*",
        "babdev/pagerfanta-bundle": "^4.4",
        "doctrine/dbal": "^3.9",
        "doctrine/doctrine-bundle": "^2",
        "doctrine/doctrine-migrations-bundle": "^3.2",
        "doctrine/orm": "^3.2",
        "johngrogg/ics-parser": "^2.1",
        "mpdf/mpdf": "^8",
        "oro/doctrine-extensions": "^1.2",
        "pagerfanta/doctrine-orm-adapter": "^4.7",
        "pagerfanta/twig": "^4.7",
        "phpseclib/phpseclib": "^3.0",
        "sonata-project/entity-audit-bundle": "^1.0",
        "symfony/apache-pack": "^1.0",
        "symfony/asset": "7.4.*",
        "symfony/asset-mapper": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/expression-language": "7.4.*",
        "symfony/flex": "^2.10",
        "symfony/form": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/google-mailer": "7.4.*",
        "symfony/html-sanitizer": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/monolog-bundle": "^4",
        "symfony/rate-limiter": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/stimulus-bundle": "*",
        "symfony/translation": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/ux-autocomplete": "*",
        "symfony/ux-icons": "*",
        "symfony/ux-live-component": "*",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*",
        "symfonycasts/tailwind-bundle": "*",
        "twig/extra-bundle": "^2.12|^3.0",
        "twig/html-extra": "*",
        "twig/twig": "^2.12|^3.0"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.2",
        "doctrine/doctrine-fixtures-bundle": "^3.4",
        "phpstan/phpstan": "^1.4",
        "phpunit/phpunit": "^10.5",
        "rector/rector": "^1.2",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/debug-bundle": "7.4.*",
        "symfony/maker-bundle": "^1.60",
        "symfony/phpunit-bridge": "7.4.*",
        "symfony/stopwatch": "7.4.*",
        "symfony/var-dumper": "7.4.*",
        "symfony/web-profiler-bundle": "7.4.*"
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "test:reset-db": [
            "@php -d memory_limit=1G bin/console doctrine:database:drop --force --if-exists --env=test",
            "@php -d memory_limit=1G bin/console doctrine:database:create --env=test",
            "@php -d memory_limit=1G bin/console doctrine:migrations:migrate --no-interaction --env=test",
            "@php -d memory_limit=1G bin/console doctrine:fixtures:load --append --no-interaction --env=test"
        ],
        "demo:regenerate": [
            "@test:reset-db",
            "@php -d memory_limit=1G bin/console app:demo:export --env=test"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "7.4.*",
            "docker": false
        }
    },
    "scripts-descriptions": {
        "test:reset-db": "Recrea la base de datos de tests (*_test), la migra desde cero y carga las fixtures",
        "demo:regenerate": "Regenera docker/demo.sql (datos de demostración) a partir de las fixtures"
    }
}
