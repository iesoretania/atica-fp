{
    "name": "iesoretania/atica-fp",
    "license": "AGPL-3.0-only",
    "type": "project",
    "description": "Aplicación web para el seguimiento del alumnado durante el período de alternancia y en la FCT",
    "repositories": [
        {
            "type": "path",
            "url": "packages/select2entity-bundle",
            "options": {
                "symlink": false
            }
        }
    ],
    "require": {
        "php": ">=8.4.1",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-iconv": "*",
        "ext-libxml": "*",
        "babdev/pagerfanta-bundle": "^4.4",
        "doctrine/dbal": "^4",
        "doctrine/doctrine-bundle": "^3",
        "doctrine/doctrine-migrations-bundle": "^4",
        "doctrine/orm": "^3.2",
        "friendsofsymfony/ckeditor-bundle": "^2.0",
        "johngrogg/ics-parser": "^2.1",
        "mpdf/mpdf": "^8",
        "oro/doctrine-extensions": "^1.2",
        "pagerfanta/doctrine-orm-adapter": "^4.7",
        "pagerfanta/twig": "^4.7",
        "phpseclib/phpseclib": "^3.0",
        "sonata-project/entity-audit-bundle": "^1.0",
        "symfony/apache-pack": "^1.0",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "^2.10",
        "symfony/form": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/google-mailer": "8.1.*",
        "symfony/html-sanitizer": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/monolog-bundle": "^4",
        "symfony/rate-limiter": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/validator": "8.1.*",
        "symfony/webpack-encore-bundle": "^2.0",
        "symfony/yaml": "8.1.*",
        "tetranz/select2entity-bundle": "^3.1",
        "twig/extra-bundle": "^2.12|^3.0",
        "twig/twig": "^2.12|^3.0"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.2",
        "doctrine/doctrine-fixtures-bundle": "^4",
        "phpstan/phpstan": "^1.4",
        "phpunit/phpunit": "^10.5",
        "rector/rector": "^1.2",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/debug-bundle": "8.1.*",
        "symfony/maker-bundle": "^1.60",
        "symfony/phpunit-bridge": "8.1.*",
        "symfony/stopwatch": "8.1.*",
        "symfony/var-dumper": "8.1.*",
        "symfony/web-profiler-bundle": "8.1.*"
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "platform": {
            "php": "8.4.1"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "ckeditor:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "test:reset-db": [
            "@php -d memory_limit=1G bin/console doctrine:database:drop --force --if-exists --env=test",
            "@php -d memory_limit=1G bin/console doctrine:database:create --env=test",
            "@php -d memory_limit=1G bin/console doctrine:migrations:migrate --no-interaction --env=test",
            "@php -d memory_limit=1G bin/console doctrine:fixtures:load --append --no-interaction --env=test"
        ],
        "demo:regenerate": [
            "@test:reset-db",
            "@php -d memory_limit=1G bin/console app:demo:export --env=test"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "8.1.*",
            "docker": false
        }
    },
    "scripts-descriptions": {
        "test:reset-db": "Recrea la base de datos de tests (*_test), la migra desde cero y carga las fixtures",
        "demo:regenerate": "Regenera docker/demo.sql (datos de demostración) a partir de las fixtures"
    }
}
